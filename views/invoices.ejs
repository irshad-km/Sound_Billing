<!-- JAVASCRIPT -->
<!-- ================================================== -->

<script>
    "use strict";


    /* ================= MODALS ================= */

    function openModal(id) {

        const modal = document.getElementById(id);

        if (!modal) return;

        modal.classList.add("active");

        document.body.style.overflow = "hidden";

        const firstField = modal.querySelector(
            "input:not([type='hidden']), select, button"
        );

        if (firstField) {

            setTimeout(() => {
                firstField.focus();
            }, 100);

        }
    }


    function closeModal(id) {

        const modal = document.getElementById(id);

        if (!modal) return;

        modal.classList.remove("active");

        if (!document.querySelector(".modal.active")) {

            document.body.style.overflow = "";

        }
    }


    document.querySelectorAll(".modal").forEach(function (modal) {

        modal.addEventListener("click", function (event) {

            if (event.target === modal) {

                closeModal(modal.id);

            }

        });

    });


    document.addEventListener("keydown", function (event) {

        if (event.key === "Escape") {

            const activeModal =
                document.querySelector(".modal.active");

            if (activeModal) {

                closeModal(activeModal.id);

            }

        }

    });


    /* ================= HELPERS ================= */

    function getNumber(id) {

        const element =
            document.getElementById(id);

        if (!element) return 0;

        const value =
            Number(element.value);

        return Number.isFinite(value)
            ? value
            : 0;
    }


    function formatAmount(value) {

        return "₹" +
            Number(value || 0).toLocaleString("en-IN", {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
    }


    function showToast(message) {

        const toast =
            document.getElementById("appToast");

        if (!toast) return;

        toast.textContent = message;

        toast.classList.add("show");

        clearTimeout(showToast.timer);

        showToast.timer =
            setTimeout(function () {

                toast.classList.remove("show");

            }, 3000);
    }


    function getSelectedOption(selectElement) {

        if (
            !selectElement ||
            selectElement.selectedIndex < 0
        ) {
            return null;
        }

        return selectElement.options[
            selectElement.selectedIndex
        ];
    }


    function getPositiveAmount(id) {

        return Math.max(
            0,
            getNumber(id)
        );
    }


    /* ================================================== */
    /* INVOICE FILTER */
    /* ================================================== */

    const invoiceStatusFilter =
        document.getElementById("invoiceStatusFilter");

    const invoiceRows =
        Array.from(
            document.querySelectorAll(".invoice-row")
        );

    const invoiceCount =
        document.getElementById("invoiceCount");

    const noFilterResultsRow =
        document.getElementById("noFilterResultsRow");


    function filterInvoices() {

        const selectedStatus =
            invoiceStatusFilter
                ? invoiceStatusFilter.value
                : "All";

        let visibleCount = 0;


        invoiceRows.forEach(function (row) {

            const rowStatus =
                row.dataset.paymentStatus || "Pending";

            const shouldShow =
                selectedStatus === "All" ||
                rowStatus === selectedStatus;


            row.style.display =
                shouldShow
                    ? ""
                    : "none";


            if (shouldShow) {

                visibleCount++;

            }

        });


        if (invoiceCount) {

            invoiceCount.textContent =
                visibleCount;

        }


        if (noFilterResultsRow) {

            noFilterResultsRow.style.display =
                invoiceRows.length > 0 &&
                visibleCount === 0
                    ? ""
                    : "none";

        }

    }


    if (invoiceStatusFilter) {

        invoiceStatusFilter.addEventListener(
            "change",
            filterInvoices
        );

    }


    filterInvoices();


    /* ================================================== */
    /* CREATE INVOICE */
    /* ================================================== */

    const createBooking =
        document.getElementById("createBooking");


    if (createBooking) {

        createBooking.addEventListener(
            "change",
            function () {

                const selectedOption =
                    getSelectedOption(this);


                if (
                    !selectedOption ||
                    !selectedOption.value
                ) {

                    document.getElementById(
                        "createRentalAmount"
                    ).value = "0";

                    document.getElementById(
                        "createAdvance"
                    ).value = "0";

                    calculateCreateInvoice();

                    return;
                }


                const rentalAmount =
                    Number(
                        selectedOption.dataset.rentalAmount || 0
                    );


                const advance =
                    Number(
                        selectedOption.dataset.advance || 0
                    );


                document.getElementById(
                    "createRentalAmount"
                ).value =
                    Math.max(
                        0,
                        rentalAmount
                    ).toFixed(2);


                document.getElementById(
                    "createAdvance"
                ).value =
                    Math.max(
                        0,
                        advance
                    ).toFixed(2);


                calculateCreateInvoice();

            }
        );

    }


    function calculateCreateInvoice() {

        const rental =
            getPositiveAmount(
                "createRentalAmount"
            );

        const transport =
            getPositiveAmount(
                "createTransportCharge"
            );

        const labour =
            getPositiveAmount(
                "createLabourCharge"
            );

        const extra =
            getPositiveAmount(
                "createExtraCharge"
            );

        const discount =
            getPositiveAmount(
                "createDiscount"
            );

        const advance =
            getPositiveAmount(
                "createAdvance"
            );


        const additionalCharges =
            transport +
            labour +
            extra;


        const total =
            Math.max(
                rental +
                additionalCharges -
                discount,
                0
            );


        const balance =
            Math.max(
                total -
                advance,
                0
            );


        document.getElementById(
            "createTotalAmount"
        ).value =
            total.toFixed(2);


        document.getElementById(
            "createBalance"
        ).value =
            balance.toFixed(2);


        document.getElementById(
            "summaryRental"
        ).textContent =
            formatAmount(rental);


        document.getElementById(
            "summaryAdditional"
        ).textContent =
            formatAmount(additionalCharges);


        document.getElementById(
            "summaryDiscount"
        ).textContent =
            formatAmount(discount);


        document.getElementById(
            "summaryTotal"
        ).textContent =
            formatAmount(total);


        document.getElementById(
            "summaryAdvance"
        ).textContent =
            formatAmount(advance);


        document.getElementById(
            "summaryBalance"
        ).textContent =
            formatAmount(balance);

    }


    [
        "createRentalAmount",
        "createTransportCharge",
        "createLabourCharge",
        "createExtraCharge",
        "createDiscount"
    ].forEach(function (id) {

        const element =
            document.getElementById(id);

        if (element) {

            element.addEventListener(
                "input",
                calculateCreateInvoice
            );

        }

    });


    /* ================= CREATE VALIDATION ================= */

    const createInvoiceForm =
        document.getElementById(
            "createInvoiceForm"
        );


    if (createInvoiceForm) {

        createInvoiceForm.addEventListener(
            "submit",
            function (event) {

                const booking =
                    document.getElementById(
                        "createBooking"
                    ).value;


                const rental =
                    getNumber(
                        "createRentalAmount"
                    );

                const transport =
                    getNumber(
                        "createTransportCharge"
                    );

                const labour =
                    getNumber(
                        "createLabourCharge"
                    );

                const extra =
                    getNumber(
                        "createExtraCharge"
                    );

                const discount =
                    getNumber(
                        "createDiscount"
                    );


                if (!booking) {

                    event.preventDefault();

                    showToast(
                        "Please select an event."
                    );

                    document.getElementById(
                        "createBooking"
                    ).focus();

                    return;
                }


                const amounts = [
                    rental,
                    transport,
                    labour,
                    extra,
                    discount
                ];


                if (
                    amounts.some(
                        value =>
                            !Number.isFinite(value) ||
                            value < 0
                    )
                ) {

                    event.preventDefault();

                    showToast(
                        "Amounts cannot be negative."
                    );

                    return;
                }


                const totalCharges =
                    rental +
                    transport +
                    labour +
                    extra;


                if (
                    discount >
                    totalCharges
                ) {

                    event.preventDefault();

                    showToast(
                        "Discount cannot exceed total charges."
                    );

                    document.getElementById(
                        "createDiscount"
                    ).focus();

                    return;
                }


                calculateCreateInvoice();

            }
        );

    }


    /* ================================================== */
    /* RECEIVE PAYMENT */
    /* ================================================== */

    function getLocalDateString() {

        const now =
            new Date();

        const localDate =
            new Date(
                now.getTime() -
                now.getTimezoneOffset() *
                60000
            );


        return localDate
            .toISOString()
            .slice(0, 10);
    }


    function openPaymentModal(data) {

        if (!data || !data.id) {

            showToast(
                "Unable to load invoice payment details."
            );

            return;
        }


        const balance =
            Math.max(
                0,
                Number(data.balance || 0)
            );


        document.getElementById(
            "paymentInvoiceId"
        ).value =
            data.id;


        document.getElementById(
            "paymentInvoiceNumber"
        ).textContent =
            data.invoiceNumber || "-";


        document.getElementById(
            "paymentTotal"
        ).textContent =
            formatAmount(
                data.totalAmount
            );


        document.getElementById(
            "paymentBalance"
        ).textContent =
            formatAmount(
                balance
            );


        const paymentAmount =
            document.getElementById(
                "paymentAmount"
            );


        paymentAmount.value = "";

        paymentAmount.max =
            balance.toFixed(2);


        document.getElementById(
            "paymentDate"
        ).value =
            getLocalDateString();


        document.getElementById(
            "paymentMethod"
        ).value = "";


        openModal(
            "paymentModal"
        );

    }


    /* ================= PAYMENT VALIDATION ================= */

    const paymentForm =
        document.getElementById(
            "paymentForm"
        );


    if (paymentForm) {

        paymentForm.addEventListener(
            "submit",
            function (event) {

                const amount =
                    Number(
                        document.getElementById(
                            "paymentAmount"
                        ).value
                    );


                const max =
                    Number(
                        document.getElementById(
                            "paymentAmount"
                        ).max
                    );


                const paymentDate =
                    document.getElementById(
                        "paymentDate"
                    ).value;


                const paymentMethod =
                    document.getElementById(
                        "paymentMethod"
                    ).value;


                if (
                    !Number.isFinite(amount) ||
                    amount <= 0
                ) {

                    event.preventDefault();

                    showToast(
                        "Enter a valid payment amount."
                    );

                    document.getElementById(
                        "paymentAmount"
                    ).focus();

                    return;
                }


                if (
                    amount >
                    max + 0.000001
                ) {

                    event.preventDefault();

                    showToast(
                        "Payment cannot exceed the current balance."
                    );

                    document.getElementById(
                        "paymentAmount"
                    ).focus();

                    return;
                }


                if (!paymentDate) {

                    event.preventDefault();

                    showToast(
                        "Please select a payment date."
                    );

                    document.getElementById(
                        "paymentDate"
                    ).focus();

                    return;
                }


                if (
                    paymentDate >
                    getLocalDateString()
                ) {

                    event.preventDefault();

                    showToast(
                        "Payment date cannot be in the future."
                    );

                    document.getElementById(
                        "paymentDate"
                    ).focus();

                    return;
                }


                if (!paymentMethod) {

                    event.preventDefault();

                    showToast(
                        "Please select a payment method."
                    );

                    document.getElementById(
                        "paymentMethod"
                    ).focus();

                    return;
                }

            }
        );

    }


    /* ================================================== */
    /* DELETE INVOICE */
    /* ================================================== */

    function deleteInvoice(id) {

        if (!id) {

            showToast(
                "Invalid invoice."
            );

            return;
        }


        const confirmed =
            confirm(
                "Are you sure you want to delete this invoice?\n\nThis action may not be reversible."
            );


        if (!confirmed) return;


        const form =
            document.createElement(
                "form"
            );


        form.method = "POST";

        form.action =
            "/invoices/delete/" +
            encodeURIComponent(id);


        document.body.appendChild(
            form
        );

        form.submit();

    }


    /* ================= INITIAL CALCULATION ================= */

    calculateCreateInvoice();

</script>

</body>

</html>
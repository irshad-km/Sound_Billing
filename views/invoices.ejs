<!DOCTYPE html>

<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#f7f7fc">

    <title>Invoices | expro AUDIO</title>

<style>
    :root {
        --primary: #7257e8;
        --primary-dark: #5b40d0;
        --primary-light: #f0edff;
        --primary-border: #ded7ff;

        --background: #f7f7fc;
        --surface: #ffffff;
        --surface-soft: #fafaff;

        --text: #202036;
        --text-secondary: #74748c;
        --text-muted: #9999ad;

        --border: #e9e9f2;

        --success: #16845b;
        --success-bg: #e8f8f0;

        --warning: #a96b0b;
        --warning-bg: #fff5df;

        --danger: #d44754;
        --danger-bg: #fff0f1;

        --shadow-sm: 0 2px 8px rgba(31, 28, 73, 0.035);
        --shadow-md: 0 12px 35px rgba(31, 28, 73, 0.09);

        --radius-sm: 9px;
        --radius-md: 14px;
        --radius-lg: 20px;
    }

    * {
        box-sizing: border-box;
    }

    html {
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
            Arial, sans-serif;
        background: var(--background);
        color: var(--text);
        font-size: 14px;
        -webkit-font-smoothing: antialiased;
    }

    button,
    input,
    select {
        font: inherit;
    }

    button,
    select {
        cursor: pointer;
    }

    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    a:focus-visible {
        outline: 3px solid rgba(114, 87, 232, 0.22);
        outline-offset: 2px;
    }

    button:disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }

    /* ================= MAIN LAYOUT ================= */

    .main-content {
        margin-left: 250px;
        min-height: 100vh;
        padding: 34px 38px 45px;
        max-width: 1800px;
    }

    /* ================= PAGE HEADER ================= */

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }

    .header-title {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--primary);
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .eyebrow-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--primary);
        box-shadow: 0 0 0 4px var(--primary-light);
    }

    .page-header h1 {
        margin: 0;
        font-size: clamp(27px, 3vw, 34px);
        font-weight: 800;
        letter-spacing: -1.2px;
        color: #22213c;
    }

    .page-header p {
        margin: 0;
        color: var(--text-secondary);
        font-size: 14px;
        line-height: 1.6;
    }

    .header-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* ================= BUTTONS ================= */

    .primary-btn,
    .submit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        border: 1px solid transparent;
        background: linear-gradient(135deg, #8068f2, #6749df);
        color: white;
        padding: 13px 19px;
        border-radius: 11px;
        font-weight: 700;
        font-size: 13px;
        box-shadow: 0 5px 14px rgba(114, 87, 232, 0.20);
        transition: transform 0.2s, box-shadow 0.2s, background 0.2s;
    }

    .primary-btn:hover,
    .submit-btn:hover {
        background: linear-gradient(135deg, #7257e8, #583bc8);
        box-shadow: 0 8px 20px rgba(114, 87, 232, 0.28);
        transform: translateY(-1px);
    }

    .button-plus {
        font-size: 20px;
        font-weight: 400;
        line-height: 14px;
    }

    .secondary-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 16px;
        background: white;
        color: #55556e;
        border: 1px solid var(--border);
        border-radius: 10px;
        font-size: 13px;
        font-weight: 650;
        transition: background 0.2s, border-color 0.2s;
    }

    .secondary-btn:hover {
        background: #f7f7fc;
        border-color: #d5d4e6;
    }

    /* ================= SUMMARY CARDS ================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 18px;
        margin-bottom: 28px;
    }

    .summary-card {
        position: relative;
        overflow: hidden;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-md);
        padding: 23px;
        min-height: 145px;
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
    }

    .summary-card:hover {
        transform: translateY(-3px);
        box-shadow: var(--shadow-md);
        border-color: #dcd5ff;
    }

    .summary-card::after {
        content: "";
        position: absolute;
        width: 95px;
        height: 95px;
        border-radius: 50%;
        right: -38px;
        top: -42px;
        background: var(--card-tint, #f0edff);
        opacity: 0.8;
    }

    .summary-card-top {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        margin-bottom: 20px;
    }

    .summary-card .label {
        color: var(--text-secondary);
        font-size: 13px;
        font-weight: 600;
    }

    .summary-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: var(--card-tint, var(--primary-light));
        color: var(--card-color, var(--primary));
        font-size: 19px;
    }

    .summary-card .value {
        position: relative;
        z-index: 1;
        font-size: 31px;
        font-weight: 800;
        letter-spacing: -1px;
        color: #25243f;
        line-height: 1;
    }

    .summary-card .card-caption {
        margin-top: 10px;
        font-size: 11px;
        color: var(--text-muted);
    }

    .summary-card.total {
        --card-tint: #efebff;
        --card-color: #7257e8;
    }

    .summary-card.paid {
        --card-tint: #e4f7ed;
        --card-color: #16845b;
    }

    .summary-card.partial {
        --card-tint: #fff2d8;
        --card-color: #b17a17;
    }

    .summary-card.pending {
        --card-tint: #ffe9eb;
        --card-color: #d44754;
    }

    /* ================= TABLE CARD ================= */

    .table-card {
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 24px 25px;
        border-bottom: 1px solid var(--border);
    }

    .table-heading h2 {
        margin: 0;
        font-size: 17px;
        font-weight: 800;
        letter-spacing: -0.3px;
        color: #272640;
    }

    .table-heading p {
        margin: 6px 0 0;
        font-size: 12px;
        color: var(--text-secondary);
    }

    .table-count {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 31px;
        height: 27px;
        padding: 0 9px;
        background: var(--primary-light);
        color: var(--primary);
        border-radius: 8px;
        font-weight: 800;
        font-size: 12px;
    }

    .table-header-right {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
    }

    /* ================= INVOICE FILTER ================= */

    .invoice-filter {
        height: 38px;
        min-width: 145px;
        padding: 0 32px 0 12px;
        border: 1px solid var(--border);
        border-radius: 9px;
        background: white;
        color: #55556e;
        font-size: 12px;
        font-weight: 700;
        outline: none;
        transition: border-color 0.18s, box-shadow 0.18s;
    }

    .invoice-filter:hover {
        border-color: #d5cdfc;
    }

    .invoice-filter:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(114, 87, 232, 0.10);
    }

    .table-scroll {
        width: 100%;
        overflow-x: auto;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        white-space: nowrap;
    }

    th,
    td {
        padding: 17px 19px;
        border-bottom: 1px solid #f0f0f6;
        text-align: left;
        vertical-align: middle;
    }

    th {
        background: #fafaff;
        color: #85859d;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.85px;
    }

    td {
        font-size: 12px;
        color: #57576f;
    }

    tbody tr {
        transition: background 0.18s;
    }

    tbody tr:hover {
        background: #fbfaff;
    }

    tbody tr:last-child td {
        border-bottom: none;
    }

    .invoice-number {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #383653;
        font-size: 12px;
        font-weight: 800;
    }

    .invoice-icon {
        width: 32px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f0edff;
        color: var(--primary);
        border-radius: 8px;
        font-size: 15px;
    }

    .customer-name {
        color: #33324e;
        font-size: 12px;
        font-weight: 750;
    }

    .event-name {
        color: #41405b;
        font-size: 12px;
        font-weight: 650;
    }

    .table-subtext {
        display: block;
        margin-top: 5px;
        font-size: 11px;
        color: #a0a0b3;
    }

    .amount-cell {
        font-weight: 750;
        color: #383750;
        font-variant-numeric: tabular-nums;
    }

    .balance-cell {
        color: #b7791f;
        font-weight: 800;
    }

    /* ================= STATUS BADGES ================= */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 7px 10px;
        border-radius: 7px;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 0.1px;
    }

    .status::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .status-paid {
        background: var(--success-bg);
        color: var(--success);
    }

    .status-partial {
        background: var(--warning-bg);
        color: var(--warning);
    }

    .status-pending {
        background: var(--danger-bg);
        color: var(--danger);
    }

    /* ================= ACTION BUTTONS ================= */

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        min-height: 31px;
        padding: 7px 10px;
        border: 1px solid #e7e7f0;
        background: white;
        color: #62627a;
        border-radius: 7px;
        cursor: pointer;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        transition: background 0.18s, border-color 0.18s, color 0.18s;
    }

    .action-btn:hover {
        background: #f6f4ff;
        border-color: #d9d0ff;
        color: var(--primary);
    }

    .action-btn.payment-btn {
        background: #eaf8f0;
        border-color: #d6f0e1;
        color: #16845b;
    }

    .action-btn.payment-btn:hover {
        background: #d9f3e5;
        border-color: #b4e6cc;
    }

    .action-btn.danger-btn {
        color: #d44754;
        border-color: #f3dfe2;
    }

    .action-btn.danger-btn:hover {
        background: #fff0f1;
        border-color: #f3c8cd;
    }

    /* ================= EMPTY STATE ================= */

    .empty-state {
        padding: 65px 20px !important;
        text-align: center !important;
    }

    .empty-state-icon {
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 18px;
        background: var(--primary-light);
        color: var(--primary);
        font-size: 27px;
    }

    .empty-state strong {
        display: block;
        color: #383750;
        font-size: 15px;
        margin-bottom: 7px;
    }

    .empty-state span {
        display: block;
        color: var(--text-secondary);
        font-size: 12px;
    }

    /* ================= MODALS ================= */

    .modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 1000;
        overflow-y: auto;
        padding: 30px 18px;
        background: rgba(22, 20, 48, 0.48);
        backdrop-filter: blur(5px);
        -webkit-backdrop-filter: blur(5px);
    }

    .modal.active {
        display: flex;
        align-items: flex-start;
        justify-content: center;
    }

    .modal-content {
        width: 100%;
        max-width: 850px;
        margin: auto;
        background: white;
        border: 1px solid rgba(255, 255, 255, 0.7);
        border-radius: 19px;
        box-shadow: 0 25px 90px rgba(24, 20, 65, 0.22);
        overflow: hidden;
        animation: modalIn 0.22s ease-out;
    }

    @keyframes modalIn {
        from {
            opacity: 0;
            transform: translateY(12px) scale(0.99);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    .modal-header {
        position: sticky;
        top: 0;
        z-index: 5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 23px 27px;
        background: rgba(255, 255, 255, 0.97);
        border-bottom: 1px solid var(--border);
    }

    .modal-header h2 {
        margin: 0;
        color: #282641;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .modal-header p {
        margin: 6px 0 0;
        color: var(--text-secondary);
        font-size: 12px;
        line-height: 1.5;
    }

    .modal-header-label {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .modal-heading-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        flex-shrink: 0;
        border-radius: 12px;
        background: var(--primary-light);
        color: var(--primary);
        font-size: 20px;
    }

    .close-btn {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border: 1px solid var(--border);
        border-radius: 10px;
        background: white;
        color: #77778e;
        font-size: 22px;
        line-height: 1;
        transition: background 0.18s, color 0.18s;
    }

    .close-btn:hover {
        background: var(--danger-bg);
        color: var(--danger);
    }

    .modal-body {
        padding: 28px;
    }

    .modal-footer {
        position: sticky;
        bottom: 0;
        z-index: 5;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 17px 27px;
        background: rgba(255, 255, 255, 0.97);
        border-top: 1px solid var(--border);
    }

    /* ================= FORM SECTIONS ================= */

    .form-section {
        margin-bottom: 29px;
    }

    .form-section:last-child {
        margin-bottom: 0;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 19px;
    }

    .section-number {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 31px;
        height: 31px;
        flex-shrink: 0;
        background: var(--primary-light);
        color: var(--primary);
        border-radius: 10px;
        font-size: 12px;
        font-weight: 800;
    }

    .section-title h3 {
        margin: 0;
        font-size: 14px;
        font-weight: 800;
        color: #33324e;
    }

    .section-description {
        margin: 5px 0 0;
        color: var(--text-secondary);
        font-size: 11px;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .form-grid.three {
        grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .form-group {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .form-group.full {
        grid-column: 1 / -1;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        color: #4d4c67;
        font-size: 12px;
        font-weight: 750;
    }

    .required {
        color: var(--danger);
        margin-left: 3px;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        height: 45px;
        padding: 0 13px;
        border: 1px solid #e2e2ed;
        border-radius: 9px;
        background: white;
        color: #33324e;
        font-size: 13px;
        outline: none;
        transition: border-color 0.18s, box-shadow 0.18s, background 0.18s;
    }

    .form-group input:hover,
    .form-group select:hover {
        border-color: #d2c9ff;
    }

    .form-group input:focus,
    .form-group select:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(114, 87, 232, 0.10);
    }

    .form-group input[readonly] {
        background: #f7f7fc;
        color: #6a6981;
        cursor: default;
    }

    .field-help {
        margin-top: 7px;
        color: #9999ad;
        font-size: 10px;
        line-height: 1.6;
    }

    /* ================= RENTAL AMOUNT BOX ================= */

    .rental-box {
        grid-column: 1 / -1;
        padding: 21px;
        border: 1px solid #e5e0ff;
        border-radius: 13px;
        background: linear-gradient(135deg, #faf9ff, #f5f2ff);
    }

    .rental-box-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin-bottom: 14px;
    }

    .rental-box-title {
        font-size: 13px;
        font-weight: 800;
        color: #383653;
    }

    .auto-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 9px;
        border-radius: 7px;
        background: #e9e4ff;
        color: #6749d5;
        font-size: 10px;
        font-weight: 800;
    }

    .auto-badge::before {
        content: "";
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: currentColor;
    }

    .rental-input-wrapper {
        position: relative;
    }

    .currency {
        position: absolute;
        left: 15px;
        top: 50%;
        transform: translateY(-50%);
        color: var(--primary);
        font-size: 20px;
        font-weight: 800;
        pointer-events: none;
    }

    .rental-input-wrapper input {
        height: 58px;
        padding-left: 39px !important;
        border-color: #ddd6ff;
        background: white;
        color: #332b69;
        font-size: 23px !important;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    /* ================= INVOICE SUMMARY ================= */

    .invoice-summary {
        padding: 23px;
        border: 1px solid #39355d;
        border-radius: 14px;
        background: linear-gradient(145deg, #292541, #201e37);
        color: white;
        box-shadow: 0 10px 25px rgba(37, 32, 77, 0.10);
    }

    .invoice-summary h3 {
        margin: 0 0 20px;
        font-size: 14px;
        font-weight: 800;
        color: white;
    }

    .summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 10px 0;
        color: #c8c6dc;
        font-size: 12px;
    }

    .summary-row strong {
        color: white;
        font-weight: 750;
        font-variant-numeric: tabular-nums;
    }

    .summary-total {
        margin-top: 7px;
        padding-top: 17px;
        border-top: 1px solid rgba(255, 255, 255, 0.13);
        font-size: 14px;
    }

    .summary-total strong {
        color: #c9bcff;
        font-size: 19px;
        font-weight: 850;
    }

    .summary-balance {
        margin-top: 8px;
        padding-top: 15px;
        border-top: 1px dashed rgba(255, 255, 255, 0.18);
        font-size: 13px;
    }

    .summary-balance strong {
        color: #ffd78b;
        font-size: 16px;
    }

    /* ================= PAYMENT MODAL ================= */

    .payment-info {
        padding: 17px;
        margin-bottom: 23px;
        border: 1px solid #e6e1ff;
        border-radius: 12px;
        background: linear-gradient(135deg, #faf9ff, #f5f2ff);
    }

    .payment-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 8px 0;
        color: #77758f;
        font-size: 12px;
    }

    .payment-info-row:first-child {
        padding-top: 0;
    }

    .payment-info-row:last-child {
        padding-bottom: 0;
    }

    .payment-info-row strong {
        color: #34324e;
        font-weight: 800;
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .payment-info-row.balance-row {
        margin-top: 8px;
        padding-top: 14px;
        border-top: 1px solid #e5e0ff;
    }

    .payment-info-row.balance-row strong {
        color: var(--primary);
        font-size: 17px;
    }

    /* ================= TOAST ================= */

    .toast {
        position: fixed;
        z-index: 2000;
        right: 24px;
        bottom: 24px;
        max-width: calc(100vw - 32px);
        padding: 13px 17px;
        border: 1px solid #e8e4ff;
        border-radius: 11px;
        background: white;
        color: #383653;
        box-shadow: var(--shadow-md);
        font-size: 12px;
        font-weight: 700;
        opacity: 0;
        transform: translateY(10px);
        pointer-events: none;
        transition: opacity 0.2s, transform 0.2s;
    }

    .toast.show {
        opacity: 1;
        transform: translateY(0);
    }

    /* ================= RESPONSIVE ================= */

    @media (max-width: 1250px) {
        .main-content {
            padding: 28px 25px;
        }

        .summary-grid {
            gap: 13px;
        }

        .summary-card {
            padding: 19px;
        }

        th,
        td {
            padding: 15px 14px;
        }

        .action-buttons {
            flex-wrap: wrap;
            min-width: 175px;
        }
    }

    @media (max-width: 1050px) {
        .main-content {
            margin-left: 0;
        }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .form-grid.three {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @media (max-width: 650px) {
        .main-content {
            padding: 23px 14px 35px;
        }

        .page-header {
            align-items: stretch;
            flex-direction: column;
            gap: 20px;
            margin-bottom: 23px;
        }

        .page-header h1 {
            font-size: 28px;
        }

        .header-actions,
        .header-actions .primary-btn {
            width: 100%;
        }

        .primary-btn {
            min-height: 46px;
        }

        .summary-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 11px;
            margin-bottom: 21px;
        }

        .summary-card {
            padding: 16px;
            min-height: 125px;
            border-radius: 13px;
        }

        .summary-card-top {
            align-items: flex-start;
            margin-bottom: 16px;
        }

        .summary-card .label {
            font-size: 11px;
        }

        .summary-icon {
            width: 31px;
            height: 31px;
            border-radius: 9px;
            font-size: 16px;
        }

        .summary-card .value {
            font-size: 27px;
        }

        .summary-card .card-caption {
            font-size: 10px;
        }

        .table-card {
            border-radius: 14px;
        }

        .table-header {
            padding: 19px 16px;
            align-items: flex-start;
        }

        .table-header-right {
            flex-shrink: 0;
        }

        .invoice-filter {
            min-width: 135px;
            height: 36px;
        }

        .table-heading h2 {
            font-size: 15px;
        }

        .table-heading p {
            font-size: 11px;
        }

        th,
        td {
            padding: 14px 13px;
        }

        .modal {
            padding: 10px;
        }

        .modal-content {
            border-radius: 15px;
        }

        .modal-header {
            padding: 18px;
        }

        .modal-header h2 {
            font-size: 17px;
        }

        .modal-heading-icon {
            width: 37px;
            height: 37px;
            font-size: 17px;
        }

        .modal-body {
            padding: 20px 17px;
        }

        .form-grid,
        .form-grid.three {
            grid-template-columns: minmax(0, 1fr);
            gap: 16px;
        }

        .form-group.full,
        .rental-box {
            grid-column: auto;
        }

        .rental-box {
            padding: 16px;
        }

        .rental-box-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 10px;
        }

        .invoice-summary {
            padding: 18px;
        }

        .modal-footer {
            padding: 14px 17px;
        }

        .modal-footer button {
            flex: 1;
            padding: 12px 8px;
        }

        .toast {
            right: 12px;
            bottom: 12px;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            animation-duration: 0.01ms !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>

</head>

<body>

<%- include("partials/sidebar") %>

<main class="main-content">

    <!-- PAGE HEADER -->

    <header class="page-header">

        <div class="header-title">

            <h1>Invoices</h1>

            <p>
                Manage invoices, track payments and keep your event finances organized.
            </p>

        </div>

        <div class="header-actions">

            <button
                type="button"
                class="primary-btn"
                onclick="openModal('createInvoiceModal')"
            >
                <span class="button-plus">+</span>
                Create Invoice
            </button>

        </div>

    </header>


    <!-- SUMMARY CARDS -->

    <%
        const totalInvoices = invoices.length;

        const paidInvoices = invoices.filter(
            invoice => invoice.paymentStatus === "Paid"
        ).length;

        const partialInvoices = invoices.filter(
            invoice => invoice.paymentStatus === "Partial"
        ).length;

        const pendingInvoices = invoices.filter(
            invoice => invoice.paymentStatus === "Pending"
        ).length;
    %>

    <section class="summary-grid">

        <div class="summary-card total">

            <div class="summary-card-top">
                <div class="label">Total Invoices</div>
                <div class="summary-icon">▤</div>
            </div>

            <div class="value"><%= totalInvoices %></div>

            <div class="card-caption">All created invoices</div>

        </div>

        <div class="summary-card paid">

            <div class="summary-card-top">
                <div class="label">Paid Invoices</div>
                <div class="summary-icon">✓</div>
            </div>

            <div class="value"><%= paidInvoices %></div>

            <div class="card-caption">Fully paid invoices</div>

        </div>

        <div class="summary-card partial">

            <div class="summary-card-top">
                <div class="label">Partial Payments</div>
                <div class="summary-icon">◷</div>
            </div>

            <div class="value"><%= partialInvoices %></div>

            <div class="card-caption">Payments received in part</div>

        </div>

        <div class="summary-card pending">

            <div class="summary-card-top">
                <div class="label">Pending Invoices</div>
                <div class="summary-icon">!</div>
            </div>

            <div class="value"><%= pendingInvoices %></div>

            <div class="card-caption">Awaiting payment</div>

        </div>

    </section>


    <!-- INVOICE TABLE -->

    <section class="table-card">

        <div class="table-header">

            <div class="table-heading">

                <h2>Invoice List</h2>

                <p>
                    View and manage all your customer invoices.
                </p>

            </div>

            <div class="table-header-right">

                <!-- STATUS FILTER -->

                <select
                    id="invoiceStatusFilter"
                    class="invoice-filter"
                    aria-label="Filter invoices by payment status"
                >
                    <option value="All">All Invoices</option>
                    <option value="Paid">Paid</option>
                    <option value="Partial">Partial</option>
                    <option value="Pending">Pending</option>
                </select>

                <span class="table-count" id="invoiceCount">
                    <%= totalInvoices %>
                </span>

            </div>

        </div>

        <div class="table-scroll">

            <table>

                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Event</th>
                        <th>Total</th>
                        <th>Advance</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="invoiceTableBody">

                    <% if (invoices.length === 0) { %>

                        <tr id="noInvoicesRow">

                            <td colspan="7" class="empty-state">

                                <div class="empty-state-icon">▤</div>

                                <strong>No invoices yet</strong>

                                <span>Create your first invoice to get started.</span>

                            </td>

                        </tr>

                    <% } %>


                    <% invoices.forEach(invoice => { %>

                        <tr
                            class="invoice-row"
                            data-payment-status="<%= invoice.paymentStatus || 'Pending' %>"
                        >

                            <td>

                                <span class="customer-name">
                                    <%= invoice.booking?.customer?.name || "N/A" %>
                                </span>

                            </td>


                            <td>

                                <span class="event-name">
                                    <%= invoice.booking?.eventType || "Event" %>
                                </span>

                                <span class="table-subtext">
                                    <%= invoice.booking?.eventDate
                                        ? new Date(invoice.booking.eventDate).toLocaleDateString("en-IN")
                                        : "No date"
                                    %>
                                </span>

                            </td>


                            <td class="amount-cell">
                                ₹<%= Number(invoice.totalAmount || 0).toLocaleString("en-IN", {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                            </td>


                            <td class="amount-cell">
                                ₹<%= Number(invoice.advance || 0).toLocaleString("en-IN", {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>
                            </td>


                            <td class="amount-cell <%= Number(invoice.balance || 0) > 0 ? 'balance-cell' : '' %>">

                                ₹<%= Number(invoice.balance || 0).toLocaleString("en-IN", {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }) %>

                            </td>


                            <td>

                                <% if (invoice.paymentStatus === "Paid") { %>

                                    <span class="status status-paid">
                                        Paid
                                    </span>

                                <% } else if (invoice.paymentStatus === "Partial") { %>

                                    <span class="status status-partial">
                                        Partial
                                    </span>

                                <% } else { %>

                                    <span class="status status-pending">
                                        Pending
                                    </span>

                                <% } %>

                            </td>


                            <td>

                                <div class="action-buttons">

                                    <% if (Number(invoice.balance || 0) > 0) { %>

                                        <button
                                            type="button"
                                            class="action-btn payment-btn"
                                            onclick='openPaymentModal(<%- JSON.stringify({
                                                id: invoice._id,
                                                invoiceNumber: invoice.invoiceNumber,
                                                totalAmount: invoice.totalAmount,
                                                balance: invoice.balance
                                            }).replace(/</g, "\\u003c") %>)'
                                        >
                                            + Receive
                                        </button>

                                    <% } %>


                                    <a
                                        href="/invoices/view/<%= invoice._id %>"
                                        class="action-btn"
                                    >
                                        View
                                    </a>


                                    <button
                                        type="button"
                                        class="action-btn danger-btn"
                                        onclick="deleteInvoice('<%= invoice._id %>')"
                                    >
                                        Delete
                                    </button>

                                </div>

                            </td>

                        </tr>

                    <% }) %>


                    <!-- FILTER EMPTY STATE -->

                    <% if (invoices.length > 0) { %>

                        <tr
                            id="noFilterResultsRow"
                            style="display: none;"
                        >

                            <td colspan="7" class="empty-state">

                                <div class="empty-state-icon">⌕</div>

                                <strong>No matching invoices</strong>

                                <span>
                                    No invoices found for the selected payment status.
                                </span>

                            </td>

                        </tr>

                    <% } %>

                </tbody>

            </table>

        </div>

    </section>

</main>


<!-- ================================================== -->
<!-- CREATE INVOICE MODAL -->
<!-- ================================================== -->

<div class="modal" id="createInvoiceModal">

    <div class="modal-content">

        <div class="modal-header">

            <div class="modal-header-label">

                <div class="modal-heading-icon">＋</div>

                <div>
                    <h2>Create Invoice</h2>
                    <p>Create a new invoice for your event.</p>
                </div>

            </div>

            <button
                type="button"
                class="close-btn"
                aria-label="Close modal"
                onclick="closeModal('createInvoiceModal')"
            >×</button>

        </div>


        <form
            action="/invoices/add"
            method="POST"
            id="createInvoiceForm"
        >

            <div class="modal-body">

                <!-- EVENT DETAILS -->

                <section class="form-section">

                    <div class="section-title">

                        <div class="section-number">01</div>

                        <div>
                            <h3>Event Details</h3>
                            <p class="section-description">
                                Select the event for this invoice.
                            </p>
                        </div>

                    </div>


                    <div class="form-grid">

                        <div class="form-group full">

                            <label for="createBooking">
                                Select Event
                                <span class="required">*</span>
                            </label>

                            <select
                                name="booking"
                                id="createBooking"
                                required
                            >

                                <option value="">
                                    Select an event
                                </option>

                                <% bookings.forEach(booking => {

                                    const bookingRentalAmount = Number(
                                        bookingRentalTotals?.[
                                            booking._id.toString()
                                        ] || 0
                                    );

                                    const bookingAdvance = Number(
                                        booking.advance || 0
                                    );

                                %>

                                    <option
                                        value="<%= booking._id %>"
                                        data-advance="<%= bookingAdvance %>"
                                        data-rental-amount="<%= bookingRentalAmount %>"
                                    >

                                        <%= booking.customer?.name || "Customer" %>
                                        -
                                        <%= booking.eventType || "Event" %>
                                        -
                                        <%= booking.eventDate
                                            ? new Date(
                                                booking.eventDate
                                            ).toLocaleDateString("en-IN")
                                            : "No date"
                                        %>

                                    </option>

                                <% }) %>

                            </select>


                            <div class="field-help">
                                The rental amount and advance will be loaded
                                from the selected event.
                            </div>

                        </div>

                    </div>

                </section>


                <!-- RENTAL AMOUNT -->

                <section class="form-section">

                    <div class="section-title">

                        <div class="section-number">02</div>

                        <div>
                            <h3>Rental Amount</h3>

                            <p class="section-description">
                                Equipment rental charges for this event.
                            </p>
                        </div>

                    </div>


                    <div class="form-grid">

                        <div class="rental-box">

                            <div class="rental-box-header">

                                <div class="rental-box-title">
                                    Total Rental Amount
                                </div>

                                <div class="auto-badge">
                                    Auto calculated
                                </div>

                            </div>


                            <div class="rental-input-wrapper">

                                <span class="currency">₹</span>

                                <input
                                    type="number"
                                    name="rentalAmount"
                                    id="createRentalAmount"
                                    min="0"
                                    step="0.01"
                                    value="0"
                                    required
                                >

                            </div>


                            <div class="field-help">
                                Automatically calculated from the rentals
                                dispatched to this event. You can manually
                                adjust the amount if needed.
                            </div>

                        </div>

                    </div>

                </section>


                <!-- ADDITIONAL CHARGES -->

                <section class="form-section">

                    <div class="section-title">

                        <div class="section-number">03</div>

                        <div>
                            <h3>Additional Charges</h3>

                            <p class="section-description">
                                Add transport, labour and other charges.
                            </p>
                        </div>

                    </div>


                    <div class="form-grid three">

                        <div class="form-group">

                            <label for="createTransportCharge">
                                Transport Charge
                            </label>

                            <input
                                type="number"
                                name="transportCharge"
                                id="createTransportCharge"
                                min="0"
                                step="0.01"
                                value="0"
                            >

                        </div>


                        <div class="form-group">

                            <label for="createLabourCharge">
                                Labour Charge
                            </label>

                            <input
                                type="number"
                                name="labourCharge"
                                id="createLabourCharge"
                                min="0"
                                step="0.01"
                                value="0"
                            >

                        </div>


                        <div class="form-group">

                            <label for="createExtraCharge">
                                Extra Charge
                            </label>

                            <input
                                type="number"
                                name="extraCharge"
                                id="createExtraCharge"
                                min="0"
                                step="0.01"
                                value="0"
                            >

                        </div>


                        <div class="form-group">

                            <label for="createDiscount">
                                Discount
                            </label>

                            <input
                                type="number"
                                name="discount"
                                id="createDiscount"
                                min="0"
                                step="0.01"
                                value="0"
                            >

                        </div>


                        <div class="form-group">

                            <label for="createAdvance">
                                Advance Received
                            </label>

                            <input
                                type="number"
                                id="createAdvance"
                                value="0"
                                readonly
                            >

                            <div class="field-help">
                                Loaded from the selected event.
                            </div>

                        </div>

                    </div>

                </section>


                <!-- SUMMARY -->

                <section class="form-section">

                    <div class="section-title">

                        <div class="section-number">04</div>

                        <div>
                            <h3>Invoice Summary</h3>

                            <p class="section-description">
                                Review the total before creating the invoice.
                            </p>
                        </div>

                    </div>


                    <div class="invoice-summary">

                        <h3>Payment Summary</h3>


                        <div class="summary-row">

                            <span>Rental Amount</span>

                            <strong id="summaryRental">
                                ₹0.00
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>Additional Charges</span>

                            <strong id="summaryAdditional">
                                ₹0.00
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>Discount</span>

                            <strong id="summaryDiscount">
                                ₹0.00
                            </strong>

                        </div>


                        <div class="summary-row summary-total">

                            <span>Total Amount</span>

                            <strong id="summaryTotal">
                                ₹0.00
                            </strong>

                        </div>


                        <div class="summary-row">

                            <span>Advance</span>

                            <strong id="summaryAdvance">
                                ₹0.00
                            </strong>

                        </div>


                        <div class="summary-row summary-balance">

                            <span>Balance Due</span>

                            <strong id="summaryBalance">
                                ₹0.00
                            </strong>

                        </div>

                    </div>


                    <input
                        type="hidden"
                        name="totalAmount"
                        id="createTotalAmount"
                    >

                    <input
                        type="hidden"
                        name="balance"
                        id="createBalance"
                    >

                </section>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="secondary-btn"
                    onclick="closeModal('createInvoiceModal')"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="submit-btn"
                >
                    Create Invoice →
                </button>

            </div>

        </form>

    </div>

</div>


<!-- ================================================== -->
<!-- RECEIVE PAYMENT MODAL -->
<!-- ================================================== -->

<div class="modal" id="paymentModal">

    <div
        class="modal-content"
        style="max-width:540px;"
    >

        <div class="modal-header">

            <div class="modal-header-label">

                <div class="modal-heading-icon">₹</div>

                <div>
                    <h2>Receive Payment</h2>

                    <p>
                        Record a payment received from your customer.
                    </p>
                </div>

            </div>


            <button
                type="button"
                class="close-btn"
                aria-label="Close modal"
                onclick="closeModal('paymentModal')"
            >×</button>

        </div>


        <form
            action="/payments/add"
            method="POST"
            id="paymentForm"
        >

            <div class="modal-body">

                <input
                    type="hidden"
                    name="invoice"
                    id="paymentInvoiceId"
                >


                <div class="payment-info">

                    <div class="payment-info-row">

                        <span>Invoice Number</span>

                        <strong id="paymentInvoiceNumber">
                            -
                        </strong>

                    </div>


                    <div class="payment-info-row">

                        <span>Total Invoice Amount</span>

                        <strong id="paymentTotal">
                            ₹0.00
                        </strong>

                    </div>


                    <div class="payment-info-row balance-row">

                        <span>Current Balance</span>

                        <strong id="paymentBalance">
                            ₹0.00
                        </strong>

                    </div>

                </div>


                <div class="form-grid">

                    <div class="form-group full">

                        <label for="paymentAmount">

                            Payment Amount
                            <span class="required">*</span>

                        </label>

                        <input
                            type="number"
                            name="amount"
                            id="paymentAmount"
                            min="0.01"
                            step="0.01"
                            required
                            placeholder="Enter amount received"
                        >

                        <div class="field-help">
                            The amount cannot exceed the outstanding balance.
                        </div>

                    </div>


                    <div class="form-group">

                        <label for="paymentDate">

                            Payment Date
                            <span class="required">*</span>

                        </label>

                        <input
                            type="date"
                            name="paymentDate"
                            id="paymentDate"
                            required
                        >

                    </div>


                    <div class="form-group">

                        <label for="paymentMethod">

                            Payment Method
                            <span class="required">*</span>

                        </label>

                        <select
                            name="paymentMethod"
                            id="paymentMethod"
                            required
                        >

                            <option value="">
                                Select method
                            </option>

                            <option value="Cash">
                                Cash
                            </option>

                            <option value="UPI">
                                UPI
                            </option>

                            <option value="Bank Transfer">
                                Bank Transfer
                            </option>

                            <option value="Card">
                                Card
                            </option>

                            <option value="Other">
                                Other
                            </option>

                        </select>

                    </div>

                </div>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="secondary-btn"
                    onclick="closeModal('paymentModal')"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    class="submit-btn"
                >
                    Save Payment →
                </button>

            </div>

        </form>

    </div>

</div>


<!-- TOAST -->

<div
    class="toast"
    id="appToast"
    role="status"
    aria-live="polite"
></div>



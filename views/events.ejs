<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sound Billing | Events</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* =========================
           Events Page
        ========================== */

        .page-actions {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            margin-bottom: 20px;
        }

        .page-actions p {
            margin: 5px 0 0;
            color: #777;
            font-size: 14px;
        }

        .filter-bar {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-bottom: 20px;
        }

        .filter-bar input,
        .filter-bar select {
            padding: 11px 13px;
            border: 1px solid #ddd;
            border-radius: 8px;
            background: #fff;
            font-size: 14px;
            outline: none;
        }

        .filter-bar input {
            min-width: 220px;
        }

        .filter-bar input:focus,
        .filter-bar select:focus {
            border-color: #888;
        }

        .event-count {
            margin-bottom: 12px;
            color: #777;
            font-size: 14px;
        }

        .empty-message {
            text-align: center;
            padding: 35px;
            color: #888;
            display: none;
        }

        .danger-btn {
            border: none;
            background: #fee2e2;
            color: #b91c1c;
            padding: 7px 10px;
            border-radius: 6px;
            cursor: pointer;
        }

        .danger-btn:hover {
            background: #fecaca;
        }

        .table-actions {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        /* =========================
           Modal
        ========================== */

        .modal {
            position: fixed;
            inset: 0;
            background: rgba(0, 0, 0, 0.45);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 20px;
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            width: 100%;
            max-width: 720px;
            max-height: 90vh;
            overflow-y: auto;
            background: #fff;
            border-radius: 14px;
            padding: 24px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.2);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 24px;
        }

        .modal-header h2 {
            margin: 0;
        }

        .modal-header p {
            margin: 5px 0 0;
            color: #777;
            font-size: 14px;
        }

        .close-btn {
            border: none;
            background: transparent;
            font-size: 28px;
            cursor: pointer;
            color: #777;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
        }

        .form-group label {
            font-size: 14px;
            font-weight: 600;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            box-sizing: border-box;
            padding: 11px 12px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: #888;
        }

        .form-group input:disabled,
        .form-group select:disabled {
            background: #f5f5f5;
            color: #555;
        }

        .modal-footer {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 25px;
        }

        .cancel-btn {
            border: none;
            background: #eee;
            padding: 11px 18px;
            border-radius: 8px;
            cursor: pointer;
        }

        /* =========================
           Mobile
        ========================== */

        @media (max-width: 700px) {

            .page-actions {
                align-items: flex-start;
                flex-direction: column;
            }

            .page-actions .primary-btn {
                width: 100%;
            }

            .filter-bar {
                flex-direction: column;
            }

            .filter-bar input,
            .filter-bar select {
                width: 100%;
                min-width: 0;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .modal {
                align-items: flex-end;
                padding: 0;
            }

            .modal-content {
                max-height: 92vh;
                border-radius: 18px 18px 0 0;
                padding: 20px;
            }
        }
    </style>
</head>


<body>

<div class="app">

    <!-- =========================
         Sidebar
    ========================== -->
<%- include("partials/sidebar") %>


    <!-- =========================
         Main
    ========================== -->

    <main class="main">

        <!-- Header -->

        <header class="header">

            <div>

                <h1>
                    Events & Bookings
                </h1>

                <p>
                    Manage your events and bookings
                </p>

            </div>

            <div class="profile">

                <div class="avatar">
                    A
                </div>

                <div>

                    <strong>
                        Admin
                    </strong>

                    <small>
                        Administrator
                    </small>

                </div>

            </div>

        </header>


        <!-- =========================
             Page Actions
        ========================== -->

        <div class="page-actions">

            <div>

                <h2>
                    All Bookings
                </h2>

                <p>
                    View and manage all customer events
                </p>

            </div>

            <button
                class="primary-btn"
                onclick="openNewBooking()">

                + New Booking

            </button>

        </div>


        <!-- =========================
             Filters
        ========================== -->

        <div class="panel">

            <div class="filter-bar">

                <input
                    type="text"
                    id="searchInput"
                    placeholder="Search customer or location..."
                    oninput="filterEvents()">


                <select
                    id="eventFilter"
                    onchange="filterEvents()">

                    <option value="">
                        All Event Types
                    </option>

                    <option value="Wedding">
                        Wedding
                    </option>

                    <option value="Ganamela">
                        Ganamela
                    </option>

                    <option value="Function">
                        Function
                    </option>

                    <option value="Reception">
                        Reception
                    </option>

                    <option value="Birthday">
                        Birthday
                    </option>

                    <option value="Other">
                        Other
                    </option>

                </select>


                <select
                    id="statusFilter"
                    onchange="filterEvents()">

                    <option value="">
                        All Payment Status
                    </option>

                    <option value="Paid">
                        Paid
                    </option>

                    <option value="Partial">
                        Partial
                    </option>

                    <option value="Pending">
                        Pending
                    </option>

                </select>

            </div>

        </div>


        <!-- =========================
             Booking Table
        ========================== -->

        <div class="panel">

            <div class="panel-header">

                <div>

                    <h2>
                        Bookings
                    </h2>

                    <p class="panel-subtitle">
                        Upcoming and existing bookings
                    </p>

                </div>

            </div>


            <div class="event-count">

                Showing
                <strong id="eventCount"><%= bookings.length %></strong>
                bookings

            </div>


            <div class="table-wrapper">

                <table id="eventsTable">

                    <thead>

                        <tr>

                            <th>
                                Customer
                            </th>

                            <th>
                                Event Type
                            </th>

                            <th>
                                Event Date
                            </th>

                            <th>
                                Location
                            </th>

                            <th>
                                Total
                            </th>

                            <th>
                                Advance
                            </th>

                            <th>
                                Balance
                            </th>

                            <th>
                                Status
                            </th>

                            <th>
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        <% bookings.forEach(booking => { %>

                            <tr
                                data-customer="<%= booking.customer ? booking.customer.name : '' %>"
                                data-event="<%= booking.eventType %>"
                                data-location="<%= booking.location %>"
                                data-status="<%= booking.paymentStatus %>"
                                data-id="<%= booking._id %>">

                                <td>

                                    <strong>
                                        <%= booking.customer ? booking.customer.name : "Unknown Customer" %>
                                    </strong>

                                </td>


                                <td>
                                    <%= booking.eventType %>
                                </td>


                                <td>

                                    <%= new Date(booking.eventDate).toLocaleDateString(
                                        "en-IN",
                                        {
                                            day: "2-digit",
                                            month: "short",
                                            year: "numeric"
                                        }
                                    ) %>

                                </td>


                                <td>
                                    <%= booking.location %>
                                </td>


                                <td>
                                    ₹<%= Number(booking.totalAmount).toLocaleString("en-IN") %>
                                </td>


                                <td>
                                    ₹<%= Number(booking.advance).toLocaleString("en-IN") %>
                                </td>


                                <td>
                                    ₹<%= Number(booking.balance).toLocaleString("en-IN") %>
                                </td>


                                <td>

                                    <span class="status <%= booking.paymentStatus.toLowerCase() %>">

                                        <%= booking.paymentStatus %>

                                    </span>

                                </td>


                                <td>

                                    <div class="table-actions">

                                        <!-- View -->

                                        <button
                                            class="action-btn"
                                            onclick="viewBooking('<%= booking._id %>')">

                                            View

                                        </button>


                                        <!-- Edit -->

                                        <button
                                            class="edit-btn"
                                            onclick="editBooking('<%= booking._id %>')">

                                            Edit

                                        </button>


                                        <!-- Delete -->

                                        <button
                                            class="danger-btn"
                                            onclick="deleteBooking('<%= booking._id %>')">

                                            Delete

                                        </button>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    </tbody>

                </table>


                <div
                    class="empty-message"
                    id="emptyMessage"
                    style="<%= bookings.length === 0 ? 'display:block;' : '' %>">

                    No bookings found.

                </div>

            </div>

        </div>

    </main>

</div>



<!-- =========================
     Booking Modal
========================== -->

<div
    id="bookingModal"
    class="modal">

    <div class="modal-content">

        <div class="modal-header">

            <div>

                <h2 id="modalTitle">
                    New Booking
                </h2>

                <p>
                    Create and manage booking details
                </p>

            </div>

            <button
                type="button"
                class="close-btn"
                onclick="closeBookingModal()">

                ×

            </button>

        </div>


        <form
            id="bookingForm"
            method="POST"
            action="/events/add">

            <div class="form-grid">


                <!-- Customer -->

                <div class="form-group">

                    <label>
                        Customer
                    </label>

                    <select
                        id="customer"
                        name="customer"
                        required>

                        <option value="">
                            Select customer
                        </option>

                        <% customers.forEach(customerItem => { %>

                            <option value="<%= customerItem._id %>">

                                <%= customerItem.name %>

                                <% if (customerItem.phone) { %>
                                    - <%= customerItem.phone %>
                                <% } %>

                            </option>

                        <% }) %>

                    </select>

                </div>


                <!-- Event Type -->

                <div class="form-group">

                    <label>
                        Event Type
                    </label>

                    <select
                        id="eventType"
                        name="eventType"
                        required>

                        <option value="">
                            Select event type
                        </option>

                        <option value="Wedding">
                            Wedding
                        </option>

                        <option value="Ganamela">
                            Ganamela
                        </option>

                        <option value="Function">
                            Function
                        </option>

                        <option value="Reception">
                            Reception
                        </option>

                        <option value="Birthday">
                            Birthday
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                </div>


                <!-- Event Date -->

                <div class="form-group">

                    <label>
                        Event Date
                    </label>

                    <input
                        type="date"
                        id="eventDate"
                        name="eventDate"
                        required>

                </div>


                <!-- Location -->

                <div class="form-group">

                    <label>
                        Location
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        placeholder="Event location"
                        required>

                </div>


                <!-- Total -->

                <div class="form-group">

                    <label>
                        Total Amount
                    </label>

                    <input
                        type="number"
                        id="totalAmount"
                        name="totalAmount"
                        placeholder="₹ 0"
                        min="0"
                        required>

                </div>


                <!-- Advance -->

                <div class="form-group">

                    <label>
                        Advance
                    </label>

                    <input
                        type="number"
                        id="advance"
                        name="advance"
                        placeholder="₹ 0"
                        min="0"
                        required>

                </div>


                <!-- Balance -->

                <div class="form-group">

                    <label>
                        Balance
                    </label>

                    <input
                        type="number"
                        id="balance"
                        name="balance"
                        placeholder="₹ 0"
                        readonly>

                </div>


                <!-- Payment Status -->

                <div class="form-group">

                    <label>
                        Payment Status
                    </label>

                    <select
                        id="paymentStatus"
                        name="paymentStatus">

                        <option value="Pending">
                            Pending
                        </option>

                        <option value="Partial">
                            Partial
                        </option>

                        <option value="Paid">
                            Paid
                        </option>

                    </select>

                </div>

            </div>


            <div class="modal-footer">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeBookingModal()">

                    Cancel

                </button>

                <button
                    type="submit"
                    class="primary-btn"
                    id="saveBookingBtn">

                    Save Booking

                </button>

            </div>

        </form>

    </div>

</div>



<!-- =========================
     JavaScript
========================== -->

<script>

    const modal =
        document.getElementById("bookingModal");

    const form =
        document.getElementById("bookingForm");

    const customer =
        document.getElementById("customer");

    const eventType =
        document.getElementById("eventType");

    const eventDate =
        document.getElementById("eventDate");

    const locationInput =
        document.getElementById("location");

    const totalAmount =
        document.getElementById("totalAmount");

    const advance =
        document.getElementById("advance");

    const balance =
        document.getElementById("balance");

    const paymentStatus =
        document.getElementById("paymentStatus");

    const modalTitle =
        document.getElementById("modalTitle");

    const saveBookingBtn =
        document.getElementById("saveBookingBtn");


    /* =========================
       Balance
    ========================== */

    function calculateBalance() {

        const total =
            Number(totalAmount.value) || 0;

        const paid =
            Number(advance.value) || 0;

        balance.value =
            Math.max(total - paid, 0);

    }


    totalAmount.addEventListener(
        "input",
        calculateBalance
    );

    advance.addEventListener(
        "input",
        calculateBalance
    );


    /* =========================
       Disable Form
    ========================== */

    function setFormDisabled(disabled) {

        form.querySelectorAll(
            "input, select"
        ).forEach(input => {

            input.disabled = disabled;

        });

    }


    /* =========================
       New Booking
    ========================== */

    function openNewBooking() {

        form.reset();

        form.action = "/events/add";

        form.method = "POST";

        balance.value = "";

        modalTitle.textContent =
            "New Booking";

        saveBookingBtn.textContent =
            "Save Booking";

        saveBookingBtn.style.display =
            "block";

        setFormDisabled(false);

        modal.classList.add("show");

        customer.focus();

    }


    /* =========================
       View Booking
    ========================== */

    async function viewBooking(id) {

        try {

            const response =
                await fetch("/events/view/" + id);

            if (!response.ok) {
                throw new Error("Failed to load booking");
            }

            const booking =
                await response.json();

            fillBookingForm(booking);

            modalTitle.textContent =
                "Booking Details";

            saveBookingBtn.style.display =
                "none";

            setFormDisabled(true);

            modal.classList.add("show");

        } catch (error) {

            console.error(error);

            alert("Failed to load booking.");

        }

    }


    /* =========================
       Edit Booking
    ========================== */

    async function editBooking(id) {

        try {

            const response =
                await fetch("/events/view/" + id);

            if (!response.ok) {
                throw new Error("Failed to load booking");
            }

            const booking =
                await response.json();

            fillBookingForm(booking);

            form.action =
                "/events/edit/" + id;

            form.method =
                "POST";

            modalTitle.textContent =
                "Edit Booking";

            saveBookingBtn.textContent =
                "Update Booking";

            saveBookingBtn.style.display =
                "block";

            setFormDisabled(false);

            modal.classList.add("show");

        } catch (error) {

            console.error(error);

            alert("Failed to load booking.");

        }

    }


    /* =========================
       Fill Booking Form
    ========================== */

    function fillBookingForm(booking) {

        if (booking.customer) {

            customer.value =
                booking.customer._id;

        } else {

            customer.value = "";

        }

        eventType.value =
            booking.eventType || "";

        if (booking.eventDate) {

            const date =
                new Date(booking.eventDate);

            const year =
                date.getFullYear();

            const month =
                String(
                    date.getMonth() + 1
                ).padStart(2, "0");

            const day =
                String(
                    date.getDate()
                ).padStart(2, "0");

            eventDate.value =
                `${year}-${month}-${day}`;

        } else {

            eventDate.value = "";

        }

        locationInput.value =
            booking.location || "";

        totalAmount.value =
            booking.totalAmount || 0;

        advance.value =
            booking.advance || 0;

        balance.value =
            booking.balance || 0;

        paymentStatus.value =
            booking.paymentStatus || "Pending";

    }


    /* =========================
       Delete Booking
    ========================== */

    async function deleteBooking(id) {

        const confirmed =
            confirm(
                "Are you sure you want to delete this booking?"
            );

        if (!confirmed) {
            return;
        }

        try {

            const formData =
                document.createElement("form");

            formData.method =
                "POST";

            formData.action =
                "/events/delete/" + id;

            document.body.appendChild(formData);

            formData.submit();

        } catch (error) {

            console.error(error);

            alert("Failed to delete booking.");

        }

    }


    /* =========================
       Search / Filter
    ========================== */

    function filterEvents() {

        const search =
            document
                .getElementById("searchInput")
                .value
                .toLowerCase();

        const eventFilter =
            document
                .getElementById("eventFilter")
                .value;

        const statusFilter =
            document
                .getElementById("statusFilter")
                .value;

        const rows =
            document.querySelectorAll(
                "#eventsTable tbody tr"
            );

        let visibleCount = 0;

        rows.forEach(row => {

            const customerName =
                (
                    row.dataset.customer || ""
                ).toLowerCase();

            const locationName =
                (
                    row.dataset.location || ""
                ).toLowerCase();

            const eventName =
                row.dataset.event || "";

            const status =
                row.dataset.status || "";

            const searchMatch =
                customerName.includes(search) ||
                locationName.includes(search);

            const eventMatch =
                !eventFilter ||
                eventName === eventFilter;

            const statusMatch =
                !statusFilter ||
                status === statusFilter;

            const show =
                searchMatch &&
                eventMatch &&
                statusMatch;

            row.style.display =
                show ? "" : "none";

            if (show) {
                visibleCount++;
            }

        });


        document.getElementById(
            "eventCount"
        ).textContent = visibleCount;


        document.getElementById(
            "emptyMessage"
        ).style.display =
            visibleCount === 0
                ? "block"
                : "none";

    }


    /* =========================
       Close Modal
    ========================== */

    function closeBookingModal() {

        modal.classList.remove("show");

        saveBookingBtn.style.display =
            "block";

        setFormDisabled(false);

        form.action =
            "/events/add";

        form.method =
            "POST";

    }


    /* =========================
       Click Outside
    ========================== */

    window.addEventListener(
        "click",
        function(event) {

            if (event.target === modal) {

                closeBookingModal();

            }

        }
    );

</script>

</body>

</html>
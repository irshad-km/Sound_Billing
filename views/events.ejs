<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Events & Bookings | Sound Billing</title>


<link rel="stylesheet" href="/css/style.css">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
>

<style>
    :root {
        --primary: #635bff;
        --primary-hover: #5147ed;
        --primary-light: #eeecff;
        --page-bg: #f5f7fb;
        --surface: #ffffff;
        --text-primary: #172033;
        --text-secondary: #475467;
        --text-muted: #667085;
        --border: #e4e7ec;
        --success: #067647;
        --success-bg: #ecfdf3;
        --warning: #b54708;
        --warning-bg: #fffaeb;
        --danger: #b42318;
        --danger-bg: #fef3f2;
        --shadow: 0 4px 18px rgba(16, 24, 40, 0.05);
    }

    * {
        box-sizing: border-box;
    }

    html {
        min-height: 100%;
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        min-height: 100vh;
        font-family: "Inter", -apple-system, BlinkMacSystemFont,
            "Segoe UI", sans-serif;
        background: var(--page-bg);
        color: var(--text-primary);
        font-size: 14px;
        line-height: 1.5;
    }

    button,
    input,
    select {
        font: inherit;
    }

    button {
        -webkit-tap-highlight-color: transparent;
    }

    button:focus-visible,
    input:focus-visible,
    select:focus-visible {
        outline: 3px solid rgba(99, 91, 255, 0.22);
        outline-offset: 2px;
    }

    /* APP LAYOUT */

    .app {
        width: 100%;
        min-height: 100vh;
    }

    .main {
        width: calc(100% - 250px);
        min-height: 100vh;
        margin-left: 250px;
        padding: 30px 32px;
        background: var(--page-bg);
        transition: padding 0.2s ease;
    }

    /* PAGE HEADER */

    .page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .page-title h1 {
        margin: 0;
        color: #101828;
        font-size: 28px;
        line-height: 1.3;
        font-weight: 800;
        letter-spacing: -0.8px;
    }

    .page-title p {
        margin: 8px 0 0;
        color: var(--text-muted);
        font-size: 13px;
        line-height: 1.7;
    }

    .admin-profile {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 9px 15px 9px 9px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 12px;
        flex-shrink: 0;
    }

    .admin-avatar {
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        background: var(--primary-light);
        color: var(--primary);
        font-size: 16px;
        font-weight: 800;
    }

    .admin-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .admin-info strong {
        color: #101828;
        font-size: 13px;
        font-weight: 750;
    }

    .admin-info span {
        color: var(--text-muted);
        font-size: 11px;
    }

    /* BUTTONS */

    .btn {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 0 16px;
        border: 1px solid transparent;
        border-radius: 9px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        text-decoration: none;
        transition:
            background 0.18s ease,
            border-color 0.18s ease,
            box-shadow 0.18s ease,
            transform 0.18s ease;
    }

    .btn-primary {
        background: var(--primary);
        color: #ffffff;
        box-shadow: 0 4px 10px rgba(99, 91, 255, 0.17);
    }

    .btn-primary:hover {
        background: var(--primary-hover);
        transform: translateY(-1px);
    }

    .btn-secondary {
        background: #ffffff;
        color: #344054;
        border-color: #d0d5dd;
    }

    .btn-secondary:hover {
        background: #f9fafb;
        border-color: #b8c0cc;
    }

    .btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
        transform: none;
    }

    /* PAGE ACTIONS */

    .page-actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 22px;
    }

    /* SEARCH AND FILTER CARD */

    .filter-card {
        width: 100%;
        padding: 22px;
        margin-bottom: 24px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        box-shadow: var(--shadow);
    }

    .filter-heading {
        margin-bottom: 17px;
    }

    .filter-heading h2 {
        margin: 0;
        color: #101828;
        font-size: 15px;
        font-weight: 800;
    }

    .filter-heading p {
        margin: 5px 0 0;
        color: var(--text-muted);
        font-size: 12px;
    }

    .filter-grid {
        display: grid;
        grid-template-columns: minmax(200px, 1fr) auto;
        align-items: center;
        gap: 12px;
    }

    .filter-input {
        width: 100%;
        min-width: 0;
        height: 45px;
        padding: 0 13px;
        border: 1px solid #d0d5dd;
        border-radius: 9px;
        background: #ffffff;
        color: #344054;
        font-size: 13px;
        outline: none;
        transition:
            border-color 0.18s ease,
            box-shadow 0.18s ease;
    }

    .filter-input::placeholder {
        color: #98a2b3;
    }

    .filter-input:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.11);
    }

    .filter-reset {
        height: 45px;
    }

    /* BOOKINGS CARD */

    .bookings-card {
        width: 100%;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .bookings-card-header {
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 20px 23px;
        border-bottom: 1px solid var(--border);
    }

    .bookings-card-header h2 {
        margin: 0;
        color: #101828;
        font-size: 17px;
        font-weight: 800;
    }

    .bookings-card-header p {
        margin: 5px 0 0;
        color: var(--text-muted);
        font-size: 12px;
    }

    .bookings-count {
        padding: 8px 12px;
        border: 1px solid #e4e7ec;
        border-radius: 9px;
        background: #f9fafb;
        color: var(--text-secondary);
        font-size: 12px;
        white-space: nowrap;
    }

    .bookings-count strong {
        color: #101828;
        font-weight: 800;
    }

    /* TABLE */

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
    }

    .bookings-table {
        width: 100%;
        min-width: 950px;
        border-collapse: collapse;
        text-align: left;
    }

    .bookings-table thead {
        background: #f9fafb;
    }

    .bookings-table th {
        padding: 15px 17px;
        border-bottom: 1px solid var(--border);
        color: #475467;
        font-size: 11px;
        font-weight: 800;
        text-align: left;
        text-transform: uppercase;
        letter-spacing: 0.35px;
        white-space: nowrap;
    }

    .bookings-table td {
        padding: 17px;
        border-bottom: 1px solid #eaecf0;
        color: #344054;
        font-size: 13px;
        font-weight: 500;
        vertical-align: middle;
        white-space: nowrap;
    }

    .bookings-table tbody tr {
        transition: background 0.15s ease;
    }

    .bookings-table tbody tr:hover {
        background: #fafaff;
    }

    .bookings-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* CUSTOMER */

    .customer-name {
        display: block;
        color: #101828;
        font-size: 13px;
        font-weight: 750;
    }

    .customer-phone {
        display: block;
        margin-top: 5px;
        color: var(--text-muted);
        font-size: 12px;
        font-weight: 500;
    }

    /* EVENT TYPE */

    .event-type-badge {
        display: inline-flex;
        align-items: center;
        max-width: 190px;
        padding: 7px 10px;
        overflow: hidden;
        border: 1px solid #e4e7ec;
        border-radius: 7px;
        background: #f9fafb;
        color: #344054;
        font-size: 12px;
        font-weight: 650;
        text-overflow: ellipsis;
    }

    /* AMOUNTS */

    .amount {
        color: #101828 !important;
        font-weight: 750 !important;
    }

    .advance-amount {
        color: var(--success) !important;
        font-weight: 650 !important;
    }

    /* ACTION BUTTONS */

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .action-btn {
        min-height: 33px;
        padding: 0 11px;
        border: 1px solid #d0d5dd;
        border-radius: 7px;
        background: #ffffff;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
        transition:
            background 0.18s ease,
            border-color 0.18s ease;
    }

    .action-btn.view {
        color: #175cd3;
        border-color: #b2ddff;
        background: #eff8ff;
    }

    .action-btn.view:hover {
        background: #dff0ff;
    }

    .action-btn.edit {
        color: var(--primary);
        border-color: #d9d6fe;
        background: #f5f4ff;
    }

    .action-btn.edit:hover {
        background: #e9e7ff;
    }

    .action-btn.delete {
        color: var(--danger);
        border-color: #fecdca;
        background: #fffafa;
    }

    .action-btn.delete:hover {
        background: var(--danger-bg);
    }

    /* EMPTY STATE */

    .empty-state {
        padding: 55px 20px;
        text-align: center;
    }

    .empty-state-icon {
        width: 64px;
        height: 64px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        border-radius: 18px;
        background: var(--primary-light);
        color: var(--primary);
        font-size: 29px;
    }

    .empty-state h3 {
        margin: 0;
        color: #101828;
        font-size: 16px;
        font-weight: 800;
    }

    .empty-state p {
        margin: 7px 0 0;
        color: var(--text-muted);
        font-size: 13px;
    }

    .empty-state .btn {
        margin-top: 18px;
    }

    /* BOOKING MODAL */

    .modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 5000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(16, 24, 40, 0.55);
        backdrop-filter: blur(4px);
    }

    .modal-overlay.show {
        display: flex;
    }

    .booking-modal {
        display: flex;
        flex-direction: column;
        width: min(720px, 100%);
        max-height: 92vh;
        overflow: hidden;
        background: #ffffff;
        border: 1px solid rgba(255, 255, 255, 0.5);
        border-radius: 16px;
        box-shadow: 0 25px 70px rgba(16, 24, 40, 0.24);
        animation: modalOpen 0.18s ease;
    }

    @keyframes modalOpen {
        from {
            opacity: 0;
            transform: translateY(8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .modal-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        padding: 22px 24px;
        border-bottom: 1px solid var(--border);
    }

    .modal-header h2 {
        margin: 0;
        color: #101828;
        font-size: 20px;
        font-weight: 800;
    }

    .modal-header p {
        margin: 6px 0 0;
        color: var(--text-muted);
        font-size: 13px;
    }

    .modal-close {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border: none;
        border-radius: 8px;
        background: #f2f4f7;
        color: #475467;
        font-size: 23px;
        cursor: pointer;
    }

    .modal-close:hover {
        background: #e4e7ec;
        color: #101828;
    }

    .modal-body {
        padding: 24px;
        overflow-y: auto;
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .form-group {
        display: flex;
        min-width: 0;
        flex-direction: column;
        gap: 8px;
    }

    .form-group.full {
        grid-column: 1 / -1;
    }

    .form-group label {
        color: #344054;
        font-size: 13px;
        font-weight: 750;
    }

    .required {
        color: #d92d20;
    }

    .form-control {
        width: 100%;
        min-width: 0;
        height: 45px;
        padding: 0 13px;
        border: 1px solid #d0d5dd;
        border-radius: 9px;
        outline: none;
        background: #ffffff;
        color: #101828;
        font-size: 13px;
        transition:
            border-color 0.18s ease,
            box-shadow 0.18s ease;
    }

    .form-control::placeholder {
        color: #98a2b3;
    }

    .form-control:focus {
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.11);
    }

    .form-control:disabled {
        background: #f9fafb;
        color: #667085;
        cursor: not-allowed;
    }

    .form-control[readonly] {
        background: #f9fafb;
    }

    .form-helper {
        color: var(--text-muted);
        font-size: 11px;
        line-height: 1.5;
    }

    /* PAYMENT STATUS IN FORM */

    .payment-status-input {
        font-weight: 800;
    }

    .payment-status-input.pending {
        color: var(--danger);
        background: #fff7f7;
        border-color: #fecdca;
    }

    .payment-status-input.partial {
        color: var(--warning);
        background: #fffbeb;
        border-color: #fedf89;
    }

    .payment-status-input.paid {
        color: var(--success);
        background: #f0fdf4;
        border-color: #abefc6;
    }

    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 18px 24px;
        border-top: 1px solid var(--border);
        background: #fcfcfd;
    }

    /* RESPONSIVE */

    @media (max-width: 1100px) {
        .main {
            padding: 25px;
        }

        .filter-grid {
            grid-template-columns: minmax(180px, 1fr) auto;
        }
    }

    @media (max-width: 700px) {
        .main {
            width: 100% !important;
            margin-left: 0 !important;
            padding: 20px 16px;
        }

        .page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .page-title h1 {
            font-size: 24px;
        }

        .admin-profile {
            width: 100%;
        }

        .page-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .page-actions-left,
        .page-actions-left .btn,
        .page-actions > .btn {
            width: 100%;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .filter-reset {
            width: 100%;
        }

        .filter-card {
            padding: 17px;
        }

        .bookings-card-header {
            align-items: flex-start;
            flex-direction: column;
            padding: 18px;
        }

        .modal-overlay {
            padding: 10px;
        }

        .booking-modal {
            max-height: 95vh;
        }

        .modal-header,
        .modal-body {
            padding: 18px;
        }

        .modal-footer {
            padding: 15px 18px;
        }
    }

    @media (max-width: 480px) {
        .main {
            padding: 15px 12px;
        }

        .page-title h1 {
            font-size: 22px;
        }

        .form-grid {
            grid-template-columns: 1fr;
            gap: 17px;
        }

        .form-group.full {
            grid-column: auto;
        }

        .modal-header h2 {
            font-size: 18px;
        }

        .modal-footer .btn {
            flex: 1;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        *,
        *::before,
        *::after {
            scroll-behavior: auto !important;
            animation-duration: 0.01ms !important;
            transition-duration: 0.01ms !important;
        }
    }
</style>


</head>

<body>

<div class="app">


<%- include("partials/sidebar") %>

<main class="main">

    <!-- PAGE HEADER -->

    <header class="page-header">

        <div class="page-title">

            <h1>Events &amp; Bookings</h1>

            <p>
                Manage your event bookings, customer details and payments.
            </p>

        </div>

        <div class="admin-profile">

            <div class="admin-avatar">
                A
            </div>

            <div class="admin-info">

                <strong>Admin</strong>

                <span>Administrator</span>

            </div>

        </div>

    </header>


    <!-- PAGE ACTIONS -->

    <div class="page-actions">

        <div class="page-actions-left">

            <button
                type="button"
                class="btn btn-secondary"
                onclick="resetFilters()"
            >
                All Bookings
            </button>

        </div>

        <button
            type="button"
            class="btn btn-primary"
            onclick="openNewBooking()"
        >
            <span aria-hidden="true">＋</span>
            New Booking
        </button>

    </div>


    <!-- SEARCH -->

    <section class="filter-card">

        <div class="filter-heading">

            <h2>Search &amp; Filter</h2>

            <p>
                Find bookings by customer or location.
            </p>

        </div>

        <div class="filter-grid">

            <input
                type="search"
                id="searchInput"
                class="filter-input"
                placeholder="Search customer or location..."
                aria-label="Search by customer or location"
                oninput="filterEvents()"
            >

            <button
                type="button"
                class="btn btn-secondary filter-reset"
                onclick="resetFilters()"
            >
                Reset Filters
            </button>

        </div>

    </section>


    <!-- BOOKINGS TABLE -->

    <section class="bookings-card">

        <div class="bookings-card-header">

            <div>

                <h2>Bookings</h2>

                <p>
                    Review and manage your event bookings.
                </p>

            </div>

            <div class="bookings-count">

                Showing
                <strong id="bookingCount">
                    <%= bookings ? bookings.length : 0 %>
                </strong>
                bookings

            </div>

        </div>


        <div class="table-wrapper">

            <table class="bookings-table">

                <thead>

                    <tr>

                        <th>Customer</th>

                        <th>Event Type</th>

                        <th>Event Date</th>

                        <th>Location</th>

                        <th>Total</th>

                        <th>Advance</th>

                        <th>Actions</th>

                    </tr>

                </thead>


                <tbody id="bookingsTableBody">

                    <% if (bookings && bookings.length > 0) { %>

                        <% bookings.forEach(booking => { %>

                            <%

                                const customerName =
                                    booking.customer &&
                                    booking.customer.name
                                        ? booking.customer.name
                                        : "Unknown Customer";

                                const customerPhone =
                                    booking.customer &&
                                    booking.customer.phone
                                        ? booking.customer.phone
                                        : "";

                                const total = Math.max(
                                    Number(booking.totalAmount) || 0,
                                    0
                                );

                                const advanceAmount = Math.max(
                                    Number(booking.advance) || 0,
                                    0
                                );

                                let displayDate = "—";

                                if (booking.eventDate) {

                                    const dateObject =
                                        new Date(booking.eventDate);

                                    if (!isNaN(dateObject.getTime())) {

                                        displayDate =
                                            dateObject.toLocaleDateString(
                                                "en-IN",
                                                {
                                                    day: "2-digit",
                                                    month: "short",
                                                    year: "numeric"
                                                }
                                            );

                                    }

                                }

                                const eventTypeText =
                                    booking.eventType || "";

                                const locationText =
                                    booking.location || "";

                            %>


                            <tr
                                class="booking-row"
                                data-customer="<%= customerName.toLowerCase() %>"
                                data-location="<%= locationText.toLowerCase() %>"
                                data-id="<%= booking._id %>"
                            >

                                <!-- CUSTOMER -->

                                <td>

                                    <span class="customer-name">
                                        <%= customerName %>
                                    </span>

                                    <% if (customerPhone) { %>

                                        <span class="customer-phone">
                                            <%= customerPhone %>
                                        </span>

                                    <% } %>

                                </td>


                                <!-- EVENT TYPE -->

                                <td>

                                    <span class="event-type-badge">
                                        <%= eventTypeText || "—" %>
                                    </span>

                                </td>


                                <!-- EVENT DATE -->

                                <td>
                                    <%= displayDate %>
                                </td>


                                <!-- LOCATION -->

                                <td>
                                    <%= locationText || "—" %>
                                </td>


                                <!-- TOTAL -->

                                <td class="amount">
                                    ₹<%= total.toLocaleString("en-IN") %>
                                </td>


                                <!-- ADVANCE -->

                                <td class="advance-amount">
                                    ₹<%= advanceAmount.toLocaleString("en-IN") %>
                                </td>


                                <!-- ACTIONS -->

                                <td>

                                    <div class="action-buttons">

                                        <button
                                            type="button"
                                            class="action-btn view"
                                            data-id="<%= booking._id %>"
                                            onclick="viewBooking(this.dataset.id)"
                                        >
                                            View
                                        </button>

                                        <button
                                            type="button"
                                            class="action-btn edit"
                                            data-id="<%= booking._id %>"
                                            onclick="editBooking(this.dataset.id)"
                                        >
                                            Edit
                                        </button>

                                        <button
                                            type="button"
                                            class="action-btn delete"
                                            data-id="<%= booking._id %>"
                                            onclick="deleteBooking(this.dataset.id)"
                                        >
                                            Delete
                                        </button>

                                    </div>

                                </td>

                            </tr>

                        <% }) %>

                    <% } %>

                </tbody>

            </table>

        </div>


        <!-- FILTER EMPTY STATE -->

        <div
            class="empty-state"
            id="emptyState"
            style="display: none;"
        >

            <div class="empty-state-icon">
                ⌕
            </div>

            <h3>
                No bookings found
            </h3>

            <p>
                Try changing the search filter.
            </p>

            <button
                type="button"
                class="btn btn-secondary"
                onclick="resetFilters()"
            >
                Clear Search
            </button>

        </div>


        <!-- INITIAL EMPTY STATE -->

        <% if (!bookings || bookings.length === 0) { %>

            <div
                class="empty-state"
                id="initialEmptyState"
            >

                <div class="empty-state-icon">
                    ＋
                </div>

                <h3>
                    No bookings yet
                </h3>

                <p>
                    Create your first booking to get started.
                </p>

                <button
                    type="button"
                    class="btn btn-primary"
                    onclick="openNewBooking()"
                >
                    ＋ New Booking
                </button>

            </div>

        <% } %>

    </section>

</main>


</div>

<!-- BOOKING MODAL -->

<div
    id="bookingModal"
    class="modal-overlay"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modalTitle"
    aria-hidden="true"
>


<div class="booking-modal">

    <div class="modal-header">

        <div>

            <h2 id="modalTitle">
                New Booking
            </h2>

            <p id="modalSubtitle">
                Add a new event booking.
            </p>

        </div>

        <button
            type="button"
            class="modal-close"
            aria-label="Close modal"
            onclick="closeBookingModal()"
        >
            &times;
        </button>

    </div>


    <form
        id="bookingForm"
        method="POST"
        action="/events/add"
    >

        <div class="modal-body">

            <div class="form-grid">

                <!-- CUSTOMER -->

                <div class="form-group">

                    <label for="customer">
                        Customer
                        <span class="required">*</span>
                    </label>

                    <select
                        id="customer"
                        name="customer"
                        class="form-control"
                        required
                    >

                        <option value="">
                            Select Customer
                        </option>

                        <% if (customers && customers.length > 0) { %>

                            <% customers.forEach(customerItem => { %>

                                <option
                                    value="<%= customerItem._id %>"
                                >
                                    <%= customerItem.name %>

                                    <% if (customerItem.phone) { %>
                                        — <%= customerItem.phone %>
                                    <% } %>

                                </option>

                            <% }) %>

                        <% } %>

                    </select>

                </div>


                <!-- EVENT TYPE -->

                <div class="form-group">

                    <label for="eventType">
                        Event Type
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        id="eventType"
                        name="eventType"
                        class="form-control"
                        placeholder="e.g. Wedding, Concert"
                        maxlength="100"
                        required
                    >

                </div>


                <!-- EVENT DATE -->

                <div class="form-group">

                    <label for="eventDate">
                        Event Date
                        <span class="required">*</span>
                    </label>

                    <input
                        type="date"
                        id="eventDate"
                        name="eventDate"
                        class="form-control"
                        required
                    >

                </div>


                <!-- LOCATION -->

                <div class="form-group">

                    <label for="location">
                        Location
                        <span class="required">*</span>
                    </label>

                    <input
                        type="text"
                        id="location"
                        name="location"
                        class="form-control"
                        placeholder="Enter event location"
                        maxlength="200"
                        required
                    >

                </div>


                <!-- TOTAL AMOUNT -->

                <div class="form-group">

                    <label for="totalAmount">
                        Total Amount (₹)
                        <span class="required">*</span>
                    </label>

                    <input
                        type="number"
                        id="totalAmount"
                        name="totalAmount"
                        class="form-control"
                        placeholder="Enter total amount"
                        min="0"
                        step="0.01"
                        required
                    >

                </div>


                <!-- ADVANCE -->

                <div class="form-group">

                    <label for="advance">
                        Advance / Paid Amount (₹)
                    </label>

                    <input
                        type="number"
                        id="advance"
                        name="advance"
                        class="form-control"
                        placeholder="Enter advance amount"
                        min="0"
                        step="0.01"
                        value="0"
                    >

                </div>


                <!-- BALANCE -->

                <div class="form-group">

                    <label for="balance">
                        Remaining Balance (₹)
                    </label>

                    <input
                        type="number"
                        id="balance"
                        name="balance"
                        class="form-control"
                        value="0"
                        readonly
                    >

                    <span class="form-helper">
                        Automatically calculated from total and advance.
                    </span>

                </div>


                <!-- PAYMENT STATUS -->

                <div class="form-group">

                    <label for="paymentStatus">
                        Payment Status
                    </label>

                    <input
                        type="text"
                        id="paymentStatus"
                        name="paymentStatus"
                        class="form-control payment-status-input pending"
                        value="Pending"
                        readonly
                    >

                    <span class="form-helper">
                        Automatically calculated from the payment amounts.
                    </span>

                </div>

            </div>

        </div>


        <div class="modal-footer">

            <button
                type="button"
                class="btn btn-secondary"
                onclick="closeBookingModal()"
            >
                Cancel
            </button>

            <button
                type="submit"
                id="saveBookingBtn"
                class="btn btn-primary"
            >
                Save Booking
            </button>

        </div>

    </form>

</div>


</div>

<script>

    const bookingModal =
        document.getElementById("bookingModal");

    const bookingForm =
        document.getElementById("bookingForm");

    const modalTitle =
        document.getElementById("modalTitle");

    const modalSubtitle =
        document.getElementById("modalSubtitle");

    const customer =
        document.getElementById("customer");

    const eventType =
        document.getElementById("eventType");

    const eventDate =
        document.getElementById("eventDate");

    const locationInput =
        document.getElementById("location");

    const totalAmount =
        document.getElementById("totalAmount");

    const advance =
        document.getElementById("advance");

    const balance =
        document.getElementById("balance");

    const paymentStatus =
        document.getElementById("paymentStatus");

    const saveBookingBtn =
        document.getElementById("saveBookingBtn");

    const originalAddAction =
        "/events/add";

    let formMode = "add";


    /* CALCULATE BALANCE AND STATUS */

    function calculatePayment() {

        const total =
            Math.max(
                Number(totalAmount.value) || 0,
                0
            );

        const paid =
            Math.max(
                Number(advance.value) || 0,
                0
            );

        const remaining =
            Math.max(
                total - paid,
                0
            );

        balance.value =
            remaining.toFixed(2);

        let status = "Pending";

        if (total > 0 && paid >= total) {

            status = "Paid";

        } else if (paid > 0) {

            status = "Partial";

        }

        paymentStatus.value = status;

        paymentStatus.classList.remove(
            "pending",
            "partial",
            "paid"
        );

        paymentStatus.classList.add(
            status.toLowerCase()
        );

    }


    totalAmount.addEventListener(
        "input",
        calculatePayment
    );

    advance.addEventListener(
        "input",
        calculatePayment
    );


    /* OPEN NEW BOOKING */

    function openNewBooking() {

        bookingForm.reset();

        formMode = "add";

        bookingForm.action =
            originalAddAction;

        modalTitle.textContent =
            "New Booking";

        modalSubtitle.textContent =
            "Add a new event booking.";

        saveBookingBtn.textContent =
            "Save Booking";

        saveBookingBtn.style.display =
            "inline-flex";

        saveBookingBtn.disabled =
            false;

        setFormDisabled(false);

        advance.value = "0";

        balance.value = "0";

        calculatePayment();

        bookingModal.classList.add("show");

        bookingModal.setAttribute(
            "aria-hidden",
            "false"
        );

        document.body.style.overflow =
            "hidden";

        customer.focus();

    }


    /* VIEW BOOKING */

    async function viewBooking(id) {

        try {

            const response =
                await fetch(
                    `/events/view/${encodeURIComponent(id)}`
                );

            if (!response.ok) {

                throw new Error(
                    "Unable to load booking."
                );

            }

            const booking =
                await response.json();

            fillBookingForm(booking);

            formMode = "view";

            bookingForm.action = "#";

            modalTitle.textContent =
                "View Booking";

            modalSubtitle.textContent =
                "Review the booking details.";

            saveBookingBtn.style.display =
                "none";

            setFormDisabled(true);

            bookingModal.classList.add("show");

            bookingModal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";

        } catch (error) {

            console.error(error);

            alert(
                "Unable to load booking details."
            );

        }

    }


    /* EDIT BOOKING */

    async function editBooking(id) {

        try {

            const response =
                await fetch(
                    `/events/view/${encodeURIComponent(id)}`
                );

            if (!response.ok) {

                throw new Error(
                    "Unable to load booking."
                );

            }

            const booking =
                await response.json();

            fillBookingForm(booking);

            formMode = "edit";

            bookingForm.action =
                `/events/edit/${encodeURIComponent(id)}`;

            modalTitle.textContent =
                "Edit Booking";

            modalSubtitle.textContent =
                "Update the booking information.";

            saveBookingBtn.textContent =
                "Update Booking";

            saveBookingBtn.style.display =
                "inline-flex";

            saveBookingBtn.disabled =
                false;

            setFormDisabled(false);

            bookingModal.classList.add("show");

            bookingModal.setAttribute(
                "aria-hidden",
                "false"
            );

            document.body.style.overflow =
                "hidden";

        } catch (error) {

            console.error(error);

            alert(
                "Unable to load booking details."
            );

        }

    }


    /* FILL FORM */

    function fillBookingForm(booking) {

        if (
            booking.customer &&
            typeof booking.customer === "object"
        ) {

            customer.value =
                booking.customer._id ||
                booking.customer.id ||
                "";

        } else {

            customer.value =
                booking.customer || "";

        }


        eventType.value =
            booking.eventType || "";


        if (booking.eventDate) {

            const date =
                new Date(booking.eventDate);

            if (!isNaN(date.getTime())) {

                const year =
                    date.getFullYear();

                const month =
                    String(
                        date.getMonth() + 1
                    ).padStart(2, "0");

                const day =
                    String(
                        date.getDate()
                    ).padStart(2, "0");

                eventDate.value =
                    `${year}-${month}-${day}`;

            } else {

                eventDate.value = "";

            }

        } else {

            eventDate.value = "";

        }


        locationInput.value =
            booking.location || "";

        totalAmount.value =
            booking.totalAmount ?? 0;

        advance.value =
            booking.advance ?? 0;

        calculatePayment();

    }


    /* ENABLE / DISABLE FORM FIELDS */

    function setFormDisabled(disabled) {

        bookingForm
            .querySelectorAll("input, select")
            .forEach(field => {

                field.disabled =
                    disabled;

            });

        saveBookingBtn.disabled =
            disabled;

    }


    /* CLOSE MODAL */

    function closeBookingModal() {

        bookingModal.classList.remove(
            "show"
        );

        bookingModal.setAttribute(
            "aria-hidden",
            "true"
        );

        document.body.style.overflow =
            "";

        bookingForm.reset();

        formMode = "add";

        bookingForm.action =
            originalAddAction;

        setFormDisabled(false);

        saveBookingBtn.style.display =
            "inline-flex";

        saveBookingBtn.textContent =
            "Save Booking";

        saveBookingBtn.disabled =
            false;

        advance.value =
            "0";

        calculatePayment();

    }


    /* VALIDATE FORM */

    bookingForm.addEventListener(
        "submit",
        event => {

            if (formMode === "view") {

                event.preventDefault();

                return;

            }

            const total =
                Number(totalAmount.value);

            const paid =
                Number(advance.value);


            if (
                !Number.isFinite(total) ||
                total < 0
            ) {

                event.preventDefault();

                alert(
                    "Please enter a valid total amount."
                );

                totalAmount.focus();

                return;

            }


            if (
                !Number.isFinite(paid) ||
                paid < 0
            ) {

                event.preventDefault();

                alert(
                    "Please enter a valid advance amount."
                );

                advance.focus();

                return;

            }


            if (paid > total) {

                event.preventDefault();

                alert(
                    "Advance cannot be greater than the total amount."
                );

                advance.focus();

                return;

            }


            calculatePayment();

            saveBookingBtn.disabled =
                true;

            saveBookingBtn.textContent =
                formMode === "edit"
                    ? "Updating..."
                    : "Saving...";

        }
    );


    /* DELETE BOOKING */

    async function deleteBooking(id) {

        const confirmed =
            confirm(
                "Are you sure you want to delete this booking?"
            );

        if (!confirmed) {

            return;

        }


        try {

            const response =
                await fetch(
                    `/events/delete/${encodeURIComponent(id)}`,
                    {
                        method: "POST"
                    }
                );

            if (!response.ok) {

                throw new Error(
                    "Delete failed."
                );

            }

            window.location.reload();

        } catch (error) {

            console.error(error);

            alert(
                "Unable to delete this booking. Please try again."
            );

        }

    }


    /* SEARCH */

    function filterEvents() {

        const search =
            document
                .getElementById("searchInput")
                .value
                .toLowerCase()
                .trim();


        const rows =
            document.querySelectorAll(
                ".booking-row"
            );


        let visibleCount = 0;


        rows.forEach(row => {

            const customerText =
                row.dataset.customer || "";

            const locationText =
                row.dataset.location || "";


            const matchesSearch =
                !search ||
                customerText.includes(search) ||
                locationText.includes(search);


            const visible =
                matchesSearch;


            row.style.display =
                visible ? "" : "none";


            if (visible) {

                visibleCount++;

            }

        });


        document.getElementById(
            "bookingCount"
        ).textContent =
            visibleCount;


        const emptyState =
            document.getElementById(
                "emptyState"
            );


        const initialEmptyState =
            document.getElementById(
                "initialEmptyState"
            );


        const table =
            document.querySelector(
                ".bookings-table"
            );


        if (initialEmptyState) {

            initialEmptyState.style.display =
                "none";

        }


        if (rows.length === 0) {

            table.style.display =
                "none";

            emptyState.style.display =
                "none";


            if (initialEmptyState) {

                initialEmptyState.style.display =
                    "block";

            }

        } else {

            table.style.display =
                visibleCount === 0
                    ? "none"
                    : "table";


            emptyState.style.display =
                visibleCount === 0
                    ? "block"
                    : "none";

        }

    }


    /* RESET FILTERS */

    function resetFilters() {

        document.getElementById(
            "searchInput"
        ).value = "";

        filterEvents();

    }


    /* CLOSE WHEN CLICKING OUTSIDE MODAL */

    bookingModal.addEventListener(
        "click",
        event => {

            if (
                event.target ===
                bookingModal
            ) {

                closeBookingModal();

            }

        }
    );


    /* CLOSE WITH ESCAPE */

    document.addEventListener(
        "keydown",
        event => {

            if (
                event.key === "Escape" &&
                bookingModal.classList.contains(
                    "show"
                )
            ) {

                closeBookingModal();

            }

        }
    );


    /* INITIALIZE */

    calculatePayment();

</script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= invoice.invoiceNumber %> | expro AUDIO</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f3f4f6;
            color: #1f2937;
            padding: 30px;
        }

        .page {
            max-width: 900px;
            margin: auto;
        }

        /* ACTIONS */

        .actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
        }

        .back-btn {
            text-decoration: none;
            color: #374151;
            font-size: 14px;
            font-weight: 600;
        }

        .back-btn:hover {
            color: #635bff;
        }

        .action-buttons {
            display: flex;
            gap: 10px;
        }

        .btn {
            border: none;
            padding: 10px 16px;
            border-radius: 7px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 600;
            text-decoration: none;
            display: inline-block;
        }

        .btn-pdf {
            background: #635bff;
            color: white;
        }

        .btn-pdf:hover {
            background: #5045e5;
        }

        .btn-whatsapp {
            background: #16a34a;
            color: white;
        }

        .btn-whatsapp:hover {
            background: #15803d;
        }

        /* INVOICE */

        .invoice {
            background: white;
            padding: 45px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
        }

        /* HEADER */

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 20px;
            padding-bottom: 25px;
            border-bottom: 2px solid #635bff;
        }

        .brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .brand-icon {
            width: 46px;
            height: 46px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            background: #eeecff;
            border-radius: 12px;
            font-size: 24px;
        }

        .company-name {
            font-size: 28px;
            font-weight: 800;
            color: #202137;
            letter-spacing: -0.6px;
        }

        .company-name span {
            color: #635bff;
        }

        .company-subtitle {
            margin-top: 7px;
            color: #6b7280;
            font-size: 13px;
        }

        .invoice-title {
            text-align: right;
        }

        .invoice-title h1 {
            font-size: 30px;
            color: #635bff;
            margin-bottom: 8px;
            letter-spacing: 1px;
        }

        .invoice-number {
            font-size: 14px;
            color: #374151;
            font-weight: 600;
        }

        .invoice-date {
            margin-top: 7px;
            color: #6b7280;
            font-size: 13px;
        }

        /* CUSTOMER / EVENT */

        .info-section {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            padding: 25px 0;
        }

        .info-box {
            background: #faf9ff;
            border: 1px solid #e5e7eb;
            border-radius: 9px;
            padding: 17px;
            min-width: 0;
        }

        .info-box h3 {
            font-size: 11px;
            text-transform: uppercase;
            color: #635bff;
            margin-bottom: 9px;
            letter-spacing: 0.6px;
        }

        .info-box strong {
            display: block;
            font-size: 16px;
            color: #111827;
            margin-bottom: 6px;
            overflow-wrap: anywhere;
        }

        .info-box p {
            font-size: 13px;
            color: #4b5563;
            margin-top: 5px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }

        /* TABLE */

        .section-heading {
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 12px;
            color: #202137;
        }

        .invoice-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .invoice-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 5px;
        }

        .invoice-table th {
            background: #f5f4ff;
            padding: 13px;
            text-align: left;
            font-size: 12px;
            color: #5f5b79;
            text-transform: uppercase;
            border-bottom: 1px solid #e5e7eb;
        }

        .invoice-table td {
            padding: 14px 13px;
            border-bottom: 1px solid #e5e7eb;
            font-size: 14px;
            overflow-wrap: anywhere;
        }

        .invoice-table .amount {
            text-align: right;
            font-weight: 600;
            white-space: nowrap;
        }

        .discount-amount {
            color: #dc2626;
        }

        /* SUMMARY */

        .summary-section {
            display: flex;
            justify-content: flex-end;
            margin-top: 25px;
        }

        .summary {
            width: 330px;
            max-width: 100%;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            padding: 8px 0;
            font-size: 14px;
        }

        .summary-row.total {
            border-top: 2px solid #202137;
            margin-top: 8px;
            padding-top: 14px;
            font-size: 18px;
            font-weight: 800;
        }

        .summary-row.advance {
            color: #166534;
            font-weight: 600;
        }

        .summary-row.balance {
            background: #eeecff;
            padding: 13px;
            border-radius: 7px;
            margin-top: 8px;
            font-size: 17px;
            font-weight: 800;
            color: #4334b5;
        }

        .summary-row span:last-child {
            text-align: right;
            white-space: nowrap;
        }

        /* PAYMENT STATUS */

        .status-box {
            margin-top: 25px;
            display: flex;
            justify-content: flex-end;
        }

        .status {
            display: inline-block;
            padding: 7px 13px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: 700;
        }

        .paid {
            background: #dcfce7;
            color: #166534;
        }

        .partial {
            background: #fef3c7;
            color: #92400e;
        }

        .pending {
            background: #fee2e2;
            color: #991b1b;
        }

        /* NOTES */

        .notes {
            margin-top: 30px;
            padding: 17px;
            background: #faf9ff;
            border: 1px solid #e5e7eb;
            border-left: 3px solid #635bff;
            border-radius: 8px;
        }

        .notes h3 {
            font-size: 13px;
            margin-bottom: 8px;
            color: #374151;
        }

        .notes p {
            color: #6b7280;
            font-size: 13px;
            line-height: 1.7;
            white-space: pre-line;
            overflow-wrap: anywhere;
        }

        /* FOOTER */

        .footer {
            text-align: center;
            margin-top: 35px;
            padding-top: 18px;
            border-top: 1px solid #e5e7eb;
            color: #6b7280;
            font-size: 12px;
            line-height: 1.8;
        }

        .footer strong {
            color: #635bff;
            font-size: 13px;
            letter-spacing: 0.5px;
        }

        /* MOBILE */

        @media (max-width: 650px) {
            body {
                padding: 12px;
            }

            .invoice {
                padding: 22px;
            }

            .invoice-header {
                flex-direction: column;
                gap: 20px;
            }

            .company-name {
                font-size: 25px;
            }

            .invoice-title {
                text-align: left;
            }

            .invoice-title h1 {
                font-size: 26px;
            }

            .info-section {
                grid-template-columns: 1fr;
                gap: 12px;
            }

            .summary {
                width: 100%;
            }

            .actions {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .action-buttons {
                width: 100%;
            }

            .action-buttons .btn {
                flex: 1;
                text-align: center;
            }

            .invoice-table {
                min-width: 400px;
            }

            .status-box {
                justify-content: flex-start;
            }
        }

        /* PRINT / PDF */

        @page {
            size: A4;
            margin: 12mm;
        }

        @media print {
            body {
                background: white;
                padding: 0;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }

            .actions {
                display: none !important;
            }

            .invoice {
                box-shadow: none;
                border-radius: 0;
                padding: 15px;
                border: none;
            }

            .page {
                max-width: none;
            }

            .info-box {
                background: #faf9ff !important;
            }

            .notes {
                background: #faf9ff !important;
            }

            .invoice-table {
                min-width: 0;
            }

            .invoice-table-wrapper {
                overflow: visible;
            }

            .info-box,
            .notes,
            .invoice-table tr {
                break-inside: avoid;
            }
        }
    </style>
</head>

<body>
<div class="page">

    <!-- ACTIONS -->
    <div class="actions">
        <a href="/invoices" class="back-btn">
            ← Back to Invoices
        </a>

        <div class="action-buttons">
            <button
                type="button"
                class="btn btn-pdf"
                onclick="savePDF()"
            >
                📄 Save PDF
            </button>

            <button
                type="button"
                class="btn btn-whatsapp"
                onclick="shareWhatsApp()"
            >
                💬 WhatsApp
            </button>
        </div>
    </div>

    <!-- INVOICE -->
    <div class="invoice">

        <!-- HEADER -->
        <div class="invoice-header">
            <div>
                <div class="brand">
                    <div class="brand-icon">🎧</div>

                    <div>
                        <div class="company-name">
                            expro <span>AUDIO</span>
                        </div>

                        <div class="company-subtitle">
                            Sound &amp; Event Rental Services
                        </div>
                    </div>
                </div>
            </div>

            <div class="invoice-title">
                <h1>INVOICE</h1>

                <div class="invoice-number">
                    <%= invoice.invoiceNumber %>
                </div>

                <div class="invoice-date">
                    Invoice Date:
                    <%= invoice.createdAt
                        ? new Date(invoice.createdAt).toLocaleDateString("en-IN")
                        : "-" %>
                </div>
            </div>
        </div>

        <!-- CUSTOMER + EVENT -->
        <div class="info-section">

            <div class="info-box">
                <h3>Bill To</h3>

                <strong>
                    <%= invoice.booking?.customer?.name || "Unknown Customer" %>
                </strong>

                <% if (invoice.booking?.customer?.phone) { %>
                    <p>
                        📞 <%= invoice.booking.customer.phone %>
                    </p>
                <% } %>

                <% if (invoice.booking?.customer?.address) { %>
                    <p>
                        📍 <%= invoice.booking.customer.address %>
                    </p>
                <% } %>
            </div>

            <div class="info-box">
                <h3>Event Details</h3>

                <strong>
                    <%= invoice.booking?.eventType || "-" %>
                </strong>

                <% if (invoice.booking?.eventDate) { %>
                    <p>
                        📅 <%= new Date(
                            invoice.booking.eventDate
                        ).toLocaleDateString("en-IN") %>
                    </p>
                <% } %>

                <% if (invoice.booking?.location) { %>
                    <p>
                        📍 <%= invoice.booking.location %>
                    </p>
                <% } %>
            </div>

        </div>

        <!-- CHARGES -->
        <h2 class="section-heading">Invoice Summary</h2>

        <div class="invoice-table-wrapper">
            <table class="invoice-table">
                <thead>
                    <tr>
                        <th>Description</th>
                        <th style="text-align: right;">Amount</th>
                    </tr>
                </thead>

                <tbody>

                    <% if (Number(invoice.rentalAmount || 0) > 0) { %>
                        <tr>
                            <td>Equipment / Rental</td>
                            <td class="amount">
                                ₹ <%= Number(invoice.rentalAmount).toLocaleString("en-IN") %>
                            </td>
                        </tr>
                    <% } %>

                    <% if (Number(invoice.transportCharge || 0) > 0) { %>
                        <tr>
                            <td>Transport Charge</td>
                            <td class="amount">
                                ₹ <%= Number(invoice.transportCharge).toLocaleString("en-IN") %>
                            </td>
                        </tr>
                    <% } %>

                    <% if (Number(invoice.labourCharge || 0) > 0) { %>
                        <tr>
                            <td>Labour Charge</td>
                            <td class="amount">
                                ₹ <%= Number(invoice.labourCharge).toLocaleString("en-IN") %>
                            </td>
                        </tr>
                    <% } %>

                    <% if (Number(invoice.extraCharge || 0) > 0) { %>
                        <tr>
                            <td>Extra Charge</td>
                            <td class="amount">
                                ₹ <%= Number(invoice.extraCharge).toLocaleString("en-IN") %>
                            </td>
                        </tr>
                    <% } %>

                    <% if (Number(invoice.discount || 0) > 0) { %>
                        <tr>
                            <td>Discount</td>
                            <td class="amount discount-amount">
                                - ₹ <%= Number(invoice.discount).toLocaleString("en-IN") %>
                            </td>
                        </tr>
                    <% } %>

                </tbody>
            </table>
        </div>

        <!-- SUMMARY -->
        <div class="summary-section">
            <div class="summary">

                <div class="summary-row total">
                    <span>Total</span>
                    <span>
                        ₹ <%= Number(
                            invoice.totalAmount || 0
                        ).toLocaleString("en-IN") %>
                    </span>
                </div>

                <div class="summary-row advance">
                    <span>Advance Paid</span>
                    <span>
                        ₹ <%= Number(
                            invoice.advance || 0
                        ).toLocaleString("en-IN") %>
                    </span>
                </div>

                <div class="summary-row balance">
                    <span>Balance Due</span>
                    <span>
                        ₹ <%= Number(
                            invoice.balance || 0
                        ).toLocaleString("en-IN") %>
                    </span>
                </div>

            </div>
        </div>

        <!-- PAYMENT STATUS -->
        <div class="status-box">

            <% if (invoice.paymentStatus === "Paid") { %>
                <span class="status paid">
                    ✓ PAID
                </span>

            <% } else if (invoice.paymentStatus === "Partial") { %>
                <span class="status partial">
                    PARTIAL PAYMENT
                </span>

            <% } else { %>
                <span class="status pending">
                    PAYMENT PENDING
                </span>
            <% } %>

        </div>

        <!-- NOTES -->
        <% if (invoice.notes) { %>
            <div class="notes">
                <h3>Notes</h3>
                <p><%= invoice.notes %></p>
            </div>
        <% } %>

        <!-- FOOTER -->
        <div class="footer">
            <div>Thank you for choosing <strong>expro AUDIO!</strong></div>

            <div>
                We appreciate your business and look forward to serving you again.
            </div>

            <div style="margin-top: 8px;">
                Professional Sound &amp; Event Rental Services
            </div>
        </div>

    </div>
</div>

<script>
    /* SAVE PDF */
    function savePDF() {
        window.print();
    }

    /* WHATSAPP SHARE */
    function shareWhatsApp() {
        const invoiceNumber = <%- JSON.stringify(String(invoice.invoiceNumber || "")) %>;

        const customerName = <%- JSON.stringify(
            String(invoice.booking?.customer?.name || "Customer")
        ) %>;

        const eventType = <%- JSON.stringify(
            String(invoice.booking?.eventType || "-")
        ) %>;

        const eventDate = <%- JSON.stringify(
            invoice.booking?.eventDate
                ? new Date(invoice.booking.eventDate).toLocaleDateString("en-IN")
                : ""
        ) %>;

        const total = <%- JSON.stringify(
            Number(invoice.totalAmount || 0).toLocaleString("en-IN")
        ) %>;

        const advance = <%- JSON.stringify(
            Number(invoice.advance || 0).toLocaleString("en-IN")
        ) %>;

        const balance = <%- JSON.stringify(
            Number(invoice.balance || 0).toLocaleString("en-IN")
        ) %>;

        const message =
            "Hello " + customerName + ",\n\n" +
            "Invoice from expro AUDIO\n\n" +
            "Invoice No: " + invoiceNumber + "\n" +
            "Event: " + eventType + "\n" +
            (eventDate ? "Event Date: " + eventDate + "\n" : "") +
            "\n" +
            "Total: ₹ " + total + "\n" +
            "Advance Paid: ₹ " + advance + "\n" +
            "Balance Due: ₹ " + balance + "\n\n" +
            "Thank you for choosing expro AUDIO!";

        const whatsappURL =
            "https://wa.me/?text=" + encodeURIComponent(message);

        window.open(whatsappURL, "_blank", "noopener,noreferrer");
    }
</script>

</body>
</html>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Customers | Sound Billing</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #635bff;
            --primary-dark: #5046e5;
            --primary-light: #eeedff;
            --background: #f5f7fb;
            --surface: #ffffff;
            --text: #172033;
            --text-secondary: #667085;
            --border: #e4e7ec;
            --success: #067647;
            --success-bg: #ecfdf3;
            --danger: #b42318;
            --danger-bg: #fef3f2;
            --shadow: 0 4px 18px rgba(16, 24, 40, 0.06);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--background);
            color: var(--text);
            font-size: 14px;
            line-height: 1.5;
        }

        button,
        input {
            font: inherit;
        }

        button,
        a {
            -webkit-tap-highlight-color: transparent;
        }

        .main-content {
            margin-left: 220px;
            padding: 32px;
            min-height: 100vh;
        }

        /* Header */

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 28px;
            flex-wrap: wrap;
        }

        .page-title {
            font-size: 28px;
            font-weight: 800;
            color: #101828;
            letter-spacing: -0.7px;
        }

        .page-subtitle {
            margin-top: 6px;
            font-size: 14px;
            color: var(--text-secondary);
        }

        /* Buttons */

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border: none;
            border-radius: 9px;
            padding: 11px 17px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            text-decoration: none;
            transition: all 0.2s ease;
            white-space: nowrap;
        }

        .btn-primary {
            background: var(--primary);
            color: #ffffff;
            box-shadow: 0 3px 8px rgba(99, 91, 255, 0.2);
        }

        .btn-primary:hover {
            background: var(--primary-dark);
            transform: translateY(-1px);
        }

        .btn-secondary {
            background: #ffffff;
            color: #344054;
            border: 1px solid #d0d5dd;
        }

        .btn-secondary:hover {
            background: #f9fafb;
        }

        .btn-danger {
            background: var(--danger-bg);
            color: var(--danger);
            border: 1px solid #fecdca;
        }

        .btn-danger:hover {
            background: #fee4e2;
        }

        /* Summary card */

        .summary-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            padding: 21px 24px;
            margin-bottom: 24px;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 17px;
        }

        .summary-icon {
            width: 48px;
            height: 48px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 23px;
            flex-shrink: 0;
        }

        .summary-label {
            font-size: 13px;
            color: var(--text-secondary);
            font-weight: 600;
        }

        .summary-value {
            margin-top: 3px;
            font-size: 25px;
            font-weight: 800;
            color: #101828;
        }

        /* Table card */

        .table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 14px;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .table-header {
            padding: 21px 24px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 15px;
            flex-wrap: wrap;
        }

        .table-heading {
            font-size: 17px;
            font-weight: 750;
            color: #101828;
        }

        .table-description {
            margin-top: 4px;
            color: var(--text-secondary);
            font-size: 12px;
        }

        .search-box {
            width: 260px;
            max-width: 100%;
            position: relative;
        }

        .search-box input {
            width: 100%;
            height: 42px;
            padding: 0 13px 0 38px;
            border: 1px solid #d0d5dd;
            border-radius: 9px;
            outline: none;
            color: var(--text);
            background: #ffffff;
            font-size: 13px;
        }

        .search-box input::placeholder {
            color: #98a2b3;
        }

        .search-box input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.12);
        }

        .search-icon {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #667085;
            font-size: 16px;
            pointer-events: none;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
        }

        thead {
            background: #f9fafb;
        }

        th {
            padding: 15px 24px;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.6px;
            font-weight: 800;
            color: #475467;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        td {
            padding: 17px 24px;
            border-bottom: 1px solid #eaecf0;
            color: #344054;
            font-size: 13px;
            font-weight: 500;
            vertical-align: middle;
        }

        tbody tr {
            transition: background 0.15s ease;
        }

        tbody tr:hover {
            background: #fafaff;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .customer-name {
            font-weight: 750;
            font-size: 13px;
            color: #101828;
        }

        .phone-number {
            color: #344054;
            font-weight: 600;
            white-space: nowrap;
        }

        .place-text {
            color: #475467;
        }

        .action-buttons {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .action-btn {
            border: 1px solid #d0d5dd;
            border-radius: 7px;
            background: #ffffff;
            padding: 7px 11px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .edit-btn {
            color: var(--primary);
            border-color: #d9d6fe;
            background: #f5f4ff;
        }

        .edit-btn:hover {
            background: #e9e7ff;
        }

        .delete-btn {
            color: var(--danger);
            border-color: #fecdca;
            background: #fffafa;
        }

        .delete-btn:hover {
            background: var(--danger-bg);
        }

        .empty-state {
            display: none;
            text-align: center;
            padding: 50px 20px;
        }

        .empty-icon {
            font-size: 35px;
            margin-bottom: 12px;
        }

        .empty-title {
            color: #101828;
            font-size: 16px;
            font-weight: 750;
        }

        .empty-description {
            margin-top: 5px;
            color: var(--text-secondary);
            font-size: 13px;
        }

        /* Modal */

        .modal-overlay {
            position: fixed;
            inset: 0;
            z-index: 1000;
            background: rgba(16, 24, 40, 0.58);
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            backdrop-filter: blur(4px);
        }

        .modal-overlay.active {
            display: flex;
        }

        .modal {
            background: #ffffff;
            width: 100%;
            max-width: 470px;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 24px 60px rgba(16, 24, 40, 0.2);
            animation: modalOpen 0.2s ease;
        }

        @keyframes modalOpen {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.98);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            padding: 23px 25px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 15px;
        }

        .modal-title {
            font-size: 20px;
            font-weight: 800;
            color: #101828;
        }

        .modal-subtitle {
            color: var(--text-secondary);
            font-size: 12px;
            margin-top: 5px;
        }

        .close-btn {
            width: 34px;
            height: 34px;
            border: none;
            border-radius: 8px;
            background: #f2f4f7;
            color: #475467;
            font-size: 21px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .close-btn:hover {
            background: #e4e7ec;
        }

        .modal-body {
            padding: 24px 25px;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-group:last-child {
            margin-bottom: 0;
        }

        .form-label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 750;
            color: #344054;
        }

        .required {
            color: #d92d20;
        }

        .form-control {
            width: 100%;
            height: 45px;
            padding: 0 13px;
            border: 1px solid #d0d5dd;
            border-radius: 9px;
            outline: none;
            background: #ffffff;
            color: #101828;
            font-size: 14px;
            transition: all 0.2s ease;
        }

        .form-control::placeholder {
            color: #98a2b3;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.12);
        }

        .form-control.invalid {
            border-color: #f04438;
        }

        .field-error {
            display: none;
            color: #d92d20;
            font-size: 12px;
            margin-top: 6px;
        }

        .field-error.show {
            display: block;
        }

        .modal-footer {
            padding: 18px 25px;
            background: #f9fafb;
            border-top: 1px solid var(--border);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        .modal-footer .btn {
            min-width: 105px;
        }

        /* Responsive */

        @media (max-width: 1000px) {
            .main-content {
                padding: 24px;
            }

            th,
            td {
                padding: 14px 18px;
            }
        }

        @media (max-width: 768px) {
            .main-content {
                margin-left: 0;
                padding: 20px 14px;
            }

            .page-title {
                font-size: 24px;
            }

            .page-header {
                align-items: flex-start;
            }

            .page-header .btn {
                width: 100%;
            }

            .summary-card {
                padding: 18px;
            }

            .table-header {
                padding: 18px;
            }

            .search-box {
                width: 100%;
            }

            th,
            td {
                padding: 13px 15px;
            }

            .modal-header,
            .modal-body {
                padding: 20px;
            }

            .modal-footer {
                padding: 16px 20px;
            }
        }
    </style>
</head>

<body>

    <%- include("partials/sidebar") %>

    <main class="main-content">

        <!-- Page Header -->
        <header class="page-header">
            <div>
                <h1 class="page-title">Customers</h1>
                <p class="page-subtitle">
                    Manage your customers and their contact details.
                </p>
            </div>

            <button type="button" class="btn btn-primary" id="addCustomerBtn">
                <span aria-hidden="true">＋</span>
                Add Customer
            </button>
        </header>

        <!-- Customer Count -->
        <section class="summary-card">
            <div class="summary-icon" aria-hidden="true">♙</div>

            <div>
                <p class="summary-label">Total Customers</p>
                <p class="summary-value" id="totalCustomers">
                    <%= customers.length %>
                </p>
            </div>
        </section>

        <!-- Customer Table -->
        <section class="table-card">

            <div class="table-header">
                <div>
                    <h2 class="table-heading">Customer List</h2>
                    <p class="table-description">
                        View, edit, and manage your customer information.
                    </p>
                </div>

                <div class="search-box">
                    <span class="search-icon" aria-hidden="true">⌕</span>

                    <input
                        type="search"
                        id="customerSearch"
                        placeholder="Search name, phone or place..."
                        aria-label="Search customers"
                    >
                </div>
            </div>

            <div class="table-wrapper">
                <table>
                    <thead>
                        <tr>
                            <th>Customer Name</th>
                            <th>Phone Number</th>
                            <th>Place</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody id="customerTableBody">

                        <% if (customers.length > 0) { %>

                            <% customers.forEach(customer => { %>

                                <tr class="customer-row">
                                    <td>
                                        <span class="customer-name">
                                            <%= customer.name || "-" %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="phone-number">
                                            <%= customer.phone || "-" %>
                                        </span>
                                    </td>

                                    <td>
                                        <span class="place-text">
                                            <%= customer.place || "-" %>
                                        </span>
                                    </td>

                                    <td>
                                        <div class="action-buttons">

                                            <button
                                                type="button"
                                                class="action-btn edit-btn"
                                                data-id="<%= customer._id %>"
                                                data-name="<%= customer.name || '' %>"
                                                data-phone="<%= customer.phone || '' %>"
                                                data-place="<%= customer.place || '' %>"
                                            >
                                                Edit
                                            </button>

                                            <form
                                                action="/customers/delete/<%= customer._id %>"
                                                method="POST"
                                                class="delete-form"
                                            >
                                                <button
                                                    type="submit"
                                                    class="action-btn delete-btn"
                                                >
                                                    Delete
                                                </button>
                                            </form>

                                        </div>
                                    </td>
                                </tr>

                            <% }) %>

                        <% } %>

                    </tbody>
                </table>
            </div>

            <div class="empty-state" id="emptyState">
                <div class="empty-icon" aria-hidden="true">⌕</div>
                <h3 class="empty-title">No customers found</h3>
                <p class="empty-description">
                    Try another search or add a new customer.
                </p>
            </div>

        </section>
    </main>

    <!-- Add / Edit Customer Modal -->
    <div
        class="modal-overlay"
        id="customerModal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="modalTitle"
    >
        <div class="modal">

            <div class="modal-header">
                <div>
                    <h2 class="modal-title" id="modalTitle">Add Customer</h2>
                    <p class="modal-subtitle" id="modalSubtitle">
                        Enter the customer's contact information.
                    </p>
                </div>

                <button
                    type="button"
                    class="close-btn"
                    id="closeModalBtn"
                    aria-label="Close modal"
                >
                    &times;
                </button>
            </div>

            <form id="customerForm" action="/customers/add" method="POST">

                <div class="modal-body">

                    <!-- Customer Name -->
                    <div class="form-group">
                        <label for="customerName" class="form-label">
                            Customer Name <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="customerName"
                            name="name"
                            placeholder="Enter customer name"
                            maxlength="100"
                            required
                        >

                        <p class="field-error" id="nameError">
                            Please enter a valid customer name.
                        </p>
                    </div>

                    <!-- Phone Number -->
                    <div class="form-group">
                        <label for="customerPhone" class="form-label">
                            Phone Number <span class="required">*</span>
                        </label>

                        <input
                            type="tel"
                            class="form-control"
                            id="customerPhone"
                            name="phone"
                            placeholder="Enter phone number"
                            maxlength="15"
                            inputmode="tel"
                            required
                        >

                        <p class="field-error" id="phoneError">
                            Please enter a valid phone number.
                        </p>
                    </div>

                    <!-- Place -->
                    <div class="form-group">
                        <label for="customerPlace" class="form-label">
                            Place <span class="required">*</span>
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="customerPlace"
                            name="place"
                            placeholder="Enter place or city"
                            maxlength="100"
                            required
                        >

                        <p class="field-error" id="placeError">
                            Please enter the customer's place.
                        </p>
                    </div>

                </div>

                <div class="modal-footer">
                    <button
                        type="button"
                        class="btn btn-secondary"
                        id="cancelModalBtn"
                    >
                        Cancel
                    </button>

                    <button
                        type="submit"
                        class="btn btn-primary"
                        id="saveCustomerBtn"
                    >
                        Save Customer
                    </button>
                </div>

            </form>
        </div>
    </div>

    <script>
        const customerModal = document.getElementById("customerModal");
        const customerForm = document.getElementById("customerForm");

        const modalTitle = document.getElementById("modalTitle");
        const modalSubtitle = document.getElementById("modalSubtitle");
        const saveCustomerBtn = document.getElementById("saveCustomerBtn");

        const nameInput = document.getElementById("customerName");
        const phoneInput = document.getElementById("customerPhone");
        const placeInput = document.getElementById("customerPlace");

        const customerSearch = document.getElementById("customerSearch");
        const customerTableBody = document.getElementById("customerTableBody");
        const totalCustomers = document.getElementById("totalCustomers");
        const emptyState = document.getElementById("emptyState");

        const originalAddAction = "/customers/add";

        function openModal() {
            customerModal.classList.add("active");
            document.body.style.overflow = "hidden";

            setTimeout(() => nameInput.focus(), 100);
        }

        function closeModal() {
            customerModal.classList.remove("active");
            document.body.style.overflow = "";
            customerForm.reset();
            clearErrors();
        }

        function clearErrors() {
            document.querySelectorAll(".field-error").forEach(error => {
                error.classList.remove("show");
            });

            document.querySelectorAll(".form-control").forEach(input => {
                input.classList.remove("invalid");
            });
        }

        function showError(input, errorId, message) {
            input.classList.add("invalid");

            const error = document.getElementById(errorId);
            error.textContent = message;
            error.classList.add("show");
        }

        document.getElementById("addCustomerBtn").addEventListener("click", () => {
            customerForm.action = originalAddAction;
            customerForm.dataset.mode = "add";

            modalTitle.textContent = "Add Customer";
            modalSubtitle.textContent = "Enter the customer's contact information.";
            saveCustomerBtn.textContent = "Save Customer";

            customerForm.reset();
            clearErrors();
            openModal();
        });

        document.getElementById("closeModalBtn").addEventListener("click", closeModal);
        document.getElementById("cancelModalBtn").addEventListener("click", closeModal);

        customerModal.addEventListener("click", event => {
            if (event.target === customerModal) {
                closeModal();
            }
        });

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && customerModal.classList.contains("active")) {
                closeModal();
            }
        });

        // Edit customer
        document.querySelectorAll(".edit-btn").forEach(button => {
            button.addEventListener("click", () => {
                const customerId = button.dataset.id;

                customerForm.action = `/customers/edit/${customerId}`;
                customerForm.dataset.mode = "edit";

                modalTitle.textContent = "Edit Customer";
                modalSubtitle.textContent = "Update the customer's contact information.";
                saveCustomerBtn.textContent = "Update Customer";

                nameInput.value = button.dataset.name || "";
                phoneInput.value = button.dataset.phone || "";
                placeInput.value = button.dataset.place || "";

                clearErrors();
                openModal();
            });
        });

        // Validate form before submitting
        customerForm.addEventListener("submit", event => {
            clearErrors();

            let isValid = true;

            const name = nameInput.value.trim();
            const phone = phoneInput.value.trim();
            const place = placeInput.value.trim();

            if (name.length < 2) {
                showError(nameInput, "nameError", "Name must contain at least 2 characters.");
                isValid = false;
            }

            // Allows international prefixes, spaces, and common phone separators.
            const normalizedPhone = phone.replace(/[\s()+-]/g, "");

            if (!/^\d{7,15}$/.test(normalizedPhone)) {
                showError(phoneInput, "phoneError", "Enter a valid phone number (7–15 digits).");
                isValid = false;
            }

            if (!place) {
                showError(placeInput, "placeError", "Please enter the customer's place.");
                isValid = false;
            }

            if (!isValid) {
                event.preventDefault();
                return;
            }

            nameInput.value = name;
            phoneInput.value = phone;
            placeInput.value = place;

            saveCustomerBtn.disabled = true;
            saveCustomerBtn.textContent = customerForm.dataset.mode === "edit"
                ? "Updating..."
                : "Saving...";
        });

        // Search customers
        customerSearch.addEventListener("input", () => {
            const searchValue = customerSearch.value.trim().toLowerCase();
            const rows = document.querySelectorAll(".customer-row");

            let visibleCount = 0;

            rows.forEach(row => {
                const matches = row.textContent.toLowerCase().includes(searchValue);

                row.style.display = matches ? "" : "none";

                if (matches) {
                    visibleCount++;
                }
            });

            emptyState.style.display = visibleCount === 0 ? "block" : "none";
            customerTableBody.parentElement.style.display =
                visibleCount === 0 ? "none" : "table";
        });

        // Confirm before deleting
        document.querySelectorAll(".delete-form").forEach(form => {
            form.addEventListener("submit", event => {
                const confirmed = confirm(
                    "Are you sure you want to delete this customer?"
                );

                if (!confirmed) {
                    event.preventDefault();
                }
            });
        });

        // Initialize empty state for an empty database
        const initialRows = document.querySelectorAll(".customer-row");

        if (initialRows.length === 0) {
            emptyState.style.display = "block";
            customerTableBody.parentElement.style.display = "none";
        }
    </script>

</body>
</html>


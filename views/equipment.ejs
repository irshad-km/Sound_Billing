<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sound Billing | Equipment</title>
    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* ========================================
           BASE
        ======================================== */
        * {
            box-sizing: border-box;
        }

        :root {
            --primary: #635bff;
            --primary-hover: #5148ed;
            --primary-light: #eeecff;
            --background: #f5f7fb;
            --surface: #ffffff;
            --text-primary: #172033;
            --text-secondary: #475467;
            --text-muted: #667085;
            --border: #e4e7ec;
            --border-light: #eef0f4;
            --success: #15803d;
            --success-bg: #dcfce7;
            --warning: #a16207;
            --warning-bg: #fef3c7;
            --danger: #b42318;
            --danger-bg: #fee4e2;
            --radius: 14px;
            --shadow: 0 4px 18px rgba(23, 32, 51, 0.045);
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            background: var(--background);
            color: var(--text-primary);
            font-family: Inter, Arial, sans-serif;
            font-size: 14px;
            line-height: 1.5;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        button:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid rgba(99, 91, 255, 0.22);
            outline-offset: 2px;
        }

        .app {
            min-height: 100vh;
            width: 100%;
        }

        /* ========================================
           MAIN LAYOUT
        ======================================== */
        .main {
            margin-left: 220px;
            width: calc(100% - 220px);
            min-height: 100vh;
            padding: 22px 24px;
            background: var(--background);
        }

        .page-container {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
        }

        /* ========================================
           HEADER
        ======================================== */
        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 18px;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 750;
            letter-spacing: -0.7px;
            color: var(--text-primary);
        }

        .header p {
            margin: 5px 0 0;
            color: var(--text-muted);
            font-size: 14px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
        }

        .profile strong {
            display: block;
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 700;
        }

        .profile small {
            display: block;
            margin-top: 3px;
            color: var(--text-muted);
            font-size: 12px;
        }

        /* ========================================
           SUMMARY CARDS
        ======================================== */
        .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 14px;
            margin-bottom: 18px;
        }

        .stats .card {
            position: relative;
            min-width: 0;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 16px 18px;
            box-shadow: var(--shadow);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .stats .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(23, 32, 51, 0.07);
        }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 10px;
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 600;
        }

        .stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            border-radius: 12px;
            font-size: 20px;
            flex-shrink: 0;
        }

        .icon-purple {
            background: #eeecff;
        }

        .icon-blue {
            background: #e0f2fe;
        }

        .icon-green {
            background: #dcfce7;
        }

        .icon-orange {
            background: #ffedd5;
        }

        .stats .card h2 {
            margin: 0;
            color: var(--text-primary);
            font-size: 30px;
            line-height: 1.2;
            font-weight: 750;
            letter-spacing: -0.5px;
            overflow-wrap: anywhere;
        }

        .stats .card small {
            display: block;
            margin-top: 5px;
            color: var(--text-muted);
            font-size: 12px;
        }

        /* ========================================
           PANEL
        ======================================== */
        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .panel-header {
            padding: 16px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            border-bottom: 1px solid var(--border-light);
        }

        .panel-heading {
            min-width: 0;
        }

        .panel-header h2 {
            margin: 0;
            font-size: 19px;
            line-height: 1.4;
            font-weight: 750;
            color: var(--text-primary);
        }

        .panel-subtitle {
            margin: 4px 0 0;
            font-size: 13px;
            color: var(--text-muted);
        }

        /* ========================================
           INVENTORY COUNT + CATEGORY FILTER
        ======================================== */
        .inventory-tools {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 9px;
            margin-top: 9px;
        }

        .equipment-count {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 10px;
            border-radius: 7px;
            background: #f2f4f7;
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .count-dot {
            color: var(--primary);
            font-size: 12px;
        }

        .category-filter {
            height: 31px;
            max-width: 190px;
            padding: 0 30px 0 10px;
            border: 1px solid var(--border);
            border-radius: 7px;
            background-color: #ffffff;
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .category-filter:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.1);
        }

        .category-filter:hover {
            border-color: #c7c3ff;
        }

        /* ========================================
           BUTTONS
        ======================================== */
        .primary-btn,
        .cancel-btn,
        .edit-btn,
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 650;
            cursor: pointer;
            text-decoration: none;
            transition: background 0.2s ease, border-color 0.2s ease,
                color 0.2s ease, transform 0.2s ease;
        }

        .primary-btn {
            border: 1px solid var(--primary);
            background: var(--primary);
            color: #ffffff;
            padding: 10px 15px;
            white-space: nowrap;
        }

        .primary-btn:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            transform: translateY(-1px);
        }

        .cancel-btn {
            border: 1px solid var(--border);
            background: #ffffff;
            color: var(--text-secondary);
            padding: 10px 16px;
        }

        .cancel-btn:hover {
            background: #f9fafb;
            border-color: #cbd5e1;
        }

        .edit-btn {
            border: 1px solid #d9d6fe;
            background: #f5f3ff;
            color: #5145cd;
            padding: 7px 11px;
        }

        .edit-btn:hover {
            background: #e9e5ff;
            border-color: #bdb5ff;
        }

        .action-btn {
            border: 1px solid #fecdca;
            background: #fff5f4;
            color: var(--danger);
            padding: 7px 11px;
        }

        .action-btn:hover {
            background: var(--danger-bg);
            border-color: #fda29b;
        }

        .primary-btn:disabled,
        .cancel-btn:disabled,
        .edit-btn:disabled,
        .action-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        /* ========================================
           TABLE
        ======================================== */
        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f8fafc;
        }

        table {
            width: 100%;
            min-width: 1000px;
            border-collapse: separate;
            border-spacing: 0;
        }

        thead {
            background: #f8fafc;
        }

        th {
            padding: 12px 15px;
            text-align: left;
            color: #475467;
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.55px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 12px 15px;
            border-bottom: 1px solid #f0f2f5;
            color: var(--text-secondary);
            font-size: 13px;
            vertical-align: middle;
        }

        tbody tr {
            transition: background 0.15s ease;
        }

        tbody tr:hover {
            background: #fafaff;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        td strong {
            display: inline-block;
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 700;
        }

        .equipment-name {
            display: flex;
            align-items: center;
            gap: 10px;
            min-width: 160px;
        }

        .equipment-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border-radius: 10px;
            background: #f1efff;
            font-size: 18px;
        }

        .equipment-name-text {
            min-width: 0;
        }

        .equipment-name-text strong {
            display: block;
            overflow-wrap: anywhere;
        }

        .equipment-name-text small {
            display: block;
            margin-top: 2px;
            color: var(--text-muted);
            font-size: 12px;
        }

        .quantity-value {
            color: var(--text-primary);
            font-weight: 700;
            font-size: 14px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 58px;
            padding: 5px 9px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status.paid {
            background: var(--success-bg);
            color: var(--success);
        }

        .status.pending {
            background: var(--warning-bg);
            color: var(--warning);
        }

        .status.damaged {
            background: var(--danger-bg);
            color: var(--danger);
        }

        .table-actions {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .table-actions form {
            margin: 0;
        }

        /* ========================================
           EMPTY STATE
        ======================================== */
        .empty-state {
            padding: 35px 20px !important;
            text-align: center;
        }

        .empty-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 56px;
            height: 56px;
            margin: 0 auto 12px;
            border-radius: 16px;
            background: #f1efff;
            font-size: 26px;
        }

        .empty-state strong {
            display: block;
            margin-bottom: 6px;
            font-size: 16px;
            color: var(--text-primary);
        }

        .empty-state p {
            margin: 0;
            color: var(--text-muted);
            font-size: 13px;
        }

        /* ========================================
           MODAL
        ======================================== */
        .modal {
            position: fixed;
            inset: 0;
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15, 23, 42, 0.58);
            backdrop-filter: blur(4px);
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            width: min(680px, 100%);
            max-height: 92vh;
            overflow-y: auto;
            background: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 18px;
            box-shadow: 0 24px 80px rgba(15, 23, 42, 0.25);
            animation: modalEnter 0.2s ease;
        }

        @keyframes modalEnter {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            padding: 20px 22px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            border-bottom: 1px solid var(--border-light);
        }

        .modal-header h2 {
            margin: 0;
            font-size: 21px;
            line-height: 1.4;
            font-weight: 750;
            color: var(--text-primary);
        }

        .modal-header p {
            margin: 5px 0 0;
            color: var(--text-muted);
            font-size: 13px;
        }

        .close-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #ffffff;
            color: var(--text-secondary);
            font-size: 23px;
            line-height: 1;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .close-btn:hover {
            background: var(--primary-light);
            border-color: #d9d6fe;
            color: var(--primary);
        }

        /* ========================================
           FORM
        ======================================== */
        #equipmentForm {
            padding: 20px 22px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 7px;
            min-width: 0;
        }

        .form-group label {
            color: #344054;
            font-size: 13px;
            font-weight: 700;
        }

        .required-mark {
            color: var(--danger);
        }

        .form-group input,
        .form-group select {
            width: 100%;
            height: 43px;
            padding: 0 13px;
            border: 1px solid #d0d5dd;
            border-radius: 9px;
            outline: none;
            background: #ffffff;
            color: var(--text-primary);
            font-size: 14px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-group input::placeholder {
            color: #98a2b3;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.1);
        }

        .form-group input:disabled,
        .form-group select:disabled {
            background: #f2f4f7;
            color: #667085;
            cursor: not-allowed;
        }

        .form-hint {
            margin: 0;
            color: var(--text-muted);
            font-size: 12px;
        }

        .modal-footer {
            margin-top: 20px;
            padding-top: 16px;
            border-top: 1px solid var(--border-light);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        /* ========================================
           DELETE CONFIRMATION MODAL
        ======================================== */
        .delete-confirm-content {
            max-width: 480px;
        }

        .delete-confirm-body {
            display: flex;
            align-items: flex-start;
            gap: 14px;
            padding: 22px;
        }

        .delete-warning-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 46px;
            height: 46px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #fee4e2;
            color: #b42318;
            font-size: 25px;
            font-weight: 800;
        }

        .delete-confirm-message {
            min-width: 0;
        }

        .delete-confirm-message strong {
            display: block;
            color: var(--text-primary);
            font-size: 15px;
            font-weight: 750;
            overflow-wrap: anywhere;
        }

        .delete-confirm-message p {
            margin: 7px 0 0;
            color: var(--text-muted);
            font-size: 13px;
            line-height: 1.7;
        }

        .delete-confirm-footer {
            margin: 0 22px;
            padding: 16px 0 20px;
        }

        .delete-confirm-btn {
            border: 1px solid #b42318;
            background: #b42318;
            color: #ffffff;
            padding: 10px 16px;
        }

        .delete-confirm-btn:hover {
            background: #912018;
            border-color: #912018;
        }

        .delete-confirm-btn:disabled {
            opacity: 0.65;
            cursor: not-allowed;
        }

        /* ========================================
           TOAST MESSAGE
        ======================================== */
        .equipment-toast {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 3000;
            max-width: calc(100% - 32px);
            padding: 14px 18px;
            border-radius: 10px;
            background: #172033;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: 0.2s ease;
        }

        .equipment-toast.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* ========================================
           RESPONSIVE
        ======================================== */
        @media (max-width: 1200px) {
            .main {
                padding: 20px;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .stats .card {
                padding: 16px;
            }
        }

        @media (max-width: 900px) {
            .main {
                margin-left: 0;
                width: 100%;
                padding: 20px 16px;
            }
        }

        @media (max-width: 600px) {
            .main {
                padding: 16px 12px;
            }

            .header {
                align-items: flex-start;
                flex-direction: column;
                gap: 14px;
            }

            .header h1 {
                font-size: 25px;
            }

            .profile {
                align-self: flex-start;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
                margin-bottom: 14px;
            }

            .stats .card {
                padding: 13px;
            }

            .stat-top {
                align-items: flex-start;
                flex-direction: column-reverse;
                gap: 8px;
                margin-bottom: 10px;
            }

            .stat-icon {
                width: 34px;
                height: 34px;
                font-size: 17px;
            }

            .stat-label {
                font-size: 12px;
            }

            .stats .card h2 {
                font-size: 25px;
            }

            .stats .card small {
                font-size: 11px;
            }

            .panel-header {
                align-items: stretch;
                flex-direction: column;
                padding: 16px;
                gap: 13px;
            }

            .inventory-tools {
                gap: 7px;
            }

            .category-filter {
                max-width: 100%;
            }

            .panel-header .primary-btn {
                width: 100%;
            }

            .table-wrapper {
                overflow-x: auto;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 15px;
            }

            .modal {
                padding: 10px;
            }

            .modal-content {
                max-height: 96vh;
                border-radius: 14px;
            }

            .modal-header {
                padding: 17px;
            }

            #equipmentForm {
                padding: 17px;
            }

            .modal-footer {
                gap: 8px;
            }

            .modal-footer button {
                flex: 1;
            }

            .delete-confirm-body {
                padding: 18px;
                gap: 12px;
            }

            .delete-confirm-footer {
                margin: 0 17px;
                padding-bottom: 17px;
            }

            .delete-confirm-footer button {
                flex: 1;
            }

            .equipment-toast {
                right: 16px;
                bottom: 16px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>

<body>
<div class="app">

    <!-- SIDEBAR -->
    <%- include("partials/sidebar") %>

    <!-- MAIN CONTENT -->
    <main class="main">
        <div class="page-container">

            <!-- HEADER -->
            <header class="header">
                <div>
                    <h1>Equipment</h1>
                    <p>Manage your sound equipment inventory and availability.</p>
                </div>

                <div class="profile">
                    <div class="avatar">A</div>
                    <div>
                        <strong>Admin</strong>
                        <small>Administrator</small>
                    </div>
                </div>
            </header>

            <!-- EQUIPMENT SUMMARY -->
            <%
                const equipmentList = Array.isArray(equipments) ? equipments : [];

                const totalEquipmentCount = equipmentList.length;

                const totalQuantityCount = equipmentList.reduce(
                    (sum, item) => sum + Number(item.totalQuantity || 0),
                    0
                );

                const availableQuantityCount = equipmentList.reduce(
                    (sum, item) => sum + Number(item.availableQuantity || 0),
                    0
                );

                const rentedQuantityCount = equipmentList.reduce(
                    (sum, item) => sum + Number(item.rentedQuantity || 0),
                    0
                );

                const equipmentCategories = [
                    ...new Set(
                        equipmentList
                            .map(item => String(item.category || "").trim())
                            .filter(Boolean)
                    )
                ].sort((a, b) => a.localeCompare(b));
            %>

            <section class="stats">

                <div class="card">
                    <div class="stat-top">
                        <span class="stat-label">Total Equipment</span>
                        <div class="stat-icon icon-purple">🔊</div>
                    </div>
                    <h2 id="totalEquipment"><%= totalEquipmentCount %></h2>
                    <small>Different equipment types</small>
                </div>

                <div class="card">
                    <div class="stat-top">
                        <span class="stat-label">Total Quantity</span>
                        <div class="stat-icon icon-blue">📦</div>
                    </div>
                    <h2 id="totalQuantity"><%= totalQuantityCount %></h2>
                    <small>Total units in inventory</small>
                </div>

                <div class="card">
                    <div class="stat-top">
                        <span class="stat-label">Available</span>
                        <div class="stat-icon icon-green">✓</div>
                    </div>
                    <h2 id="availableQuantity"><%= availableQuantityCount %></h2>
                    <small>Units ready for rental</small>
                </div>

                <div class="card">
                    <div class="stat-top">
                        <span class="stat-label">Currently Rented</span>
                        <div class="stat-icon icon-orange">↗</div>
                    </div>
                    <h2 id="rentedQuantity"><%= rentedQuantityCount %></h2>
                    <small>Units currently outside</small>
                </div>

            </section>

            <!-- EQUIPMENT PANEL -->
            <section class="panel">

                <div class="panel-header">
                    <div class="panel-heading">
                        <h2>Equipment Inventory</h2>

                        <p class="panel-subtitle">
                            View, add, edit and manage your equipment.
                        </p>

                        <div class="inventory-tools">
                            <span class="equipment-count">
                                <span class="count-dot">●</span>
                                <span id="equipmentCountText">
                                    <%= totalEquipmentCount %>
                                    equipment type<%= totalEquipmentCount === 1 ? "" : "s" %>
                                </span>
                            </span>

                            <select
                                id="categoryFilter"
                                class="category-filter"
                                aria-label="Filter equipment by category">

                                <option value="all">All Categories</option>

                                <% equipmentCategories.forEach(category => { %>
                                    <option value="<%= category %>">
                                        <%= category %>
                                    </option>
                                <% }); %>

                            </select>
                        </div>
                    </div>

                    <button
                        type="button"
                        class="primary-btn"
                        id="addEquipmentBtn"
                        onclick="openAddEquipment()">
                        <span>＋</span>
                        Add Equipment
                    </button>
                </div>

                <!-- TABLE -->
                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Equipment</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Total</th>
                                <th>Available</th>
                                <th>Rented</th>
                                <th>Rental Price</th>
                                <th>Condition</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody id="equipmentTableBody">

                            <% if (equipmentList.length === 0) { %>
                                <tr id="initialEmptyRow">
                                    <td colspan="9" class="empty-state">
                                        <div class="empty-icon">🔊</div>
                                        <strong>No equipment added yet</strong>
                                        <p>
                                            Add your first equipment to start managing your inventory.
                                        </p>
                                    </td>
                                </tr>
                            <% } %>

                            <% equipmentList.forEach(equipment => { %>
                                <tr
                                    class="equipment-row"
                                    data-category="<%= String(equipment.category || '').trim() %>">

                                    <!-- EQUIPMENT NAME -->
                                    <td>
                                        <div class="equipment-name">
                                            <div class="equipment-icon">🔊</div>

                                            <div class="equipment-name-text">
                                                <strong>
                                                    <%= equipment.name || "Unnamed Equipment" %>
                                                </strong>
                                                <small>
                                                    ID: <%= String(equipment._id).slice(-6).toUpperCase() %>
                                                </small>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- CATEGORY -->
                                    <td><%= equipment.category || "-" %></td>

                                    <!-- BRAND -->
                                    <td><%= equipment.brand || "-" %></td>

                                    <!-- TOTAL -->
                                    <td>
                                        <span class="quantity-value">
                                            <%= Number(equipment.totalQuantity || 0) %>
                                        </span>
                                    </td>

                                    <!-- AVAILABLE -->
                                    <td>
                                        <span class="status paid">
                                            <%= Number(equipment.availableQuantity || 0) %>
                                        </span>
                                    </td>

                                    <!-- RENTED -->
                                    <td>
                                        <span class="status pending">
                                            <%= Number(equipment.rentedQuantity || 0) %>
                                        </span>
                                    </td>

                                    <!-- RENTAL PRICE -->
                                    <td>
                                        <strong>
                                            ₹<%= Number(equipment.rentalPrice || 0).toLocaleString("en-IN") %>
                                        </strong>
                                    </td>

                                    <!-- CONDITION -->
                                    <td>
                                        <% if (equipment.condition === "Good") { %>
                                            <span class="status paid">Good</span>
                                        <% } else if (equipment.condition === "Fair") { %>
                                            <span class="status pending">Fair</span>
                                        <% } else { %>
                                            <span class="status damaged">
                                                <%= equipment.condition || "Damaged" %>
                                            </span>
                                        <% } %>
                                    </td>

                                    <!-- ACTIONS -->
                                    <td>
                                        <div class="table-actions">

                                            <button
                                                type="button"
                                                class="edit-btn js-edit-equipment"
                                                data-id="<%= equipment._id %>"
                                                data-name="<%= equipment.name || '' %>"
                                                data-category="<%= equipment.category || '' %>"
                                                data-brand="<%= equipment.brand || '' %>"
                                                data-quantity="<%= Number(equipment.totalQuantity || 0) %>"
                                                data-purchase-price="<%= Number(equipment.purchasePrice || 0) %>"
                                                data-rental-price="<%= Number(equipment.rentalPrice || 0) %>"
                                                data-condition="<%= equipment.condition || 'Good' %>">
                                                Edit
                                            </button>

                                            <form
                                                action="/equipment/delete/<%= equipment._id %>"
                                                method="POST"
                                                onsubmit="return confirmDeleteEquipment(this)">

                                                <button
                                                    type="submit"
                                                    class="action-btn">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>
                                    </td>
                                </tr>
                            <% }); %>

                            <!-- FILTER EMPTY STATE -->
                            <tr id="filterEmptyRow" style="display: none;">
                                <td colspan="9" class="empty-state">
                                    <div class="empty-icon">🔎</div>
                                    <strong>No equipment in this category</strong>
                                    <p>Select another category to see your equipment.</p>
                                </td>
                            </tr>

                        </tbody>
                    </table>
                </div>
            </section>

        </div>
    </main>
</div>

<!-- ========================================
     EQUIPMENT ADD / EDIT MODAL
======================================== -->
<div
    id="equipmentModal"
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="equipmentModalTitle">

    <div class="modal-content">

        <div class="modal-header">
            <div>
                <h2 id="equipmentModalTitle">Add Equipment</h2>
                <p id="equipmentModalDescription">
                    Enter the equipment details below.
                </p>
            </div>

            <button
                type="button"
                class="close-btn"
                id="closeEquipmentBtn"
                aria-label="Close modal"
                onclick="closeEquipmentModal()">
                ×
            </button>
        </div>

        <form id="equipmentForm" method="POST" action="/equipment/add">

            <div class="form-grid">

                <div class="form-group">
                    <label for="equipmentName">
                        Equipment Name <span class="required-mark">*</span>
                    </label>
                    <input
                        type="text"
                        name="name"
                        id="equipmentName"
                        placeholder="Example: JBL Speaker"
                        maxlength="100"
                        autocomplete="off"
                        required>
                </div>

                <div class="form-group">
                    <label for="equipmentCategory">
                        Category <span class="required-mark">*</span>
                    </label>
                    <select name="category" id="equipmentCategory" required>
                        <option value="">Select category</option>
                        <option value="Speaker">Speaker</option>
                        <option value="Amplifier">Amplifier</option>
                        <option value="Mixer">Mixer</option>
                        <option value="Microphone">Microphone</option>
                        <option value="Stand">Stand</option>
                        <option value="Cable">Cable</option>
                        <option value="Light">Light</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="equipmentBrand">Brand</label>
                    <input
                        type="text"
                        name="brand"
                        id="equipmentBrand"
                        placeholder="Example: JBL"
                        maxlength="100"
                        autocomplete="off">
                </div>

                <div class="form-group">
                    <label for="equipmentQuantity">
                        Total Quantity <span class="required-mark">*</span>
                    </label>
                    <input
                        type="number"
                        name="totalQuantity"
                        id="equipmentQuantity"
                        min="0"
                        step="1"
                        placeholder="Enter total units"
                        required>
                    <p class="form-hint">
                        Enter the total number of units owned.
                    </p>
                </div>

                <div class="form-group">
                    <label for="equipmentPurchasePrice">Purchase Price (₹)</label>
                    <input
                        type="number"
                        name="purchasePrice"
                        id="equipmentPurchasePrice"
                        min="0"
                        step="0.01"
                        placeholder="0.00">
                </div>

                <div class="form-group">
                    <label for="equipmentRentalPrice">
                        Rental Price (₹) <span class="required-mark">*</span>
                    </label>
                    <input
                        type="number"
                        name="rentalPrice"
                        id="equipmentRentalPrice"
                        min="0"
                        step="0.01"
                        placeholder="Enter rental price"
                        required>
                </div>

                <div class="form-group">
                    <label for="equipmentCondition">
                        Equipment Condition <span class="required-mark">*</span>
                    </label>
                    <select name="condition" id="equipmentCondition" required>
                        <option value="Good">Good</option>
                        <option value="Fair">Fair</option>
                        <option value="Damaged">Damaged</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeEquipmentModal()">
                    Cancel
                </button>

                <button
                    type="submit"
                    class="primary-btn"
                    id="equipmentSaveBtn">
                    Save Equipment
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================
     DELETE CONFIRMATION MODAL
======================================== -->
<div
    id="deleteConfirmModal"
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="deleteConfirmTitle">

    <div class="modal-content delete-confirm-content">

        <div class="modal-header">
            <div>
                <h2 id="deleteConfirmTitle">Delete Equipment?</h2>
                <p>Are you sure you want to delete this equipment?</p>
            </div>

            <button
                type="button"
                class="close-btn"
                id="closeDeleteModalBtn"
                aria-label="Close confirmation modal">
                ×
            </button>
        </div>

        <div class="delete-confirm-body">
            <div class="delete-warning-icon">!</div>

            <div class="delete-confirm-message">
                <strong id="deleteEquipmentName">Selected Equipment</strong>
                <p>
                    This action cannot be undone. The equipment will be permanently deleted.
                </p>
            </div>
        </div>

        <div class="modal-footer delete-confirm-footer">
            <button
                type="button"
                class="cancel-btn"
                id="cancelDeleteBtn">
                Cancel
            </button>

            <button
                type="button"
                class="action-btn delete-confirm-btn"
                id="confirmDeleteBtn">
                Delete Equipment
            </button>
        </div>

    </div>
</div>

<!-- TOAST MESSAGE -->
<div
    id="equipmentToast"
    class="equipment-toast"
    role="status"
    aria-live="polite">
</div>

<!-- ========================================
     JAVASCRIPT
======================================== -->
<script>
    "use strict";

    /* ========================================
       ELEMENTS
    ======================================== */
    const equipmentModal = document.getElementById("equipmentModal");
    const equipmentForm = document.getElementById("equipmentForm");
    const equipmentModalTitle = document.getElementById("equipmentModalTitle");
    const equipmentModalDescription = document.getElementById("equipmentModalDescription");
    const equipmentSaveBtn = document.getElementById("equipmentSaveBtn");

    const equipmentName = document.getElementById("equipmentName");
    const equipmentCategory = document.getElementById("equipmentCategory");
    const equipmentBrand = document.getElementById("equipmentBrand");
    const equipmentQuantity = document.getElementById("equipmentQuantity");
    const equipmentPurchasePrice = document.getElementById("equipmentPurchasePrice");
    const equipmentRentalPrice = document.getElementById("equipmentRentalPrice");
    const equipmentCondition = document.getElementById("equipmentCondition");

    const equipmentToast = document.getElementById("equipmentToast");
    const categoryFilter = document.getElementById("categoryFilter");
    const equipmentCountText = document.getElementById("equipmentCountText");
    const filterEmptyRow = document.getElementById("filterEmptyRow");

    const equipmentRows = Array.from(
        document.querySelectorAll(".equipment-row")
    );

    /* DELETE MODAL ELEMENTS */
    const deleteConfirmModal = document.getElementById("deleteConfirmModal");
    const deleteEquipmentName = document.getElementById("deleteEquipmentName");
    const confirmDeleteBtn = document.getElementById("confirmDeleteBtn");
    const cancelDeleteBtn = document.getElementById("cancelDeleteBtn");
    const closeDeleteModalBtn = document.getElementById("closeDeleteModalBtn");

    let previousFocusedElement = null;
    let deletePreviousFocusedElement = null;
    let pendingDeleteForm = null;
    let toastTimeout = null;

    /* ========================================
       CATEGORY FILTER
    ======================================== */
    function filterEquipment() {
        const selectedCategory = categoryFilter.value;
        let visibleCount = 0;

        equipmentRows.forEach(row => {
            const rowCategory = (row.dataset.category || "").trim().toLowerCase();
            const selected = selectedCategory.trim().toLowerCase();

            const isVisible =
                selectedCategory === "all" ||
                rowCategory === selected;

            row.style.display = isVisible ? "" : "none";

            if (isVisible) {
                visibleCount++;
            }
        });

        equipmentCountText.textContent =
            visibleCount + " equipment type" +
            (visibleCount === 1 ? "" : "s");

        filterEmptyRow.style.display =
            equipmentRows.length > 0 && visibleCount === 0
                ? ""
                : "none";
    }

    categoryFilter.addEventListener("change", filterEquipment);

    /* ========================================
       TOAST
    ======================================== */
    function showEquipmentToast(message) {
        equipmentToast.textContent = message;
        equipmentToast.classList.add("show");

        clearTimeout(toastTimeout);

        toastTimeout = setTimeout(() => {
            equipmentToast.classList.remove("show");
        }, 3000);
    }

    /* ========================================
       OPEN EQUIPMENT MODAL
    ======================================== */
    function showEquipmentModal() {
        previousFocusedElement = document.activeElement;

        equipmentModal.classList.add("show");
        document.body.style.overflow = "hidden";

        setTimeout(() => {
            equipmentName.focus();
        }, 100);
    }

    /* ========================================
       ADD EQUIPMENT
    ======================================== */
    function openAddEquipment() {
        equipmentForm.reset();
        equipmentForm.action = "/equipment/add";

        equipmentModalTitle.textContent = "Add Equipment";
        equipmentModalDescription.textContent =
            "Enter the equipment details below.";

        equipmentSaveBtn.textContent = "Save Equipment";
        equipmentSaveBtn.disabled = false;
        equipmentCondition.value = "Good";

        showEquipmentModal();
    }

    /* ========================================
       EDIT EQUIPMENT
    ======================================== */
    function openEditEquipment(
        id,
        name,
        category,
        brand,
        quantity,
        purchasePrice,
        rentalPrice,
        condition
    ) {
        equipmentForm.reset();

        equipmentForm.action =
            "/equipment/edit/" + encodeURIComponent(id);

        equipmentModalTitle.textContent = "Edit Equipment";
        equipmentModalDescription.textContent =
            "Update the details of this equipment.";

        equipmentSaveBtn.textContent = "Update Equipment";
        equipmentSaveBtn.disabled = false;

        equipmentName.value = name || "";
        equipmentCategory.value = category || "";

        /*
         * Preserve existing categories that are not in the predefined options.
         */
        if (
            category &&
            !Array.from(equipmentCategory.options)
                .some(option => option.value === category)
        ) {
            const option = document.createElement("option");
            option.value = category;
            option.textContent = category;
            equipmentCategory.appendChild(option);
        }

        equipmentCategory.value = category || "";
        equipmentBrand.value = brand || "";
        equipmentQuantity.value = Number(quantity || 0);
        equipmentPurchasePrice.value = Number(purchasePrice || 0);
        equipmentRentalPrice.value = Number(rentalPrice || 0);
        equipmentCondition.value = condition || "Good";

        showEquipmentModal();
    }

    /* ========================================
       EDIT BUTTON EVENTS
    ======================================== */
    document.querySelectorAll(".js-edit-equipment").forEach(button => {
        button.addEventListener("click", () => {
            openEditEquipment(
                button.dataset.id,
                button.dataset.name,
                button.dataset.category,
                button.dataset.brand,
                button.dataset.quantity,
                button.dataset.purchasePrice,
                button.dataset.rentalPrice,
                button.dataset.condition
            );
        });
    });

    /* ========================================
       CLOSE EQUIPMENT MODAL
    ======================================== */
    function closeEquipmentModal() {
        equipmentModal.classList.remove("show");
        document.body.style.overflow = "";

        if (
            previousFocusedElement &&
            typeof previousFocusedElement.focus === "function"
        ) {
            previousFocusedElement.focus();
        }
    }

    equipmentModal.addEventListener("click", event => {
        if (event.target === equipmentModal) {
            closeEquipmentModal();
        }
    });

    /* ========================================
       DELETE CONFIRMATION MODAL
    ======================================== */
    function confirmDeleteEquipment(form) {
        pendingDeleteForm = form;
        deletePreviousFocusedElement = document.activeElement;

        const row = form.closest("tr");

        const equipmentNameElement = row
            ? row.querySelector(".equipment-name-text strong")
            : null;

        const name = equipmentNameElement
            ? equipmentNameElement.textContent.trim()
            : "Selected Equipment";

        deleteEquipmentName.textContent = name;

        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = "Delete Equipment";

        deleteConfirmModal.classList.add("show");
        document.body.style.overflow = "hidden";

        setTimeout(() => {
            cancelDeleteBtn.focus();
        }, 50);

        // Stop the original form from submitting until confirmation.
        return false;
    }

    function closeDeleteConfirmation() {
        deleteConfirmModal.classList.remove("show");
        document.body.style.overflow = "";

        pendingDeleteForm = null;

        confirmDeleteBtn.disabled = false;
        confirmDeleteBtn.textContent = "Delete Equipment";

        if (
            deletePreviousFocusedElement &&
            typeof deletePreviousFocusedElement.focus === "function"
        ) {
            deletePreviousFocusedElement.focus();
        }
    }

    cancelDeleteBtn.addEventListener("click", () => {
        closeDeleteConfirmation();
    });

    closeDeleteModalBtn.addEventListener("click", () => {
        closeDeleteConfirmation();
    });

    deleteConfirmModal.addEventListener("click", event => {
        if (event.target === deleteConfirmModal) {
            closeDeleteConfirmation();
        }
    });

    /* ========================================
       CONFIRM DELETE
    ======================================== */
    confirmDeleteBtn.addEventListener("click", () => {
        if (!pendingDeleteForm) {
            return;
        }

        const formToDelete = pendingDeleteForm;

        confirmDeleteBtn.disabled = true;
        confirmDeleteBtn.textContent = "Deleting...";

        const submitButton = formToDelete.querySelector(
            'button[type="submit"]'
        );

        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = "Deleting...";
        }

        // Submit the existing delete form and use the existing backend route.
        formToDelete.submit();
    });

    /* ========================================
       ESCAPE KEY
    ======================================== */
    window.addEventListener("keydown", event => {
        if (
            event.key === "Escape" &&
            deleteConfirmModal.classList.contains("show")
        ) {
            closeDeleteConfirmation();
            return;
        }

        if (
            event.key === "Escape" &&
            equipmentModal.classList.contains("show")
        ) {
            closeEquipmentModal();
        }
    });

    /* ========================================
       FORM VALIDATION
    ======================================== */
    equipmentForm.addEventListener("submit", event => {
        const name = equipmentName.value.trim();
        const quantity = Number(equipmentQuantity.value);
        const purchasePrice = equipmentPurchasePrice.value;
        const rentalPrice = equipmentRentalPrice.value;

        if (!name) {
            event.preventDefault();
            equipmentName.focus();
            showEquipmentToast("Please enter the equipment name.");
            return;
        }

        if (
            equipmentQuantity.value === "" ||
            !Number.isInteger(quantity) ||
            quantity < 0
        ) {
            event.preventDefault();
            equipmentQuantity.focus();
            showEquipmentToast(
                "Please enter a valid whole-number quantity."
            );
            return;
        }

        if (
            purchasePrice !== "" &&
            (
                !Number.isFinite(Number(purchasePrice)) ||
                Number(purchasePrice) < 0
            )
        ) {
            event.preventDefault();
            equipmentPurchasePrice.focus();
            showEquipmentToast("Purchase price cannot be negative.");
            return;
        }

        if (
            rentalPrice === "" ||
            !Number.isFinite(Number(rentalPrice)) ||
            Number(rentalPrice) < 0
        ) {
            event.preventDefault();
            equipmentRentalPrice.focus();
            showEquipmentToast("Please enter a valid rental price.");
            return;
        }

        equipmentName.value = name;

        equipmentSaveBtn.disabled = true;

        equipmentSaveBtn.textContent =
            equipmentForm.action.endsWith("/add")
                ? "Saving..."
                : "Updating...";
    });

    /* ========================================
       RESET BUTTONS WHEN PAGE IS RESTORED
    ======================================== */
    window.addEventListener("pageshow", () => {
        equipmentSaveBtn.disabled = false;

        equipmentSaveBtn.textContent =
            equipmentForm.action.endsWith("/add")
                ? "Save Equipment"
                : "Update Equipment";

        document.querySelectorAll(
            '.table-actions form button[type="submit"]'
        ).forEach(button => {
            button.disabled = false;
            button.textContent = "Delete";
        });
    });
</script>

</body>
</html>
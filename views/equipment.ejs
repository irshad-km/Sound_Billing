<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sound Billing | Equipment</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        /* ========================================
           BASE
        ======================================== */

        * {
            box-sizing: border-box;
        }

        :root {
            --primary: #635bff;
            --primary-hover: #5148ed;
            --primary-light: #eeecff;

            --background: #f5f7fb;
            --surface: #ffffff;

            --text-primary: #172033;
            --text-secondary: #475467;
            --text-muted: #667085;

            --border: #e4e7ec;
            --border-light: #eef0f4;

            --success: #15803d;
            --success-bg: #dcfce7;

            --warning: #a16207;
            --warning-bg: #fef3c7;

            --danger: #b42318;
            --danger-bg: #fee4e2;

            --radius: 14px;

            --shadow:
                0 4px 18px rgba(23, 32, 51, 0.045);
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            background: var(--background);
            color: var(--text-primary);
            font-family: Inter, Arial, sans-serif;
            font-size: 14px;
            line-height: 1.5;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        button:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid rgba(99, 91, 255, 0.22);
            outline-offset: 2px;
        }

        .app {
            min-height: 100vh;
            width: 100%;
        }

        /* ========================================
           MAIN LAYOUT
        ======================================== */

        .main {
            margin-left: 220px;
            width: calc(100% - 220px);
            min-height: 100vh;
            padding: 30px;
            background: var(--background);
        }

        .page-container {
            width: 100%;
            max-width: 1600px;
            margin: 0 auto;
        }

        /* ========================================
           HEADER
        ======================================== */

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .header h1 {
            margin: 0;
            font-size: 28px;
            font-weight: 750;
            letter-spacing: -0.7px;
            color: var(--text-primary);
        }

        .header p {
            margin: 7px 0 0;
            color: var(--text-muted);
            font-size: 14px;
        }

        .profile {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-shrink: 0;
        }

        .avatar {
            width: 44px;
            height: 44px;
            border-radius: 12px;
            background: var(--primary-light);
            color: var(--primary);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            font-size: 16px;
        }

        .profile strong {
            display: block;
            color: var(--text-primary);
            font-size: 14px;
            font-weight: 700;
        }

        .profile small {
            display: block;
            margin-top: 3px;
            color: var(--text-muted);
            font-size: 12px;
        }

        /* ========================================
           SUMMARY CARDS
        ======================================== */

        .stats {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 24px;
        }

        .stats .card {
            position: relative;
            min-width: 0;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 22px;
            box-shadow: var(--shadow);
            transition:
                transform 0.2s ease,
                box-shadow 0.2s ease;
        }

        .stats .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(23, 32, 51, 0.07);
        }

        .stat-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 16px;
        }

        .stat-label {
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 600;
        }

        .stat-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            border-radius: 12px;
            font-size: 20px;
            flex-shrink: 0;
        }

        .icon-purple {
            background: #eeecff;
        }

        .icon-blue {
            background: #e0f2fe;
        }

        .icon-green {
            background: #dcfce7;
        }

        .icon-orange {
            background: #ffedd5;
        }

        .stats .card h2 {
            margin: 0;
            color: var(--text-primary);
            font-size: 30px;
            line-height: 1.2;
            font-weight: 750;
            letter-spacing: -0.5px;
            overflow-wrap: anywhere;
        }

        .stats .card small {
            display: block;
            margin-top: 9px;
            color: var(--text-muted);
            font-size: 12px;
        }

        /* ========================================
           PANEL
        ======================================== */

        .panel {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .panel-header {
            padding: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            border-bottom: 1px solid var(--border-light);
        }

        .panel-header h2 {
            margin: 0;
            font-size: 19px;
            line-height: 1.4;
            font-weight: 750;
            color: var(--text-primary);
        }

        .panel-subtitle {
            margin: 6px 0 0;
            font-size: 13px;
            color: var(--text-muted);
        }

        .equipment-count {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin-top: 12px;
            padding: 5px 10px;
            border-radius: 7px;
            background: #f2f4f7;
            color: var(--text-secondary);
            font-size: 12px;
            font-weight: 600;
        }

        /* ========================================
           BUTTONS
        ======================================== */

        .primary-btn,
        .cancel-btn,
        .edit-btn,
        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 7px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 650;
            cursor: pointer;
            text-decoration: none;
            transition:
                background 0.2s ease,
                border-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .primary-btn {
            border: 1px solid var(--primary);
            background: var(--primary);
            color: #ffffff;
            padding: 11px 17px;
            white-space: nowrap;
        }

        .primary-btn:hover {
            background: var(--primary-hover);
            border-color: var(--primary-hover);
            transform: translateY(-1px);
        }

        .cancel-btn {
            border: 1px solid var(--border);
            background: #ffffff;
            color: var(--text-secondary);
            padding: 10px 16px;
        }

        .cancel-btn:hover {
            background: #f9fafb;
            border-color: #cbd5e1;
        }

        .edit-btn {
            border: 1px solid #d9d6fe;
            background: #f5f3ff;
            color: #5145cd;
            padding: 8px 12px;
        }

        .edit-btn:hover {
            background: #e9e5ff;
            border-color: #bdb5ff;
        }

        .action-btn {
            border: 1px solid #fecdca;
            background: #fff5f4;
            color: var(--danger);
            padding: 8px 12px;
        }

        .action-btn:hover {
            background: var(--danger-bg);
            border-color: #fda29b;
        }

        .primary-btn:disabled,
        .cancel-btn:disabled,
        .edit-btn:disabled,
        .action-btn:disabled {
            opacity: 0.55;
            cursor: not-allowed;
            transform: none;
        }

        /* ========================================
           TABLE
        ======================================== */

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 #f8fafc;
        }

        table {
            width: 100%;
            min-width: 1000px;
            border-collapse: separate;
            border-spacing: 0;
        }

        thead {
            background: #f8fafc;
        }

        th {
            padding: 15px 18px;
            text-align: left;
            color: #475467;
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.55px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 17px 18px;
            border-bottom: 1px solid #f0f2f5;
            color: var(--text-secondary);
            font-size: 13px;
            vertical-align: middle;
        }

        tbody tr {
            transition: background 0.15s ease;
        }

        tbody tr:hover {
            background: #fafaff;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        td strong {
            display: inline-block;
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 700;
        }

        .equipment-name {
            display: flex;
            align-items: center;
            gap: 11px;
            min-width: 160px;
        }

        .equipment-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            border-radius: 10px;
            background: #f1efff;
            font-size: 18px;
        }

        .equipment-name-text {
            min-width: 0;
        }

        .equipment-name-text strong {
            display: block;
            overflow-wrap: anywhere;
        }

        .equipment-name-text small {
            display: block;
            margin-top: 3px;
            color: var(--text-muted);
            font-size: 12px;
        }

        .quantity-value {
            color: var(--text-primary);
            font-weight: 700;
            font-size: 14px;
        }

        .status {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 58px;
            padding: 6px 10px;
            border-radius: 7px;
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .status.paid {
            background: var(--success-bg);
            color: var(--success);
        }

        .status.pending {
            background: var(--warning-bg);
            color: var(--warning);
        }

        .status.damaged {
            background: var(--danger-bg);
            color: var(--danger);
        }

        .table-actions {
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .table-actions form {
            margin: 0;
        }

        /* ========================================
           EMPTY STATE
        ======================================== */

        .empty-state {
            padding: 55px 24px !important;
            text-align: center;
        }

        .empty-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 64px;
            height: 64px;
            margin: 0 auto 16px;
            border-radius: 18px;
            background: #f1efff;
            font-size: 28px;
        }

        .empty-state strong {
            display: block;
            margin-bottom: 7px;
            font-size: 16px;
            color: var(--text-primary);
        }

        .empty-state p {
            margin: 0;
            color: var(--text-muted);
            font-size: 13px;
        }

        /* ========================================
           MODAL
        ======================================== */

        .modal {
            position: fixed;
            inset: 0;
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15, 23, 42, 0.58);
            backdrop-filter: blur(4px);
        }

        .modal.show {
            display: flex;
        }

        .modal-content {
            width: min(680px, 100%);
            max-height: 92vh;
            overflow-y: auto;
            background: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 18px;
            box-shadow: 0 24px 80px rgba(15, 23, 42, 0.25);
            animation: modalEnter 0.2s ease;
        }

        @keyframes modalEnter {
            from {
                opacity: 0;
                transform: translateY(10px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            padding: 24px;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 16px;
            border-bottom: 1px solid var(--border-light);
        }

        .modal-header h2 {
            margin: 0;
            font-size: 21px;
            line-height: 1.4;
            font-weight: 750;
            color: var(--text-primary);
        }

        .modal-header p {
            margin: 6px 0 0;
            color: var(--text-muted);
            font-size: 13px;
        }

        .close-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #ffffff;
            color: var(--text-secondary);
            font-size: 23px;
            line-height: 1;
            cursor: pointer;
            transition: 0.2s ease;
        }

        .close-btn:hover {
            background: var(--primary-light);
            border-color: #d9d6fe;
            color: var(--primary);
        }

        /* ========================================
           FORM
        ======================================== */

        #equipmentForm {
            padding: 24px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
            min-width: 0;
        }

        .form-group label {
            color: #344054;
            font-size: 13px;
            font-weight: 700;
        }

        .required-mark {
            color: var(--danger);
        }

        .form-group input,
        .form-group select {
            width: 100%;
            height: 45px;
            padding: 0 13px;
            border: 1px solid #d0d5dd;
            border-radius: 9px;
            outline: none;
            background: #ffffff;
            color: var(--text-primary);
            font-size: 14px;
            transition:
                border-color 0.2s ease,
                box-shadow 0.2s ease;
        }

        .form-group input::placeholder {
            color: #98a2b3;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 4px rgba(99, 91, 255, 0.1);
        }

        .form-group input:disabled,
        .form-group select:disabled {
            background: #f2f4f7;
            color: #667085;
            cursor: not-allowed;
        }

        .form-hint {
            margin: 0;
            color: var(--text-muted);
            font-size: 12px;
        }

        .modal-footer {
            margin-top: 26px;
            padding-top: 20px;
            border-top: 1px solid var(--border-light);
            display: flex;
            justify-content: flex-end;
            gap: 10px;
        }

        /* ========================================
           TOAST MESSAGE
        ======================================== */

        .equipment-toast {
            position: fixed;
            right: 24px;
            bottom: 24px;
            z-index: 3000;
            max-width: calc(100% - 32px);
            padding: 14px 18px;
            border-radius: 10px;
            background: #172033;
            color: #ffffff;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 8px 28px rgba(0, 0, 0, 0.18);
            opacity: 0;
            visibility: hidden;
            transform: translateY(8px);
            transition: 0.2s ease;
        }

        .equipment-toast.show {
            opacity: 1;
            visibility: visible;
            transform: translateY(0);
        }

        /* ========================================
           RESPONSIVE
        ======================================== */

        @media (max-width: 1200px) {
            .main {
                padding: 25px 22px;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .stats .card {
                padding: 20px;
            }
        }

        @media (max-width: 900px) {
            .main {
                margin-left: 0;
                width: 100%;
                padding: 24px 18px;
            }
        }

        @media (max-width: 600px) {
            .main {
                padding: 18px 12px;
            }

            .header {
                align-items: flex-start;
                flex-direction: column;
                gap: 18px;
            }

            .header h1 {
                font-size: 25px;
            }

            .profile {
                align-self: flex-start;
            }

            .stats {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 12px;
            }

            .stats .card {
                padding: 15px;
            }

            .stat-top {
                align-items: flex-start;
                flex-direction: column-reverse;
                gap: 10px;
                margin-bottom: 12px;
            }

            .stat-icon {
                width: 36px;
                height: 36px;
                font-size: 17px;
            }

            .stat-label {
                font-size: 12px;
            }

            .stats .card h2 {
                font-size: 25px;
            }

            .stats .card small {
                font-size: 11px;
            }

            .panel-header {
                align-items: stretch;
                flex-direction: column;
                padding: 19px 16px;
                gap: 16px;
            }

            .panel-header .primary-btn {
                width: 100%;
            }

            .table-wrapper {
                overflow-x: auto;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 17px;
            }

            .modal {
                padding: 10px;
            }

            .modal-content {
                max-height: 96vh;
                border-radius: 14px;
            }

            .modal-header {
                padding: 19px;
            }

            #equipmentForm {
                padding: 19px;
            }

            .modal-footer {
                gap: 8px;
            }

            .modal-footer button {
                flex: 1;
            }

            .equipment-toast {
                right: 16px;
                bottom: 16px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <!-- SIDEBAR -->
    <%- include("partials/sidebar") %>

    <!-- MAIN CONTENT -->
    <main class="main">

        <div class="page-container">

            <!-- HEADER -->
            <header class="header">

                <div>
                    <h1>Equipment</h1>
                    <p>
                        Manage your sound equipment inventory and availability.
                    </p>
                </div>

                <div class="profile">

                    <div class="avatar">A</div>

                    <div>
                        <strong>Admin</strong>
                        <small>Administrator</small>
                    </div>

                </div>

            </header>

            <!-- EQUIPMENT SUMMARY -->
            <%
                const equipmentList = Array.isArray(equipments) ? equipments : [];

                const totalEquipmentCount = equipmentList.length;

                const totalQuantityCount = equipmentList.reduce(
                    (sum, item) => sum + Number(item.totalQuantity || 0),
                    0
                );

                const availableQuantityCount = equipmentList.reduce(
                    (sum, item) => sum + Number(item.availableQuantity || 0),
                    0
                );

                const rentedQuantityCount = equipmentList.reduce(
                    (sum, item) => sum + Number(item.rentedQuantity || 0),
                    0
                );
            %>

            <section class="stats">

                <!-- Total Equipment -->
                <div class="card">

                    <div class="stat-top">
                        <span class="stat-label">Total Equipment</span>
                        <div class="stat-icon icon-purple">🔊</div>
                    </div>

                    <h2 id="totalEquipment">
                        <%= totalEquipmentCount %>
                    </h2>

                    <small>Different equipment types</small>

                </div>

                <!-- Total Quantity -->
                <div class="card">

                    <div class="stat-top">
                        <span class="stat-label">Total Quantity</span>
                        <div class="stat-icon icon-blue">📦</div>
                    </div>

                    <h2 id="totalQuantity">
                        <%= totalQuantityCount %>
                    </h2>

                    <small>Total units in inventory</small>

                </div>

                <!-- Available -->
                <div class="card">

                    <div class="stat-top">
                        <span class="stat-label">Available</span>
                        <div class="stat-icon icon-green">✓</div>
                    </div>

                    <h2 id="availableQuantity">
                        <%= availableQuantityCount %>
                    </h2>

                    <small>Units ready for rental</small>

                </div>

                <!-- Currently Rented -->
                <div class="card">

                    <div class="stat-top">
                        <span class="stat-label">Currently Rented</span>
                        <div class="stat-icon icon-orange">↗</div>
                    </div>

                    <h2 id="rentedQuantity">
                        <%= rentedQuantityCount %>
                    </h2>

                    <small>Units currently outside</small>

                </div>

            </section>

            <!-- EQUIPMENT PANEL -->
            <section class="panel">

                <div class="panel-header">

                    <div>
                        <h2>Equipment Inventory</h2>

                        <p class="panel-subtitle">
                            View, add, edit and manage your equipment.
                        </p>

                        <span class="equipment-count">
                            <span>●</span>
                            <span>
                                <%= totalEquipmentCount %>
                                equipment type<%= totalEquipmentCount === 1 ? "" : "s" %>
                            </span>
                        </span>
                    </div>

                    <button
                        type="button"
                        class="primary-btn"
                        id="addEquipmentBtn"
                        onclick="openAddEquipment()">

                        <span>＋</span>
                        Add Equipment

                    </button>

                </div>

                <!-- TABLE -->
                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Equipment</th>
                                <th>Category</th>
                                <th>Brand</th>
                                <th>Total</th>
                                <th>Available</th>
                                <th>Rented</th>
                                <th>Rental Price</th>
                                <th>Condition</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (equipmentList.length === 0) { %>

                                <tr>
                                    <td colspan="9" class="empty-state">

                                        <div class="empty-icon">🔊</div>

                                        <strong>No equipment added yet</strong>

                                        <p>
                                            Add your first equipment to start managing your inventory.
                                        </p>

                                    </td>
                                </tr>

                            <% } %>

                            <% equipmentList.forEach(equipment => { %>

                                <tr>

                                    <!-- EQUIPMENT NAME -->
                                    <td>

                                        <div class="equipment-name">

                                            <div class="equipment-icon">
                                                🔊
                                            </div>

                                            <div class="equipment-name-text">

                                                <strong>
                                                    <%= equipment.name || "Unnamed Equipment" %>
                                                </strong>

                                                <small>
                                                    ID: <%= String(equipment._id).slice(-6).toUpperCase() %>
                                                </small>

                                            </div>

                                        </div>

                                    </td>

                                    <!-- CATEGORY -->
                                    <td>
                                        <%= equipment.category || "-" %>
                                    </td>

                                    <!-- BRAND -->
                                    <td>
                                        <%= equipment.brand || "-" %>
                                    </td>

                                    <!-- TOTAL -->
                                    <td>
                                        <span class="quantity-value">
                                            <%= Number(equipment.totalQuantity || 0) %>
                                        </span>
                                    </td>

                                    <!-- AVAILABLE -->
                                    <td>

                                        <span class="status paid">
                                            <%= Number(equipment.availableQuantity || 0) %>
                                        </span>

                                    </td>

                                    <!-- RENTED -->
                                    <td>

                                        <span class="status pending">
                                            <%= Number(equipment.rentedQuantity || 0) %>
                                        </span>

                                    </td>

                                    <!-- RENTAL PRICE -->
                                    <td>
                                        <strong>
                                            ₹<%= Number(equipment.rentalPrice || 0).toLocaleString("en-IN") %>
                                        </strong>
                                    </td>

                                    <!-- CONDITION -->
                                    <td>

                                        <% if (equipment.condition === "Good") { %>

                                            <span class="status paid">
                                                Good
                                            </span>

                                        <% } else if (equipment.condition === "Fair") { %>

                                            <span class="status pending">
                                                Fair
                                            </span>

                                        <% } else { %>

                                            <span class="status damaged">
                                                <%= equipment.condition || "Damaged" %>
                                            </span>

                                        <% } %>

                                    </td>

                                    <!-- ACTIONS -->
                                    <td>

                                        <div class="table-actions">

                                            <button
                                                type="button"
                                                class="edit-btn js-edit-equipment"
                                                data-id="<%= equipment._id %>"
                                                data-name="<%= equipment.name || '' %>"
                                                data-category="<%= equipment.category || '' %>"
                                                data-brand="<%= equipment.brand || '' %>"
                                                data-quantity="<%= Number(equipment.totalQuantity || 0) %>"
                                                data-purchase-price="<%= Number(equipment.purchasePrice || 0) %>"
                                                data-rental-price="<%= Number(equipment.rentalPrice || 0) %>"
                                                data-condition="<%= equipment.condition || 'Good' %>">

                                                Edit

                                            </button>

                                            <form
                                                action="/equipment/delete/<%= equipment._id %>"
                                                method="POST"
                                                onsubmit="return confirmDeleteEquipment(this)">

                                                <button
                                                    type="submit"
                                                    class="action-btn">

                                                    Delete

                                                </button>

                                            </form>

                                        </div>

                                    </td>

                                </tr>

                            <% }); %>

                        </tbody>

                    </table>

                </div>

            </section>

        </div>

    </main>

</div>


<!-- ========================================
     EQUIPMENT MODAL
======================================== -->

<div
    id="equipmentModal"
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="equipmentModalTitle">

    <div class="modal-content">

        <!-- MODAL HEADER -->
        <div class="modal-header">

            <div>
                <h2 id="equipmentModalTitle">
                    Add Equipment
                </h2>

                <p id="equipmentModalDescription">
                    Enter the equipment details below.
                </p>
            </div>

            <button
                type="button"
                class="close-btn"
                id="closeEquipmentBtn"
                aria-label="Close modal"
                onclick="closeEquipmentModal()">

                ×

            </button>

        </div>

        <!-- FORM -->
        <form
            id="equipmentForm"
            method="POST"
            action="/equipment/add">

            <div class="form-grid">

                <!-- EQUIPMENT NAME -->
                <div class="form-group">

                    <label for="equipmentName">
                        Equipment Name <span class="required-mark">*</span>
                    </label>

                    <input
                        type="text"
                        name="name"
                        id="equipmentName"
                        placeholder="Example: JBL Speaker"
                        maxlength="100"
                        autocomplete="off"
                        required>

                </div>

                <!-- CATEGORY -->
                <div class="form-group">

                    <label for="equipmentCategory">
                        Category <span class="required-mark">*</span>
                    </label>

                    <select
                        name="category"
                        id="equipmentCategory"
                        required>

                        <option value="">Select category</option>
                        <option value="Speaker">Speaker</option>
                        <option value="Amplifier">Amplifier</option>
                        <option value="Mixer">Mixer</option>
                        <option value="Microphone">Microphone</option>
                        <option value="Stand">Stand</option>
                        <option value="Cable">Cable</option>
                        <option value="Light">Light</option>
                        <option value="Other">Other</option>

                    </select>

                </div>

                <!-- BRAND -->
                <div class="form-group">

                    <label for="equipmentBrand">
                        Brand
                    </label>

                    <input
                        type="text"
                        name="brand"
                        id="equipmentBrand"
                        placeholder="Example: JBL"
                        maxlength="100"
                        autocomplete="off">

                </div>

                <!-- QUANTITY -->
                <div class="form-group">

                    <label for="equipmentQuantity">
                        Total Quantity <span class="required-mark">*</span>
                    </label>

                    <input
                        type="number"
                        name="totalQuantity"
                        id="equipmentQuantity"
                        min="0"
                        step="1"
                        placeholder="Enter total units"
                        required>

                    <p class="form-hint">
                        Enter the total number of units owned.
                    </p>

                </div>

                <!-- PURCHASE PRICE -->
                <div class="form-group">

                    <label for="equipmentPurchasePrice">
                        Purchase Price (₹)
                    </label>

                    <input
                        type="number"
                        name="purchasePrice"
                        id="equipmentPurchasePrice"
                        min="0"
                        step="0.01"
                        placeholder="0.00">

                </div>

                <!-- RENTAL PRICE -->
                <div class="form-group">

                    <label for="equipmentRentalPrice">
                        Rental Price (₹) <span class="required-mark">*</span>
                    </label>

                    <input
                        type="number"
                        name="rentalPrice"
                        id="equipmentRentalPrice"
                        min="0"
                        step="0.01"
                        placeholder="Enter rental price"
                        required>

                </div>

                <!-- CONDITION -->
                <div class="form-group">

                    <label for="equipmentCondition">
                        Equipment Condition <span class="required-mark">*</span>
                    </label>

                    <select
                        name="condition"
                        id="equipmentCondition"
                        required>

                        <option value="Good">Good</option>
                        <option value="Fair">Fair</option>
                        <option value="Damaged">Damaged</option>

                    </select>

                </div>

            </div>

            <!-- MODAL FOOTER -->
            <div class="modal-footer">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeEquipmentModal()">

                    Cancel

                </button>

                <button
                    type="submit"
                    class="primary-btn"
                    id="equipmentSaveBtn">

                    Save Equipment

                </button>

            </div>

        </form>

    </div>

</div>

<!-- TOAST MESSAGE -->
<div
    id="equipmentToast"
    class="equipment-toast"
    role="status"
    aria-live="polite">
</div>


<!-- ========================================
     JAVASCRIPT
======================================== -->

<script>
    "use strict";

    /* ========================================
       ELEMENTS
    ======================================== */

    const equipmentModal = document.getElementById("equipmentModal");

    const equipmentForm = document.getElementById("equipmentForm");

    const equipmentModalTitle =
        document.getElementById("equipmentModalTitle");

    const equipmentModalDescription =
        document.getElementById("equipmentModalDescription");

    const equipmentSaveBtn =
        document.getElementById("equipmentSaveBtn");

    const equipmentName =
        document.getElementById("equipmentName");

    const equipmentCategory =
        document.getElementById("equipmentCategory");

    const equipmentBrand =
        document.getElementById("equipmentBrand");

    const equipmentQuantity =
        document.getElementById("equipmentQuantity");

    const equipmentPurchasePrice =
        document.getElementById("equipmentPurchasePrice");

    const equipmentRentalPrice =
        document.getElementById("equipmentRentalPrice");

    const equipmentCondition =
        document.getElementById("equipmentCondition");

    const equipmentToast =
        document.getElementById("equipmentToast");

    let previousFocusedElement = null;
    let toastTimeout = null;

    /* ========================================
       TOAST
    ======================================== */

    function showEquipmentToast(message) {
        equipmentToast.textContent = message;
        equipmentToast.classList.add("show");

        clearTimeout(toastTimeout);

        toastTimeout = setTimeout(() => {
            equipmentToast.classList.remove("show");
        }, 3000);
    }

    /* ========================================
       OPEN MODAL
    ======================================== */

    function showEquipmentModal() {
        previousFocusedElement = document.activeElement;

        equipmentModal.classList.add("show");
        document.body.style.overflow = "hidden";

        setTimeout(() => {
            equipmentName.focus();
        }, 100);
    }

    /* ========================================
       ADD EQUIPMENT
    ======================================== */

    function openAddEquipment() {
        equipmentForm.reset();

        equipmentForm.action = "/equipment/add";

        equipmentModalTitle.textContent = "Add Equipment";

        equipmentModalDescription.textContent =
            "Enter the equipment details below.";

        equipmentSaveBtn.textContent = "Save Equipment";

        equipmentSaveBtn.disabled = false;

        equipmentCondition.value = "Good";

        showEquipmentModal();
    }

    /* ========================================
       EDIT EQUIPMENT
    ======================================== */

    function openEditEquipment(
        id,
        name,
        category,
        brand,
        quantity,
        purchasePrice,
        rentalPrice,
        condition
    ) {
        equipmentForm.reset();

        equipmentForm.action =
            "/equipment/edit/" + encodeURIComponent(id);

        equipmentModalTitle.textContent = "Edit Equipment";

        equipmentModalDescription.textContent =
            "Update the details of this equipment.";

        equipmentSaveBtn.textContent = "Update Equipment";

        equipmentSaveBtn.disabled = false;

        equipmentName.value = name || "";

        equipmentCategory.value = category || "";

        equipmentBrand.value = brand || "";

        equipmentQuantity.value =
            Number(quantity || 0);

        equipmentPurchasePrice.value =
            Number(purchasePrice || 0);

        equipmentRentalPrice.value =
            Number(rentalPrice || 0);

        equipmentCondition.value =
            condition || "Good";

        showEquipmentModal();
    }

    /* ========================================
       EDIT BUTTON EVENTS

       Using data attributes prevents problems
       when names contain quotation marks.
    ======================================== */

    document.querySelectorAll(".js-edit-equipment").forEach(button => {

        button.addEventListener("click", () => {

            openEditEquipment(
                button.dataset.id,
                button.dataset.name,
                button.dataset.category,
                button.dataset.brand,
                button.dataset.quantity,
                button.dataset.purchasePrice,
                button.dataset.rentalPrice,
                button.dataset.condition
            );

        });

    });

    /* ========================================
       CLOSE MODAL
    ======================================== */

    function closeEquipmentModal() {
        equipmentModal.classList.remove("show");

        document.body.style.overflow = "";

        if (
            previousFocusedElement &&
            typeof previousFocusedElement.focus === "function"
        ) {
            previousFocusedElement.focus();
        }
    }

    /* ========================================
       CLICK OUTSIDE MODAL
    ======================================== */

    equipmentModal.addEventListener("click", event => {

        if (event.target === equipmentModal) {
            closeEquipmentModal();
        }

    });

    /* ========================================
       ESCAPE KEY
    ======================================== */

    window.addEventListener("keydown", event => {

        if (
            event.key === "Escape" &&
            equipmentModal.classList.contains("show")
        ) {
            closeEquipmentModal();
        }

    });

    /* ========================================
       DELETE CONFIRMATION
    ======================================== */

    function confirmDeleteEquipment(form) {
        const confirmed = window.confirm(
            "Are you sure you want to delete this equipment?\n\n" +
            "This action cannot be undone."
        );

        if (!confirmed) {
            return false;
        }

        const submitButton = form.querySelector(
            'button[type="submit"]'
        );

        if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = "Deleting...";
        }

        return true;
    }

    /* ========================================
       FORM VALIDATION
    ======================================== */

    equipmentForm.addEventListener("submit", event => {

        const name = equipmentName.value.trim();

        const quantity = Number(equipmentQuantity.value);

        const purchasePrice = equipmentPurchasePrice.value;

        const rentalPrice = equipmentRentalPrice.value;

        if (!name) {
            event.preventDefault();

            equipmentName.focus();

            showEquipmentToast("Please enter the equipment name.");

            return;
        }

        if (
            equipmentQuantity.value === "" ||
            !Number.isInteger(quantity) ||
            quantity < 0
        ) {
            event.preventDefault();

            equipmentQuantity.focus();

            showEquipmentToast(
                "Please enter a valid whole-number quantity."
            );

            return;
        }

        if (
            purchasePrice !== "" &&
            (!Number.isFinite(Number(purchasePrice)) ||
                Number(purchasePrice) < 0)
        ) {
            event.preventDefault();

            equipmentPurchasePrice.focus();

            showEquipmentToast(
                "Purchase price cannot be negative."
            );

            return;
        }

        if (
            rentalPrice === "" ||
            !Number.isFinite(Number(rentalPrice)) ||
            Number(rentalPrice) < 0
        ) {
            event.preventDefault();

            equipmentRentalPrice.focus();

            showEquipmentToast(
                "Please enter a valid rental price."
            );

            return;
        }

        equipmentName.value = name;

        equipmentSaveBtn.disabled = true;

        equipmentSaveBtn.textContent =
            equipmentForm.action.endsWith("/add")
                ? "Saving..."
                : "Updating...";

    });

    /* ========================================
       RESET SAVE BUTTON WHEN PAGE IS RESTORED
       ======================================== */

    window.addEventListener("pageshow", () => {

        equipmentSaveBtn.disabled = false;

        equipmentSaveBtn.textContent =
            equipmentForm.action.endsWith("/add")
                ? "Save Equipment"
                : "Update Equipment";

        document.querySelectorAll(
            '.table-actions form button[type="submit"]'
        ).forEach(button => {
            button.disabled = false;
            button.textContent = "Delete";
        });

    });
</script>

</body>
</html>
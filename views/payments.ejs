<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Payments | Sound Billing</title>

    <style>
        :root {
            --bg: #f6f7fb;
            --surface: #ffffff;
            --surface-soft: #fafaff;
            --text: #171923;
            --muted: #777b8b;
            --border: #e9eaf1;
            --primary: #6957d8;
            --primary-dark: #5140bf;
            --primary-light: #f0edff;
            --green: #16845b;
            --green-light: #e7f8ef;
            --red: #d64545;
            --red-light: #fff0f0;
            --shadow: 0 4px 18px rgba(27, 31, 59, 0.035);
            --radius: 16px;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Inter, -apple-system, BlinkMacSystemFont,
                "Segoe UI", Arial, sans-serif;
            background: var(--bg);
            color: var(--text);
            -webkit-font-smoothing: antialiased;
        }

        button {
            font: inherit;
        }

        /* MAIN LAYOUT */

        .app {
            min-height: 100vh;
        }

        .main {
            margin-left: 250px;
            min-height: 100vh;
            padding: 34px;
            width: calc(100% - 250px);
        }

        /* PAGE HEADER */

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 30px;
        }

        .page-heading {
            display: flex;
            align-items: flex-start;
            gap: 15px;
        }

        .heading-icon {
            width: 50px;
            height: 50px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--primary-light);
            color: var(--primary);
            border: 1px solid #e7e2ff;
            border-radius: 15px;
            font-size: 24px;
        }

        .topbar h1 {
            font-size: 28px;
            line-height: 1.3;
            font-weight: 750;
            letter-spacing: -0.8px;
        }

        .topbar p {
            color: var(--muted);
            margin-top: 6px;
            font-size: 14px;
            line-height: 1.6;
        }

        .header-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 10px 14px;
            border: 1px solid var(--border);
            background: var(--surface);
            border-radius: 10px;
            color: #626779;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
        }

        .live-dot {
            width: 8px;
            height: 8px;
            background: #20a56b;
            border-radius: 50%;
        }

        /* SUMMARY CARDS */

        .summary {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 28px;
        }

        .summary-card {
            position: relative;
            overflow: hidden;
            min-width: 0;
            padding: 23px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .summary-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 28px rgba(27, 31, 59, 0.07);
        }

        .summary-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 22px;
        }

        .card-title {
            color: var(--muted);
            font-size: 13px;
            font-weight: 600;
            line-height: 1.5;
        }

        .card-icon {
            width: 43px;
            height: 43px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            font-size: 21px;
            flex-shrink: 0;
        }

        .icon-purple {
            color: var(--primary);
            background: var(--primary-light);
        }

        .icon-green {
            color: var(--green);
            background: var(--green-light);
        }

        .icon-blue {
            color: #2877d5;
            background: #eaf3ff;
        }

        .icon-orange {
            color: #c27b19;
            background: #fff4df;
        }

        .card-value {
            font-size: clamp(21px, 2vw, 29px);
            font-weight: 750;
            letter-spacing: -0.8px;
            overflow-wrap: anywhere;
            line-height: 1.3;
        }

        .card-caption {
            margin-top: 8px;
            font-size: 12px;
            color: #9a9eac;
        }

        /* PAYMENT TABLE CARD */

        .table-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            overflow: hidden;
        }

        .table-heading {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 16px;
            padding: 24px 26px;
            border-bottom: 1px solid var(--border);
        }

        .table-heading h2 {
            font-size: 17px;
            font-weight: 750;
            letter-spacing: -0.3px;
        }

        .table-heading p {
            margin-top: 5px;
            color: var(--muted);
            font-size: 12px;
            line-height: 1.5;
        }

        .record-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 34px;
            height: 30px;
            padding: 0 10px;
            border-radius: 9px;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 12px;
            font-weight: 750;
        }

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        table {
            width: 100%;
            min-width: 850px;
            border-collapse: collapse;
        }

        thead {
            background: #fafaff;
        }

        th {
            padding: 15px 22px;
            color: #85899a;
            font-size: 10px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            text-align: left;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 19px 22px;
            border-bottom: 1px solid #f0f1f6;
            font-size: 13px;
            vertical-align: middle;
        }

        tbody tr {
            transition: background 0.18s ease;
        }

        tbody tr:hover {
            background: #fbfaff;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        /* CUSTOMER */

        .customer-cell {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: 160px;
        }

        .customer-avatar {
            width: 39px;
            height: 39px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 14px;
            font-weight: 750;
            text-transform: uppercase;
        }

        .customer-name {
            color: #25283a;
            font-weight: 700;
            font-size: 13px;
            overflow-wrap: anywhere;
        }

        .customer-caption {
            color: #a0a3b0;
            font-size: 11px;
            margin-top: 4px;
        }

        /* EVENT */

        .event-type {
            color: #292c3d;
            font-size: 13px;
            font-weight: 650;
            margin-bottom: 5px;
        }

        .event-date {
            display: flex;
            align-items: center;
            gap: 5px;
            color: var(--muted);
            font-size: 11px;
            white-space: nowrap;
        }

        .event-location {
            max-width: 180px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: #a0a3b0;
            font-size: 11px;
            margin-top: 5px;
        }

        /* AMOUNT */

        .amount {
            font-size: 14px;
            font-weight: 750;
            color: #222538;
            white-space: nowrap;
        }

        .amount-prefix {
            color: #85899a;
            font-size: 11px;
            margin-right: 2px;
        }

        /* PAYMENT METHOD */

        .method {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 10px;
            border: 1px solid #e7e3ff;
            border-radius: 8px;
            background: #f5f3ff;
            color: #6452c5;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .method-dot {
            width: 6px;
            height: 6px;
            background: #8775e6;
            border-radius: 50%;
        }

        /* DELETE BUTTON */

        .action-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            border: 1px solid #f4dada;
            background: white;
            color: var(--red);
            padding: 9px 12px;
            border-radius: 9px;
            cursor: pointer;
            font-size: 12px;
            font-weight: 650;
            white-space: nowrap;
            transition: background 0.2s ease, border-color 0.2s ease;
        }

        .delete-btn:hover {
            background: var(--red-light);
            border-color: #eebbbb;
        }

        .action-btn:focus-visible,
        .cancel-btn:focus-visible,
        .confirm-delete:focus-visible,
        .close-modal:focus-visible {
            outline: 3px solid rgba(105, 87, 216, 0.25);
            outline-offset: 2px;
        }

        /* EMPTY STATE */

        .empty-cell {
            padding: 0 !important;
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 65px 20px;
            text-align: center;
        }

        .empty-icon {
            width: 66px;
            height: 66px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #f3f0ff;
            border-radius: 20px;
            font-size: 29px;
            margin-bottom: 18px;
        }

        .empty-state h3 {
            color: #303347;
            font-size: 16px;
            margin-bottom: 7px;
        }

        .empty-state p {
            max-width: 300px;
            color: var(--muted);
            font-size: 13px;
            line-height: 1.7;
        }

        /* TABLE FOOTER */

        .table-footer {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 16px 24px;
            background: #fdfdff;
            border-top: 1px solid var(--border);
            color: var(--muted);
            font-size: 12px;
        }

        .footer-total {
            color: #34364a;
            font-weight: 700;
        }

        /* DELETE MODAL */

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            background: rgba(18, 20, 39, 0.5);
            backdrop-filter: blur(5px);
            -webkit-backdrop-filter: blur(5px);
            justify-content: center;
            align-items: center;
            padding: 20px;
            z-index: 1000;
        }

        .modal.active {
            display: flex;
            animation: modalFade 0.18s ease;
        }

        @keyframes modalFade {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        .modal-box {
            position: relative;
            width: 100%;
            max-width: 420px;
            padding: 30px;
            background: white;
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 20px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.18);
            text-align: center;
            animation: modalSlide 0.22s ease;
        }

        @keyframes modalSlide {
            from {
                transform: translateY(10px) scale(0.98);
            }

            to {
                transform: translateY(0) scale(1);
            }
        }

        .close-modal {
            position: absolute;
            top: 15px;
            right: 15px;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 10px;
            background: #f5f5fa;
            color: #6e7282;
            cursor: pointer;
            font-size: 20px;
        }

        .close-modal:hover {
            background: #ececf4;
        }

        .delete-icon {
            width: 64px;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 20px;
            border-radius: 20px;
            background: #fff0f0;
            color: var(--red);
            font-size: 28px;
        }

        .delete-box h2 {
            font-size: 21px;
            font-weight: 750;
            letter-spacing: -0.4px;
        }

        .delete-box p {
            color: var(--muted);
            font-size: 13px;
            line-height: 1.8;
            margin-top: 10px;
            overflow-wrap: anywhere;
        }

        .delete-actions {
            display: flex;
            gap: 11px;
            margin-top: 26px;
        }

        .cancel-btn,
        .confirm-delete {
            flex: 1;
            min-height: 44px;
            padding: 11px 15px;
            border-radius: 10px;
            cursor: pointer;
            font-size: 13px;
            font-weight: 700;
            transition: background 0.2s ease;
        }

        .cancel-btn {
            border: 1px solid var(--border);
            background: white;
            color: #525568;
        }

        .cancel-btn:hover {
            background: #f8f8fc;
        }

        .confirm-delete {
            border: 1px solid var(--red);
            background: var(--red);
            color: white;
        }

        .confirm-delete:hover {
            background: #bb3030;
            border-color: #bb3030;
        }

        /* RESPONSIVE */

        @media (max-width: 1250px) {
            .main {
                padding: 25px;
            }

            .summary {
                gap: 13px;
            }

            .summary-card {
                padding: 19px;
            }

            th,
            td {
                padding-left: 16px;
                padding-right: 16px;
            }
        }

        @media (max-width: 1050px) {
            .summary {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .card-value {
                font-size: 26px;
            }
        }

        @media (max-width: 800px) {
            .main {
                margin-left: 0;
                width: 100%;
                padding: 22px;
            }

            .topbar {
                align-items: flex-start;
            }

            .topbar h1 {
                font-size: 25px;
            }

            .table-heading {
                padding: 20px;
            }
        }

        @media (max-width: 520px) {
            .main {
                padding: 16px;
            }

            .topbar {
                flex-direction: column;
                gap: 15px;
                margin-bottom: 23px;
            }

            .page-heading {
                gap: 11px;
            }

            .heading-icon {
                width: 43px;
                height: 43px;
                font-size: 20px;
                border-radius: 12px;
            }

            .topbar h1 {
                font-size: 23px;
            }

            .topbar p {
                font-size: 12px;
            }

            .header-badge {
                font-size: 11px;
                padding: 8px 11px;
            }

            .summary {
                gap: 12px;
                margin-bottom: 22px;
            }

            .summary-card {
                padding: 18px;
                border-radius: 14px;
            }

            .summary-top {
                margin-bottom: 15px;
            }

            .card-icon {
                width: 39px;
                height: 39px;
                border-radius: 11px;
            }

            .card-value {
                font-size: 25px;
            }

            .table-heading {
                padding: 18px;
            }

            .table-heading h2 {
                font-size: 15px;
            }

            .table-footer {
                align-items: flex-start;
                flex-direction: column;
                padding: 15px 18px;
            }

            .modal-box {
                padding: 28px 21px 22px;
                border-radius: 17px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>

<body>

    <div class="app">

        <%- include("partials/sidebar") %>

        <main class="main">

            <!-- PAGE HEADER -->

            <header class="topbar">

                <div class="page-heading">

                    <div class="heading-icon" aria-hidden="true">
                        ₹
                    </div>

                    <div>
                        <h1>Payments</h1>

                        <p>
                            Monitor received payments and track your event revenue.
                        </p>
                    </div>

                </div>

                <div class="header-badge">
                    <span class="live-dot"></span>
                    Payment records
                </div>

            </header>


            <!-- CALCULATE SUMMARY TOTALS -->

            <%
                const paymentList = Array.isArray(payments) ? payments : [];

                const totalPayments = paymentList.reduce(
                    (sum, payment) =>
                        sum + Number(payment.amount || 0),
                    0
                );

                const cashPayments = paymentList
                    .filter(payment => payment.paymentMethod === "Cash")
                    .reduce(
                        (sum, payment) =>
                            sum + Number(payment.amount || 0),
                        0
                    );

                const upiPayments = paymentList
                    .filter(payment => payment.paymentMethod === "UPI")
                    .reduce(
                        (sum, payment) =>
                            sum + Number(payment.amount || 0),
                        0
                    );

                const bankPayments = paymentList
                    .filter(payment => payment.paymentMethod === "Bank Transfer")
                    .reduce(
                        (sum, payment) =>
                            sum + Number(payment.amount || 0),
                        0
                    );

                const formatMoney = amount =>
                    Number(amount || 0).toLocaleString("en-IN", {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    });
            %>


            <!-- SUMMARY CARDS -->

            <section class="summary">

                <!-- TOTAL PAYMENTS -->

                <article class="summary-card">

                    <div class="summary-top">

                        <div class="card-title">
                            Total Payments
                        </div>

                        <div class="card-icon icon-purple" aria-hidden="true">
                            ₹
                        </div>

                    </div>

                    <div class="card-value">
                        ₹<%= formatMoney(totalPayments) %>
                    </div>

                    <div class="card-caption">
                        Total amount received
                    </div>

                </article>


                <!-- CASH -->

                <article class="summary-card">

                    <div class="summary-top">

                        <div class="card-title">
                            Cash Received
                        </div>

                        <div class="card-icon icon-green" aria-hidden="true">
                            ◈
                        </div>

                    </div>

                    <div class="card-value">
                        ₹<%= formatMoney(cashPayments) %>
                    </div>

                    <div class="card-caption">
                        Payments received in cash
                    </div>

                </article>


                <!-- UPI -->

                <article class="summary-card">

                    <div class="summary-top">

                        <div class="card-title">
                            UPI Received
                        </div>

                        <div class="card-icon icon-blue" aria-hidden="true">
                            ↗
                        </div>

                    </div>

                    <div class="card-value">
                        ₹<%= formatMoney(upiPayments) %>
                    </div>

                    <div class="card-caption">
                        Digital UPI payments
                    </div>

                </article>


                <!-- BANK TRANSFER -->

                <article class="summary-card">

                    <div class="summary-top">

                        <div class="card-title">
                            Bank Transfer
                        </div>

                        <div class="card-icon icon-orange" aria-hidden="true">
                            ▤
                        </div>

                    </div>

                    <div class="card-value">
                        ₹<%= formatMoney(bankPayments) %>
                    </div>

                    <div class="card-caption">
                        Payments received by bank
                    </div>

                </article>

            </section>


            <!-- PAYMENTS TABLE -->

            <section class="table-card">

                <div class="table-heading">

                    <div>
                        <h2>Payment History</h2>

                        <p>
                            View all recorded payments and their details.
                        </p>
                    </div>

                    <span class="record-count">
                        <%= paymentList.length %>
                    </span>

                </div>


                <div class="table-wrapper">

                    <table>

                        <thead>
                            <tr>
                                <th>Customer</th>
                                <th>Event Details</th>
                                <th>Amount Received</th>
                                <th>Payment Date</th>
                                <th>Payment Method</th>
                                <th>Action</th>
                            </tr>
                        </thead>


                        <tbody>

                            <% if (paymentList.length === 0) { %>

                                <tr>
                                    <td colspan="6" class="empty-cell">

                                        <div class="empty-state">

                                            <div class="empty-icon" aria-hidden="true">
                                                ₹
                                            </div>

                                            <h3>No payments yet</h3>

                                            <p>
                                                Payments recorded against your invoices
                                                will appear here.
                                            </p>

                                        </div>

                                    </td>
                                </tr>

                            <% } else { %>

                                <% paymentList.forEach(payment => { %>

                                    <%
                                        const customerName =
                                            payment.invoice?.booking?.customer?.name || "Unknown Customer";

                                        const customerInitial =
                                            customerName.trim().charAt(0) || "?";

                                        const eventType =
                                            payment.invoice?.booking?.eventType || "Event";

                                        const eventDate =
                                            payment.invoice?.booking?.eventDate;

                                        const eventLocation =
                                            payment.invoice?.booking?.location;

                                        const paymentMethod =
                                            payment.paymentMethod || "Other";
                                    %>

                                    <tr>

                                        <!-- CUSTOMER -->

                                        <td>

                                            <div class="customer-cell">

                                                <div class="customer-avatar">
                                                    <%= customerInitial %>
                                                </div>

                                                <div>
                                                    <div class="customer-name">
                                                        <%= customerName %>
                                                    </div>

                                                    <div class="customer-caption">
                                                        Customer
                                                    </div>
                                                </div>

                                            </div>

                                        </td>


                                        <!-- EVENT DETAILS -->

                                        <td>

                                            <div class="event-type">
                                                <%= eventType %>
                                            </div>

                                            <div class="event-date">

                                                <span aria-hidden="true">◷</span>

                                                <% if (eventDate) { %>

                                                    <%= new Date(eventDate).toLocaleDateString(
                                                        "en-IN",
                                                        {
                                                            day: "2-digit",
                                                            month: "short",
                                                            year: "numeric"
                                                        }
                                                    ) %>

                                                <% } else { %>

                                                    Date not set

                                                <% } %>

                                            </div>

                                            <% if (eventLocation) { %>

                                                <div
                                                    class="event-location"
                                                    title="<%= eventLocation %>"
                                                >
                                                    <%= eventLocation %>
                                                </div>

                                            <% } %>

                                        </td>


                                        <!-- AMOUNT -->

                                        <td>

                                            <div class="amount">
                                                <span class="amount-prefix">INR</span>
                                                ₹<%= formatMoney(payment.amount) %>
                                            </div>

                                        </td>


                                        <!-- PAYMENT DATE -->

                                        <td>

                                            <% if (payment.paymentDate) { %>

                                                <span style="font-weight:600;color:#44475a;">

                                                    <%= new Date(payment.paymentDate).toLocaleDateString(
                                                        "en-IN",
                                                        {
                                                            day: "2-digit",
                                                            month: "short",
                                                            year: "numeric"
                                                        }
                                                    ) %>

                                                </span>

                                            <% } else { %>

                                                <span style="color:#a0a3b0;">-</span>

                                            <% } %>

                                        </td>


                                        <!-- PAYMENT METHOD -->

                                        <td>

                                            <span class="method">
                                                <span class="method-dot"></span>
                                                <%= paymentMethod %>
                                            </span>

                                        </td>


                                        <!-- ACTION -->

                                        <td>

                                            <button
                                                type="button"
                                                class="action-btn delete-btn"
                                                data-payment-id="<%= payment._id %>"
                                                data-payment-number="<%= payment.paymentNumber || "" %>"
                                                onclick="openDeleteModalFromButton(this)"
                                                aria-label="Delete payment <%= payment.paymentNumber || "" %>"
                                            >
                                                <span aria-hidden="true">⌫</span>
                                                Delete
                                            </button>

                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                        </tbody>

                    </table>

                </div>


                <!-- TABLE FOOTER -->

                <div class="table-footer">

                    <span>
                        Showing <strong><%= paymentList.length %></strong>
                        payment record<%= paymentList.length === 1 ? "" : "s" %>
                    </span>

                    <span>
                        Total received:
                        <strong class="footer-total">
                            ₹<%= formatMoney(totalPayments) %>
                        </strong>
                    </span>

                </div>

            </section>

        </main>

    </div>


    <!-- DELETE CONFIRMATION MODAL -->

    <div
        class="modal"
        id="deleteModal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="deleteTitle"
        aria-describedby="deleteText"
    >

        <div class="modal-box delete-box">

            <button
                type="button"
                class="close-modal"
                onclick="closeDeleteModal()"
                aria-label="Close confirmation"
            >
                ×
            </button>

            <div class="delete-icon" aria-hidden="true">
                !
            </div>

            <h2 id="deleteTitle">
                Delete Payment?
            </h2>

            <p id="deleteText">
                Are you sure you want to delete this payment?
            </p>

            <p>
                This action cannot be undone.
            </p>

            <div class="delete-actions">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeDeleteModal()"
                >
                    Cancel
                </button>

                <button
                    type="button"
                    class="confirm-delete"
                    id="confirmDeleteButton"
                    onclick="confirmDelete()"
                >
                    Delete Payment
                </button>

            </div>

        </div>

    </div>


    <!-- JAVASCRIPT -->

    <script>
        let deletePaymentId = null;

        const deleteModal =
            document.getElementById("deleteModal");

        const deleteText =
            document.getElementById("deleteText");

        const confirmDeleteButton =
            document.getElementById("confirmDeleteButton");


        /* OPEN DELETE MODAL */

        function openDeleteModalFromButton(button) {

            const id = button.dataset.paymentId;
            const paymentNumber = button.dataset.paymentNumber;

            if (!id) {
                return;
            }

            deletePaymentId = id;

            const reference = paymentNumber
                ? "payment " + paymentNumber
                : "this payment";

            deleteText.textContent =
                "Are you sure you want to delete " + reference + "?";

            deleteModal.classList.add("active");

            confirmDeleteButton.disabled = false;
            confirmDeleteButton.textContent = "Delete Payment";

            confirmDeleteButton.focus();

        }


        /* CLOSE DELETE MODAL */

        function closeDeleteModal() {

            deleteModal.classList.remove("active");

            deletePaymentId = null;

        }


        /* CONFIRM DELETE */

        function confirmDelete() {

            if (!deletePaymentId) {
                return;
            }

            const id = deletePaymentId;

            confirmDeleteButton.disabled = true;
            confirmDeleteButton.textContent = "Deleting...";

            const form = document.createElement("form");

            form.method = "POST";
            form.action = "/payments/delete/" + encodeURIComponent(id);

            document.body.appendChild(form);

            form.submit();

        }


        /* CLOSE WHEN CLICKING OUTSIDE */

        deleteModal.addEventListener("click", function(event) {

            if (event.target === deleteModal) {
                closeDeleteModal();
            }

        });


        /* ESCAPE KEY */

        window.addEventListener("keydown", function(event) {

            if (
                event.key === "Escape" &&
                deleteModal.classList.contains("active")
            ) {
                closeDeleteModal();
            }

        });

    </script>

</body>

</html>


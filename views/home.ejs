<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>expro AUDIO | Sound & Event Management</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary: #635bff;
            --primary-dark: #4f46e5;
            --primary-light: #eeecff;

            --blue: #2563eb;
            --pink: #ec4899;

            --background: #f6f7fc;
            --surface: #ffffff;
            --surface-soft: #f8f9ff;

            --text: #172033;
            --text-soft: #606a80;
            --muted: #939bad;

            --border: #e7eaf2;

            --shadow-sm: 0 8px 24px rgba(30, 41, 80, 0.05);
            --shadow-md: 0 18px 45px rgba(40, 40, 90, 0.09);
            --shadow-lg: 0 25px 65px rgba(65, 55, 150, 0.13);

            --radius: 20px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Inter", sans-serif;
            color: var(--text);
            background: var(--background);
            overflow-x: hidden;
            -webkit-font-smoothing: antialiased;
        }

        a {
            text-decoration: none;
            color: inherit;
        }

        button {
            font-family: inherit;
        }

        /* =========================
           BACKGROUND EFFECTS
        ========================= */

        .page-background {
            position: fixed;
            inset: 0;
            z-index: -2;
            overflow: hidden;
            pointer-events: none;
        }

        .background-grid {
            position: absolute;
            inset: 0;

            background-image:
                linear-gradient(rgba(99, 91, 255, 0.035) 1px, transparent 1px),
                linear-gradient(90deg, rgba(99, 91, 255, 0.035) 1px, transparent 1px);

            background-size: 52px 52px;

            mask-image: linear-gradient(
                to bottom,
                black,
                transparent 85%
            );
        }

        .glow {
            position: absolute;
            border-radius: 50%;
            filter: blur(85px);
            opacity: 0.5;
            animation: glowFloat 12s ease-in-out infinite;
        }

        .glow-purple {
            width: 380px;
            height: 380px;
            top: 60px;
            left: -180px;
            background: rgba(99, 91, 255, 0.15);
        }

        .glow-blue {
            width: 330px;
            height: 330px;
            top: 130px;
            right: -150px;
            background: rgba(37, 99, 235, 0.12);
            animation-delay: -4s;
        }

        .glow-pink {
            width: 230px;
            height: 230px;
            top: 450px;
            right: 20%;
            background: rgba(236, 72, 153, 0.07);
            animation-delay: -7s;
        }

        @keyframes glowFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-20px);
            }
        }

        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            position: relative;
            z-index: 20;
            padding: 16px 28px 0;
        }

        .navbar-inner {
            max-width: 1160px;
            min-height: 64px;
            margin: 0 auto;
            padding: 0 10px 0 18px;

            display: flex;
            align-items: center;
            justify-content: space-between;

            background: rgba(255, 255, 255, 0.82);
            border: 1px solid rgba(231, 234, 242, 0.9);
            border-radius: 17px;

            box-shadow: 0 8px 28px rgba(30, 41, 80, 0.045);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .brand {
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }

        .brand-icon {
            width: 35px;
            height: 35px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: white;

            background: linear-gradient(
                135deg,
                var(--primary),
                #8278ff
            );

            border-radius: 10px;

            box-shadow: 0 6px 18px rgba(99, 91, 255, 0.22);
        }

        .brand-icon svg {
            width: 19px;
            height: 19px;
        }

        .brand-text {
            display: flex;
            align-items: baseline;
            gap: 5px;
        }

        .brand-name {
            font-size: 18px;
            font-weight: 800;
            letter-spacing: -0.7px;
        }

        .brand-name span {
            color: var(--primary);
        }

        .brand-subtitle {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.5px;
            color: var(--muted);
        }

        .navbar-right {
            display: flex;
            align-items: center;
            gap: 17px;
        }

        .system-status {
            display: flex;
            align-items: center;
            gap: 8px;

            color: var(--text-soft);
            font-size: 11px;
            font-weight: 600;
        }

        .status-dot {
            width: 7px;
            height: 7px;
            background: #22c55e;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.09);
        }

        .dashboard-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 9px;

            padding: 11px 16px;

            color: white;
            background: var(--text);

            border-radius: 11px;

            font-size: 11px;
            font-weight: 700;

            transition: 0.25s ease;
        }

        .dashboard-button:hover {
            background: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 9px 22px rgba(99, 91, 255, 0.2);
        }

        .dashboard-button svg {
            width: 14px;
            height: 14px;
        }

        /* =========================
           HERO SECTION
        ========================= */

        .hero {
            max-width: 1160px;
            min-height: 590px;
            margin: 0 auto;
            padding: 55px 28px 45px;

            display: grid;
            grid-template-columns: 1fr 0.95fr;
            align-items: center;
            gap: 38px;
        }

        .hero-content {
            position: relative;
            z-index: 3;
        }

        .hero-label {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            padding: 8px 12px;

            color: var(--text-soft);
            background: rgba(255, 255, 255, 0.8);

            border: 1px solid var(--border);
            border-radius: 50px;

            font-size: 9px;
            font-weight: 700;
            letter-spacing: 1.15px;
        }

        .hero-label-dot {
            width: 6px;
            height: 6px;
            background: var(--primary);
            border-radius: 50%;
            box-shadow: 0 0 12px rgba(99, 91, 255, 0.55);
        }

        .hero-title {
            margin-top: 23px;

            font-size: clamp(65px, 7vw, 90px);
            line-height: 0.94;

            font-weight: 800;
            letter-spacing: -5px;
        }

        .hero-title .expro {
            display: block;

            background: linear-gradient(
                115deg,
                #171b2e 5%,
                #4f46d9 72%,
                #8177ff 100%
            );

            color: transparent;
            -webkit-background-clip: text;
            background-clip: text;
        }

        .hero-title .audio-title {
            display: block;
            margin-top: 15px;

            color: var(--text-soft);

            font-size: clamp(14px, 1.6vw, 18px);
            line-height: 1.5;
            letter-spacing: 4px;
            font-weight: 700;
        }

        .hero-title .audio-title::after {
            content: "";
            display: inline-block;

            width: 32px;
            height: 3px;

            margin: 0 0 4px 8px;

            border-radius: 5px;

            background: linear-gradient(
                90deg,
                var(--primary),
                var(--pink)
            );
        }

        .hero-description {
            max-width: 475px;
            margin-top: 21px;

            color: var(--text-soft);

            font-size: 13px;
            line-height: 1.9;
        }

        .hero-actions {
            margin-top: 27px;
        }

        .primary-button {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;

            padding: 14px 19px;

            color: white;

            background: linear-gradient(
                135deg,
                var(--primary),
                #7770ff
            );

            border-radius: 12px;

            font-size: 11px;
            font-weight: 700;

            box-shadow: 0 10px 25px rgba(99, 91, 255, 0.22);

            transition:
                transform 0.25s ease,
                box-shadow 0.25s ease;
        }

        .primary-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 32px rgba(99, 91, 255, 0.3);
        }

        .primary-button svg {
            width: 15px;
            height: 15px;
        }

        .hero-highlights {
            margin-top: 29px;

            display: flex;
            align-items: center;
            flex-wrap: wrap;
            gap: 20px;
        }

        .highlight {
            display: flex;
            align-items: center;
            gap: 8px;

            color: var(--muted);

            font-size: 10px;
            font-weight: 600;
        }

        .highlight-icon {
            width: 27px;
            height: 27px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--primary);
            background: white;

            border: 1px solid var(--border);
            border-radius: 8px;
        }

        .highlight-icon svg {
            width: 14px;
            height: 14px;
        }

        /* =========================
           HERO VISUAL
        ========================= */

        .hero-visual {
            position: relative;

            min-height: 430px;

            display: flex;
            align-items: center;
            justify-content: center;
        }

        .visual-ring {
            position: absolute;

            width: 350px;
            height: 350px;

            border: 1px solid rgba(99, 91, 255, 0.12);
            border-radius: 50%;

            animation: ringPulse 6s ease-in-out infinite;
        }

        .visual-ring::before {
            content: "";
            position: absolute;

            top: 42px;
            right: 42px;

            width: 7px;
            height: 7px;

            background: var(--pink);
            border-radius: 50%;

            box-shadow: 0 0 15px rgba(236, 72, 153, 0.4);
        }

        @keyframes ringPulse {
            0%, 100% {
                transform: scale(1);
                opacity: 0.7;
            }

            50% {
                transform: scale(1.035);
                opacity: 1;
            }
        }

        .preview-card {
            position: relative;
            z-index: 3;

            width: min(370px, 100%);
            padding: 20px;

            background: rgba(255, 255, 255, 0.9);

            border: 1px solid rgba(226, 229, 241, 0.95);
            border-radius: 23px;

            box-shadow: var(--shadow-lg);

            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);

            animation: cardFloat 6s ease-in-out infinite;
        }

        @keyframes cardFloat {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-7px);
            }
        }

        .preview-header {
            display: flex;
            align-items: center;
            justify-content: space-between;

            padding-bottom: 15px;
            border-bottom: 1px solid var(--border);
        }

        .preview-brand {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .preview-brand-icon {
            width: 34px;
            height: 34px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--primary);
            background: var(--primary-light);

            border-radius: 10px;
        }

        .preview-brand-icon svg {
            width: 17px;
            height: 17px;
        }

        .preview-brand-text strong {
            display: block;
            font-size: 12px;
            font-weight: 800;
        }

        .preview-brand-text span {
            display: block;
            margin-top: 4px;

            color: var(--muted);
            font-size: 9px;
        }

        .preview-live {
            display: flex;
            align-items: center;
            gap: 6px;

            color: #16a34a;

            font-size: 9px;
            font-weight: 800;
            letter-spacing: 0.5px;
        }

        .preview-live span {
            width: 6px;
            height: 6px;

            background: #22c55e;
            border-radius: 50%;

            animation: livePulse 1.8s infinite;
        }

        @keyframes livePulse {
            0%, 100% {
                box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.3);
            }

            50% {
                box-shadow: 0 0 0 5px rgba(34, 197, 94, 0);
            }
        }

        .wave-container {
            margin-top: 17px;
            padding: 17px;

            height: 138px;

            display: flex;
            align-items: center;
            justify-content: center;

            background:
                radial-gradient(
                    circle at center,
                    rgba(99, 91, 255, 0.09),
                    transparent 70%
                ),
                #fafaff;

            border: 1px solid #eef0f8;
            border-radius: 16px;
        }

        .waveform {
            width: 100%;
            height: 86px;

            display: flex;
            align-items: center;
            justify-content: center;
            gap: 4px;
        }

        .wave-bar {
            width: 4px;
            min-height: 10px;

            border-radius: 5px;

            background: linear-gradient(
                to top,
                var(--primary),
                #aaa4ff
            );

            transform-origin: center;

            animation: waveform 1.2s ease-in-out infinite;
        }

        .wave-bar:nth-child(1)  { height: 25%; animation-delay: -.3s; }
        .wave-bar:nth-child(2)  { height: 43%; animation-delay: -.8s; }
        .wave-bar:nth-child(3)  { height: 68%; animation-delay: -.5s; }
        .wave-bar:nth-child(4)  { height: 48%; animation-delay: -.2s; }
        .wave-bar:nth-child(5)  { height: 83%; animation-delay: -.7s; }
        .wave-bar:nth-child(6)  { height: 57%; animation-delay: -.4s; }
        .wave-bar:nth-child(7)  { height: 92%; animation-delay: -.9s; }
        .wave-bar:nth-child(8)  { height: 62%; animation-delay: -.6s; }
        .wave-bar:nth-child(9)  { height: 78%; animation-delay: -.1s; }
        .wave-bar:nth-child(10) { height: 47%; animation-delay: -.8s; }
        .wave-bar:nth-child(11) { height: 87%; animation-delay: -.3s; }
        .wave-bar:nth-child(12) { height: 58%; animation-delay: -.5s; }
        .wave-bar:nth-child(13) { height: 72%; animation-delay: -.2s; }
        .wave-bar:nth-child(14) { height: 42%; animation-delay: -.9s; }
        .wave-bar:nth-child(15) { height: 65%; animation-delay: -.4s; }
        .wave-bar:nth-child(16) { height: 37%; animation-delay: -.7s; }
        .wave-bar:nth-child(17) { height: 53%; animation-delay: -.1s; }

        @keyframes waveform {
            0%, 100% {
                transform: scaleY(0.55);
                opacity: 0.75;
            }

            50% {
                transform: scaleY(1.1);
                opacity: 1;
            }
        }

        .preview-stats {
            margin-top: 15px;

            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .preview-stat {
            padding: 11px 8px;

            background: var(--surface-soft);
            border: 1px solid var(--border);
            border-radius: 12px;

            text-align: center;
        }

        .preview-stat strong {
            display: block;
            font-size: 12px;
            font-weight: 800;
        }

        .preview-stat span {
            display: block;
            margin-top: 5px;

            color: var(--muted);
            font-size: 8px;
        }

        .floating-card {
            position: absolute;
            z-index: 5;

            display: flex;
            align-items: center;
            gap: 9px;

            padding: 11px 13px;

            background: rgba(255, 255, 255, 0.94);

            border: 1px solid rgba(231, 234, 242, 0.95);
            border-radius: 13px;

            box-shadow: var(--shadow-md);

            animation: floatCard 5s ease-in-out infinite;
        }

        .floating-card.left {
            left: -8px;
            top: 80px;
        }

        .floating-card.right {
            right: -7px;
            bottom: 75px;
            animation-delay: -2.5s;
        }

        .floating-icon {
            width: 29px;
            height: 29px;

            display: flex;
            align-items: center;
            justify-content: center;

            color: var(--blue);
            background: #eaf2ff;

            border-radius: 9px;
        }

        .floating-card.right .floating-icon {
            color: var(--pink);
            background: #fce7f3;
        }

        .floating-icon svg {
            width: 14px;
            height: 14px;
        }

        .floating-text strong {
            display: block;
            font-size: 10px;
            font-weight: 800;
        }

        .floating-text span {
            display: block;
            margin-top: 3px;

            color: var(--muted);
            font-size: 8px;
        }

        @keyframes floatCard {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-6px);
            }
        }

        /* =========================
           FEATURE SECTION
        ========================= */

        .features-section {
            max-width: 1160px;
            margin: 0 auto;
            padding: 55px 28px 80px;
        }

        .section-heading {
            max-width: 600px;
            margin-bottom: 32px;
        }

        .section-eyebrow {
            color: var(--primary);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.6px;
            text-transform: uppercase;
        }

        .section-title {
            margin-top: 10px;

            color: var(--text);

            font-size: clamp(29px, 3.5vw, 39px);
            line-height: 1.15;

            font-weight: 800;
            letter-spacing: -1.7px;
        }

        .section-description {
            margin-top: 12px;

            color: var(--text-soft);

            font-size: 12px;
            line-height: 1.8;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .feature-card {
            position: relative;

            padding: 22px;

            min-height: 205px;

            background: rgba(255, 255, 255, 0.88);

            border: 1px solid var(--border);
            border-radius: var(--radius);

            box-shadow: var(--shadow-sm);

            overflow: hidden;

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease,
                border-color 0.3s ease;
        }

        .feature-card:hover {
            transform: translateY(-5px);
            box-shadow: var(--shadow-md);
            border-color: #d8d5ff;
        }

        .feature-icon {
            width: 42px;
            height: 42px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 19px;

            color: var(--primary);
            background: var(--primary-light);

            border-radius: 12px;
        }

        .feature-card:nth-child(2) .feature-icon {
            color: var(--blue);
            background: #eaf2ff;
        }

        .feature-card:nth-child(4) .feature-icon {
            color: var(--pink);
            background: #fce7f3;
        }

        .feature-icon svg {
            width: 19px;
            height: 19px;
        }

        .feature-title {
            font-size: 14px;
            font-weight: 800;
        }

        .feature-description {
            margin-top: 9px;

            color: var(--text-soft);

            font-size: 10px;
            line-height: 1.8;
        }

        /* =========================
           WORKFLOW
        ========================= */

        .workflow-section {
            background: rgba(255, 255, 255, 0.88);

            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }

        .workflow-inner {
            max-width: 1160px;
            margin: 0 auto;
            padding: 75px 28px;
        }

        .workflow-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .workflow-card {
            position: relative;

            padding: 24px;

            background: var(--surface-soft);

            border: 1px solid var(--border);
            border-radius: 18px;

            transition:
                transform 0.3s ease,
                box-shadow 0.3s ease;
        }

        .workflow-card:hover {
            transform: translateY(-4px);
            box-shadow: var(--shadow-sm);
        }

        .workflow-number {
            position: absolute;
            top: 19px;
            right: 21px;

            color: #e8e9f3;

            font-size: 30px;
            font-weight: 800;
        }

        .workflow-icon {
            width: 40px;
            height: 40px;

            display: flex;
            align-items: center;
            justify-content: center;

            margin-bottom: 20px;

            color: var(--primary);
            background: var(--primary-light);

            border-radius: 11px;
        }

        .workflow-icon svg {
            width: 18px;
            height: 18px;
        }

        .workflow-card h3 {
            font-size: 13px;
            font-weight: 800;
        }

        .workflow-card p {
            margin-top: 9px;

            color: var(--text-soft);

            font-size: 10px;
            line-height: 1.8;
        }

        /* =========================
           FINAL CTA
        ========================= */

        .cta-section {
            max-width: 1160px;
            margin: 0 auto;
            padding: 75px 28px 85px;
        }

        .cta-card {
            position: relative;

            padding: 48px 42px;

            overflow: hidden;

            background:
                radial-gradient(
                    circle at 85% 20%,
                    rgba(99, 91, 255, 0.25),
                    transparent 34%
                ),
                linear-gradient(
                    125deg,
                    #181b30,
                    #252044
                );

            border-radius: 25px;

            box-shadow: 0 22px 55px rgba(35, 31, 80, 0.16);
        }

        .cta-card::after {
            content: "";

            position: absolute;

            width: 200px;
            height: 200px;

            right: -70px;
            bottom: -110px;

            background: rgba(236, 72, 153, 0.13);
            filter: blur(20px);
            border-radius: 50%;
        }

        .cta-content {
            position: relative;
            z-index: 2;
            max-width: 620px;
        }

        .cta-eyebrow {
            color: #aaa4ff;

            font-size: 10px;
            font-weight: 800;
            letter-spacing: 1.5px;
        }

        .cta-title {
            margin-top: 12px;

            color: white;

            font-size: clamp(28px, 4vw, 42px);
            line-height: 1.15;

            font-weight: 800;
            letter-spacing: -1.5px;
        }

        .cta-description {
            margin-top: 13px;

            color: rgba(255, 255, 255, 0.68);

            font-size: 11px;
            line-height: 1.8;
        }

        .cta-button {
            display: inline-flex;
            align-items: center;
            gap: 9px;

            margin-top: 22px;
            padding: 12px 16px;

            color: var(--text);
            background: white;

            border-radius: 11px;

            font-size: 11px;
            font-weight: 800;

            transition: 0.25s ease;
        }

        .cta-button:hover {
            transform: translateY(-2px);
            color: var(--primary);
            background: #f5f3ff;
        }

        .cta-button svg {
            width: 14px;
            height: 14px;
        }

        /* =========================
           FOOTER
        ========================= */

        .footer {
            padding: 24px 28px;

            background: rgba(255, 255, 255, 0.75);
            border-top: 1px solid var(--border);
        }

        .footer-inner {
            max-width: 1160px;
            margin: 0 auto;

            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .footer-brand {
            font-size: 13px;
            font-weight: 800;
            letter-spacing: -0.3px;
        }

        .footer-brand span {
            color: var(--primary);
        }

        .footer-copy {
            color: var(--muted);
            font-size: 9px;
        }

        .footer-tagline {
            color: var(--text-soft);
            font-size: 9px;
            font-weight: 600;
        }

        /* =========================
           SCROLL REVEAL
        ========================= */

        .reveal {
            opacity: 0;
            transform: translateY(18px);

            transition:
                opacity 0.7s ease,
                transform 0.7s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* =========================
           PAGE LOADER
        ========================= */

        .page-loader {
            position: fixed;
            inset: 0;
            z-index: 9999;

            display: flex;
            align-items: center;
            justify-content: center;

            background: #fafbff;

            transition:
                opacity 0.45s ease,
                visibility 0.45s ease;
        }

        .page-loader.hidden {
            opacity: 0;
            visibility: hidden;
        }

        .loader-brand {
            font-size: 24px;
            font-weight: 800;
            letter-spacing: -1px;
        }

        .loader-brand span {
            color: var(--primary);
        }

        .loader-track {
            width: 85px;
            height: 3px;

            margin: 13px auto 0;

            overflow: hidden;

            background: #e7e8f3;
            border-radius: 10px;
        }

        .loader-progress {
            width: 40%;
            height: 100%;

            background: linear-gradient(
                90deg,
                var(--primary),
                var(--pink)
            );

            border-radius: inherit;

            animation: loaderProgress 1s ease-in-out infinite;
        }

        @keyframes loaderProgress {
            0% {
                transform: translateX(-110%);
            }

            100% {
                transform: translateX(260%);
            }
        }

        /* =========================
           RESPONSIVE
        ========================= */

        @media (max-width: 950px) {
            .hero {
                grid-template-columns: 1fr;
                gap: 25px;
                padding-top: 55px;
            }

            .hero-content {
                text-align: center;
            }

            .hero-description {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-highlights {
                justify-content: center;
            }

            .hero-visual {
                min-height: 420px;
            }

            .features-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .workflow-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {
            .navbar {
                padding: 12px 13px 0;
            }

            .navbar-inner {
                min-height: 58px;
                padding: 0 8px 0 12px;
            }

            .brand-icon {
                width: 31px;
                height: 31px;
            }

            .brand-name {
                font-size: 15px;
            }

            .brand-subtitle,
            .system-status {
                display: none;
            }

            .dashboard-button {
                padding: 10px 12px;
                font-size: 10px;
            }

            .hero {
                min-height: auto;
                padding: 48px 18px 38px;
            }

            .hero-title {
                font-size: 66px;
                letter-spacing: -4px;
            }

            .hero-title .audio-title {
                font-size: 11px;
                letter-spacing: 2.6px;
            }

            .hero-title .audio-title::after {
                width: 21px;
                margin-left: 5px;
            }

            .hero-description {
                font-size: 12px;
            }

            .hero-highlights {
                gap: 12px;
            }

            .highlight {
                font-size: 9px;
            }

            .hero-visual {
                min-height: 360px;
            }

            .visual-ring {
                width: 290px;
                height: 290px;
            }

            .preview-card {
                width: calc(100% - 12px);
                padding: 15px;
            }

            .floating-card {
                gap: 6px;
                padding: 8px;
            }

            .floating-card.left {
                left: -7px;
                top: 52px;
            }

            .floating-card.right {
                right: -7px;
                bottom: 47px;
            }

            .floating-icon {
                width: 25px;
                height: 25px;
            }

            .floating-text strong {
                font-size: 9px;
            }

            .floating-text span {
                font-size: 7px;
            }

            .features-section,
            .workflow-inner,
            .cta-section {
                padding-left: 18px;
                padding-right: 18px;
            }

            .features-section {
                padding-top: 48px;
                padding-bottom: 58px;
            }

            .section-title {
                font-size: 31px;
            }

            .features-grid {
                grid-template-columns: 1fr;
            }

            .feature-card {
                min-height: auto;
            }

            .workflow-inner {
                padding-top: 55px;
                padding-bottom: 55px;
            }

            .cta-section {
                padding-top: 55px;
                padding-bottom: 60px;
            }

            .cta-card {
                padding: 35px 24px;
            }

            .footer {
                padding: 24px 18px;
            }

            .footer-inner {
                flex-direction: column;
                text-align: center;
                gap: 10px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                scroll-behavior: auto !important;
                transition-duration: 0.01ms !important;
            }

            .reveal {
                opacity: 1;
                transform: none;
            }
        }
    </style>
</head>

<body>

    <!-- Page loader -->
    <div class="page-loader" id="pageLoader">
        <div>
            <div class="loader-brand">
                <span>expro</span> AUDIO
            </div>

            <div class="loader-track">
                <div class="loader-progress"></div>
            </div>
        </div>
    </div>


    <!-- Background -->
    <div class="page-background">
        <div class="background-grid"></div>
        <div class="glow glow-purple"></div>
        <div class="glow glow-blue"></div>
        <div class="glow glow-pink"></div>
    </div>


    <!-- Navbar -->
    <header class="navbar">
        <div class="navbar-inner">

            <a href="/" class="brand">

                <div class="brand-icon">
                    <svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2"
                        stroke-linecap="round">
                        <path d="M4 9v6"></path>
                        <path d="M8 6v12"></path>
                        <path d="M12 3v18"></path>
                        <path d="M16 6v12"></path>
                        <path d="M20 9v6"></path>
                    </svg>
                </div>

                <div class="brand-text">
                    <div class="brand-name"><span>expro</span></div>
                    <div class="brand-subtitle">AUDIO</div>
                </div>

            </a>

            <div class="navbar-right">

                <div class="system-status">
                    <span class="status-dot"></span>
                    System Ready
                </div>

                <a href="/dashboard" class="dashboard-button">
                    Dashboard

                    <svg viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round">
                        <path d="M5 12h14"></path>
                        <path d="m13 6 6 6-6 6"></path>
                    </svg>
                </a>

            </div>

        </div>
    </header>


    <!-- Main content -->
    <main>

        <!-- Hero -->
        <section class="hero">

            <div class="hero-content reveal">

                <div class="hero-label">
                    <span class="hero-label-dot"></span>
                    SOUND • EVENTS • MANAGEMENT
                </div>

                <h1 class="hero-title">
                    <span class="expro">expro.</span>
                    <span class="audio-title">AUDIO & EVENT MANAGEMENT</span>
                </h1>

                <p class="hero-description">
                    Manage your sound business with clarity. Organize events,
                    track equipment, handle rentals and manage invoices and
                    payments — all in one place.
                </p>

                <div class="hero-actions">
                    <a href="/dashboard" class="primary-button">
                        Enter Dashboard

                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m13 6 6 6-6 6"></path>
                        </svg>
                    </a>
                </div>

                <div class="hero-highlights">

                    <div class="highlight">
                        <span class="highlight-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                <path d="M16 2v4"></path>
                                <path d="M8 2v4"></path>
                                <path d="M3 10h18"></path>
                            </svg>
                        </span>
                        Event Management
                    </div>

                    <div class="highlight">
                        <span class="highlight-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2">
                                <path d="M21 8a2 2 0 0 0-2-2h-4l-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2Z"></path>
                            </svg>
                        </span>
                        Equipment Tracking
                    </div>

                    <div class="highlight">
                        <span class="highlight-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                <path d="M7 9h10"></path>
                                <path d="M7 13h5"></path>
                            </svg>
                        </span>
                        Simple Billing
                    </div>

                </div>

            </div>


            <!-- Audio preview -->
            <div class="hero-visual reveal">

                <div class="visual-ring"></div>


                <div class="floating-card left">

                    <div class="floating-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <path d="M12 2v20"></path>
                            <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H7"></path>
                        </svg>
                    </div>

                    <div class="floating-text">
                        <strong>Billing</strong>
                        <span>Stay organized</span>
                    </div>

                </div>


                <div class="preview-card">

                    <div class="preview-header">

                        <div class="preview-brand">

                            <div class="preview-brand-icon">
                                <svg viewBox="0 0 24 24" fill="none"
                                    stroke="currentColor" stroke-width="2"
                                    stroke-linecap="round">
                                    <path d="M4 9v6"></path>
                                    <path d="M8 6v12"></path>
                                    <path d="M12 3v18"></path>
                                    <path d="M16 6v12"></path>
                                    <path d="M20 9v6"></path>
                                </svg>
                            </div>

                            <div class="preview-brand-text">
                                <strong>expro AUDIO</strong>
                                <span>Sound management workspace</span>
                            </div>

                        </div>

                        <div class="preview-live">
                            <span></span>
                            ACTIVE
                        </div>

                    </div>


                    <div class="wave-container">
                        <div class="waveform">
                            <% for (let i = 0; i < 17; i++) { %>
                                <span class="wave-bar"></span>
                            <% } %>
                        </div>
                    </div>


                    <div class="preview-stats">

                        <div class="preview-stat">
                            <strong>Events</strong>
                            <span>Bookings</span>
                        </div>

                        <div class="preview-stat">
                            <strong>Gear</strong>
                            <span>Equipment</span>
                        </div>

                        <div class="preview-stat">
                            <strong>Bills</strong>
                            <span>Payments</span>
                        </div>

                    </div>

                </div>


                <div class="floating-card right">

                    <div class="floating-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <path d="M4 12h16"></path>
                            <path d="M12 4v16"></path>
                        </svg>
                    </div>

                    <div class="floating-text">
                        <strong>Equipment</strong>
                        <span>Track every unit</span>
                    </div>

                </div>

            </div>

        </section>


        <!-- Features -->
        <section class="features-section">

            <div class="section-heading reveal">

                <div class="section-eyebrow">
                    Everything in one place
                </div>

                <h2 class="section-title">
                    Your business.<br>
                    Better organized.
                </h2>

                <p class="section-description">
                    Essential tools for managing your sound and event
                    operations without unnecessary complexity.
                </p>

            </div>


            <div class="features-grid">

                <article class="feature-card reveal">

                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                            <path d="M16 2v4"></path>
                            <path d="M8 2v4"></path>
                            <path d="M3 10h18"></path>
                        </svg>
                    </div>

                    <h3 class="feature-title">Events</h3>

                    <p class="feature-description">
                        Manage customer bookings, event dates, locations
                        and booking details.
                    </p>

                </article>


                <article class="feature-card reveal">

                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <path d="M21 8a2 2 0 0 0-2-2h-4l-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2Z"></path>
                            <path d="M3 10h18"></path>
                        </svg>
                    </div>

                    <h3 class="feature-title">Equipment</h3>

                    <p class="feature-description">
                        Track available equipment, dispatches, returns
                        and current stock.
                    </p>

                </article>


                <article class="feature-card reveal">

                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <rect x="4" y="5" width="16" height="16" rx="2"></rect>
                            <path d="M8 3v4"></path>
                            <path d="M16 3v4"></path>
                            <path d="M4 11h16"></path>
                        </svg>
                    </div>

                    <h3 class="feature-title">Rentals</h3>

                    <p class="feature-description">
                        Organize equipment rentals and connect stock
                        movements with events.
                    </p>

                </article>


                <article class="feature-card reveal">

                    <div class="feature-icon">
                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2">
                            <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                            <path d="M7 9h10"></path>
                            <path d="M7 13h5"></path>
                        </svg>
                    </div>

                    <h3 class="feature-title">Billing & Payments</h3>

                    <p class="feature-description">
                        Create invoices, record payments and track
                        pending balances clearly.
                    </p>

                </article>

            </div>

        </section>


        <!-- Workflow -->
        <section class="workflow-section">

            <div class="workflow-inner">

                <div class="section-heading reveal">

                    <div class="section-eyebrow">
                        A simple workflow
                    </div>

                    <h2 class="section-title">
                        From booking to payment.
                    </h2>

                    <p class="section-description">
                        Keep every important step connected in one
                        organized workflow.
                    </p>

                </div>


                <div class="workflow-grid">

                    <article class="workflow-card reveal">

                        <div class="workflow-number">01</div>

                        <div class="workflow-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                <path d="M16 2v4"></path>
                                <path d="M8 2v4"></path>
                                <path d="M3 10h18"></path>
                            </svg>
                        </div>

                        <h3>Create an event</h3>

                        <p>
                            Add customer details, event information,
                            date and booking amount.
                        </p>

                    </article>


                    <article class="workflow-card reveal">

                        <div class="workflow-number">02</div>

                        <div class="workflow-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2">
                                <path d="M21 8a2 2 0 0 0-2-2h-4l-2-2H5a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2Z"></path>
                                <path d="M3 10h18"></path>
                            </svg>
                        </div>

                        <h3>Manage equipment</h3>

                        <p>
                            Assign equipment to rentals and track
                            dispatches and returns.
                        </p>

                    </article>


                    <article class="workflow-card reveal">

                        <div class="workflow-number">03</div>

                        <div class="workflow-icon">
                            <svg viewBox="0 0 24 24" fill="none"
                                stroke="currentColor" stroke-width="2">
                                <rect x="3" y="4" width="18" height="17" rx="2"></rect>
                                <path d="M7 9h10"></path>
                                <path d="M7 13h5"></path>
                            </svg>
                        </div>

                        <h3>Invoice & collect</h3>

                        <p>
                            Create invoices, record received payments
                            and track the remaining balance.
                        </p>

                    </article>

                </div>

            </div>

        </section>


        <!-- Final CTA -->
        <section class="cta-section">

            <div class="cta-card reveal">

                <div class="cta-content">

                    <div class="cta-eyebrow">
                        YOUR SOUND BUSINESS, SIMPLIFIED
                    </div>

                    <h2 class="cta-title">
                        Everything connected.<br>
                        Everything under control.
                    </h2>

                    <p class="cta-description">
                        Your events, equipment, rentals and billing
                        in one clear workspace.
                    </p>

                    <a href="/dashboard" class="cta-button">
                        Open Dashboard

                        <svg viewBox="0 0 24 24" fill="none"
                            stroke="currentColor" stroke-width="2"
                            stroke-linecap="round" stroke-linejoin="round">
                            <path d="M5 12h14"></path>
                            <path d="m13 6 6 6-6 6"></path>
                        </svg>
                    </a>

                </div>

            </div>

        </section>

    </main>


    <!-- Footer -->
    <footer class="footer">

        <div class="footer-inner">

            <div class="footer-brand">
                <span>expro</span> AUDIO
            </div>

            <div class="footer-copy">
                © <%= new Date().getFullYear() %> expro AUDIO. All rights reserved.
            </div>

            <div class="footer-tagline">
                Sound. Events. Management.
            </div>

        </div>

    </footer>


    <!-- JavaScript -->
    <script>
        // Page loader
        window.addEventListener("load", () => {
            const loader = document.getElementById("pageLoader");

            setTimeout(() => {
                loader.classList.add("hidden");
            }, 350);
        });


        // Scroll reveal
        const revealElements = document.querySelectorAll(".reveal");

        if ("IntersectionObserver" in window) {
            const observer = new IntersectionObserver(
                (entries, observerInstance) => {
                    entries.forEach((entry) => {
                        if (entry.isIntersecting) {
                            entry.target.classList.add("visible");
                            observerInstance.unobserve(entry.target);
                        }
                    });
                },
                {
                    threshold: 0.12
                }
            );

            revealElements.forEach((element) => {
                observer.observe(element);
            });
        } else {
            revealElements.forEach((element) => {
                element.classList.add("visible");
            });
        }


        // Respect reduced-motion preferences
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
            document.querySelectorAll(".reveal").forEach((element) => {
                element.classList.add("visible");
            });
        }
    </script>

</body>
</html>
    <!-- =========================================================
         JAVASCRIPT
    ========================================================= -->

    <script>

        /* =====================================================
           YEAR
        ===================================================== */

        document.getElementById("year").textContent =
            new Date().getFullYear();


        /* =====================================================
           MOUSE GLOW
        ===================================================== */

        const cursorGlow =
            document.querySelector(".cursor-glow");

        document.addEventListener("mousemove", (e) => {

            cursorGlow.style.left =
                e.clientX + "px";

            cursorGlow.style.top =
                e.clientY + "px";

        });


        /* =====================================================
           PARTICLES
        ===================================================== */

        const particleContainer =
            document.getElementById("particles");

        for (let i = 0; i < 45; i++) {

            const particle =
                document.createElement("span");

            particle.className = "particle";

            particle.style.left =
                Math.random() * 100 + "%";

            particle.style.animationDuration =
                (8 + Math.random() * 15) + "s";

            particle.style.animationDelay =
                (-Math.random() * 15) + "s";

            particle.style.opacity =
                .15 + Math.random() * .5;

            particleContainer.appendChild(
                particle
            );

        }


        /* =====================================================
           PREMIUM AUDIO WAVE
        ===================================================== */

        const canvas =
            document.getElementById("waveCanvas");

        const ctx =
            canvas.getContext("2d");

        let width;
        let height;

        function resizeCanvas() {

            const rect =
                canvas.getBoundingClientRect();

            width =
                canvas.width =
                rect.width *
                window.devicePixelRatio;

            height =
                canvas.height =
                rect.height *
                window.devicePixelRatio;

            ctx.scale(
                window.devicePixelRatio,
                window.devicePixelRatio
            );

            width = rect.width;
            height = rect.height;
        }

        resizeCanvas();

        window.addEventListener(
            "resize",
            resizeCanvas
        );


        let time = 0;


        function drawWave() {

            ctx.clearRect(
                0,
                0,
                width,
                height
            );


            const center =
                height / 2;


            /*
             * Main audio waveform
             */

            ctx.beginPath();

            for (
                let x = 0;
                x < width;
                x += 2
            ) {

                const normalized =
                    x / width;

                const wave =
                    Math.sin(
                        normalized * 18
                        + time
                    ) * 18
                    +

                    Math.sin(
                        normalized * 43
                        - time * 1.7
                    ) * 8
                    +

                    Math.sin(
                        normalized * 90
                        + time * 2
                    ) * 3;

                const fade =
                    Math.sin(
                        normalized * Math.PI
                    );

                const y =
                    center +
                    wave *
                    fade;

                if (x === 0) {

                    ctx.moveTo(x, y);

                } else {

                    ctx.lineTo(x, y);

                }

            }


            ctx.strokeStyle =
                "rgba(114,232,63,.75)";

            ctx.lineWidth = 1.5;

            ctx.shadowBlur = 15;

            ctx.shadowColor =
                "rgba(114,232,63,.7)";

            ctx.stroke();


            /*
             * Secondary wave
             */

            ctx.beginPath();

            for (
                let x = 0;
                x < width;
                x += 3
            ) {

                const normalized =
                    x / width;

                const wave =
                    Math.sin(
                        normalized * 27
                        - time * 1.2
                    ) * 9;

                const fade =
                    Math.sin(
                        normalized * Math.PI
                    );

                const y =
                    center +
                    wave *
                    fade;

                if (x === 0) {

                    ctx.moveTo(x, y);

                } else {

                    ctx.lineTo(x, y);

                }

            }

            ctx.strokeStyle =
                "rgba(165,255,125,.22)";

            ctx.lineWidth = 1;

            ctx.shadowBlur = 0;

            ctx.stroke();


            time += .025;

            requestAnimationFrame(
                drawWave
            );
        }


        drawWave();


    </script>


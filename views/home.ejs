<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>EXPORO AUDIO — Professional Sound Management</title>

    <style>

        /* =========================================================
           RESET
        ========================================================= */

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --green: #72e83f;
            --green2: #a5ff7d;
            --green-dark: #163d16;

            --black: #030504;
            --black2: #070a08;
            --panel: rgba(12, 17, 13, .72);

            --white: #f4f8f3;
            --muted: #849087;
            --muted2: #59645d;

            --border: rgba(255,255,255,.075);
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            background: var(--black);
            color: var(--white);
            font-family:
                Inter,
                Arial,
                Helvetica,
                sans-serif;
            overflow-x: hidden;
        }

        a {
            color: inherit;
            text-decoration: none;
        }


        /* =========================================================
           CURSOR GLOW
        ========================================================= */

        .cursor-glow {
            position: fixed;
            width: 280px;
            height: 280px;

            border-radius: 50%;

            background:
                radial-gradient(
                    circle,
                    rgba(114,232,63,.13),
                    transparent 65%
                );

            transform: translate(-50%, -50%);

            pointer-events: none;
            z-index: 1;

            transition:
                left .12s linear,
                top .12s linear;
        }


        /* =========================================================
           NOISE
        ========================================================= */

        .noise {
            position: fixed;
            inset: 0;

            pointer-events: none;

            z-index: 50;

            opacity: .035;

            background-image:
                url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)' opacity='.7'/%3E%3C/svg%3E");
        }


        /* =========================================================
           LOADER
        ========================================================= */

        .loader {
            position: fixed;
            inset: 0;

            z-index: 9999;

            background: #020302;

            display: flex;
            align-items: center;
            justify-content: center;

            animation:
                loaderExit
                1s
                ease
                2.3s
                forwards;
        }

        .loader-content {
            text-align: center;
        }

        .loader-logo {
            font-size: clamp(45px, 9vw, 90px);

            font-weight: 950;

            letter-spacing: -6px;

            opacity: 0;

            animation:
                loaderLogo
                1.2s
                cubic-bezier(.2,.8,.2,1)
                .15s
                forwards;
        }

        .loader-logo span {
            color: var(--green);

            text-shadow:
                0 0 30px rgba(114,232,63,.55);
        }

        .loader-sub {
            margin-top: 15px;

            color: var(--muted);

            font-size: 10px;

            letter-spacing: 5px;

            opacity: 0;

            animation:
                loaderSub
                1s
                ease
                .8s
                forwards;
        }

        .loader-progress {
            width: 190px;
            height: 2px;

            margin: 25px auto 0;

            background: #101510;

            overflow: hidden;
        }

        .loader-progress::after {
            content: "";

            display: block;

            height: 100%;
            width: 0;

            background: var(--green);

            box-shadow:
                0 0 18px var(--green);

            animation:
                loaderProgress
                1.8s
                ease
                forwards;
        }

        @keyframes loaderLogo {

            from {
                opacity: 0;
                transform: scale(.75);
                filter: blur(18px);
            }

            to {
                opacity: 1;
                transform: scale(1);
                filter: blur(0);
            }
        }

        @keyframes loaderSub {

            from {
                opacity: 0;
                transform: translateY(15px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes loaderProgress {
            to {
                width: 100%;
            }
        }

        @keyframes loaderExit {

            to {
                opacity: 0;
                visibility: hidden;
            }
        }


        /* =========================================================
           BACKGROUND
        ========================================================= */

        .background-grid {
            position: absolute;
            inset: 0;

            background-image:
                linear-gradient(
                    rgba(114,232,63,.055) 1px,
                    transparent 1px
                ),
                linear-gradient(
                    90deg,
                    rgba(114,232,63,.055) 1px,
                    transparent 1px
                );

            background-size: 70px 70px;

            mask-image:
                linear-gradient(
                    to bottom,
                    transparent,
                    black 20%,
                    black 70%,
                    transparent
                );

            animation:
                gridMove
                18s
                linear
                infinite;
        }

        @keyframes gridMove {

            from {
                transform: translateY(0);
            }

            to {
                transform: translateY(70px);
            }
        }


        .orb {
            position: absolute;

            border-radius: 50%;

            filter: blur(90px);

            pointer-events: none;
        }

        .orb-one {
            width: 520px;
            height: 520px;

            left: -250px;
            top: -220px;

            background: rgba(82,220,49,.15);

            animation:
                orbMove
                11s
                ease-in-out
                infinite;
        }

        .orb-two {
            width: 480px;
            height: 480px;

            right: -250px;
            bottom: -250px;

            background: rgba(32,100,255,.11);

            animation:
                orbMove
                13s
                ease-in-out
                infinite
                reverse;
        }

        @keyframes orbMove {

            50% {
                transform:
                    translate(80px,60px)
                    scale(1.12);
            }
        }


        /* =========================================================
           PARTICLES
        ========================================================= */

        .particles {
            position: absolute;
            inset: 0;

            overflow: hidden;

            pointer-events: none;
        }

        .particle {
            position: absolute;

            width: 2px;
            height: 2px;

            background: var(--green);

            border-radius: 50%;

            box-shadow:
                0 0 10px var(--green);

            opacity: .35;

            animation:
                particleFloat
                linear
                infinite;
        }

        @keyframes particleFloat {

            from {
                transform:
                    translateY(100vh)
                    scale(.5);
            }

            to {
                transform:
                    translateY(-20vh)
                    scale(1.4);
            }
        }


        /* =========================================================
           NAVBAR
        ========================================================= */

        .navbar {
            position: absolute;

            top: 0;
            left: 0;

            width: 100%;

            padding:
                28px
                clamp(20px, 6vw, 90px);

            display: flex;

            align-items: center;

            justify-content: space-between;

            z-index: 20;

            animation:
                navReveal
                1s
                ease
                2.5s
                both;
        }

        @keyframes navReveal {

            from {
                opacity: 0;
                transform: translateY(-25px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .brand {
            display: flex;

            align-items: center;

            gap: 12px;
        }

        .brand-icon {
            width: 42px;
            height: 42px;

            border:
                1px solid
                rgba(114,232,63,.55);

            border-radius: 12px;

            display: grid;
            place-items: center;

            color: var(--green);

            font-size: 16px;
            font-weight: 950;

            box-shadow:
                inset 0 0 20px
                rgba(114,232,63,.07),

                0 0 30px
                rgba(114,232,63,.08);
        }

        .brand-name {
            font-size: 16px;

            font-weight: 900;

            letter-spacing: 3px;
        }

        .brand-name span {
            color: var(--green);
        }

        .system {
            display: flex;

            align-items: center;

            gap: 8px;

            font-size: 10px;

            color: var(--muted);

            letter-spacing: 2px;
        }

        .system-dot {
            width: 7px;
            height: 7px;

            border-radius: 50%;

            background: var(--green);

            box-shadow:
                0 0 14px var(--green);

            animation:
                systemPulse
                1.4s
                infinite;
        }

        @keyframes systemPulse {

            50% {
                opacity: .25;
                transform: scale(.7);
            }
        }


        /* =========================================================
           HERO
        ========================================================= */

        .hero {
            min-height: 100vh;

            position: relative;

            display: flex;

            align-items: center;

            justify-content: center;

            text-align: center;

            overflow: hidden;

            padding:
                130px
                20px
                120px;
        }

        .hero-content {
            position: relative;

            z-index: 8;

            width: 100%;

            max-width: 1100px;
        }

        .eyebrow {
            display: inline-flex;

            align-items: center;

            gap: 9px;

            padding:
                9px
                16px;

            border:
                1px solid
                rgba(114,232,63,.22);

            border-radius: 100px;

            background:
                rgba(114,232,63,.045);

            color: #9ca89f;

            font-size: 10px;

            letter-spacing: 2.5px;

            margin-bottom: 28px;

            animation:
                heroReveal
                1s
                ease
                2.55s
                both;
        }

        .eyebrow-dot {
            color: var(--green);

            text-shadow:
                0 0 10px var(--green);
        }


        .hero-title {
            font-size:
                clamp(
                    68px,
                    14vw,
                    180px
                );

            line-height: .78;

            letter-spacing: -10px;

            font-weight: 950;

            margin-bottom: 35px;

            animation:
                heroReveal
                1.1s
                cubic-bezier(.2,.8,.2,1)
                2.65s
                both;
        }

        .hero-title .main {
            color: white;
        }

        .hero-title .accent {
            color: var(--green);

            text-shadow:
                0 0 25px
                rgba(114,232,63,.35),

                0 0 90px
                rgba(114,232,63,.12);
        }

        .hero-title .audio {
            display: block;

            margin-top: 17px;

            font-size:
                clamp(
                    13px,
                    2vw,
                    21px
                );

            letter-spacing:
                clamp(7px, 2vw, 15px);

            color: var(--muted);

            font-weight: 500;
        }


        .hero-description {
            max-width: 690px;

            margin: auto;

            color: var(--muted);

            font-size:
                clamp(15px, 2vw, 19px);

            line-height: 1.75;

            animation:
                heroReveal
                1s
                ease
                2.8s
                both;
        }

        @keyframes heroReveal {

            from {
                opacity: 0;

                transform:
                    translateY(35px)
                    scale(.98);

                filter: blur(9px);
            }

            to {
                opacity: 1;

                transform:
                    translateY(0)
                    scale(1);

                filter: blur(0);
            }
        }


        /* =========================================================
           CTA
        ========================================================= */

        .cta-area {
            margin-top: 38px;

            display: flex;

            justify-content: center;

            gap: 12px;

            animation:
                heroReveal
                1s
                ease
                3s
                both;
        }

        .dashboard-btn {
            position: relative;

            display: inline-flex;

            align-items: center;

            gap: 14px;

            padding:
                16px
                17px
                16px
                25px;

            background: var(--green);

            color: #061006;

            border-radius: 14px;

            font-size: 14px;

            font-weight: 900;

            overflow: hidden;

            box-shadow:
                0 18px 50px
                rgba(114,232,63,.18);

            transition:
                .35s
                cubic-bezier(.2,.8,.2,1);
        }

        .dashboard-btn::before {
            content: "";

            position: absolute;

            top: -80px;
            left: -100px;

            width: 60px;
            height: 220px;

            background:
                rgba(255,255,255,.5);

            transform: rotate(25deg);

            transition:
                .8s ease;
        }

        .dashboard-btn:hover::before {
            left: 130%;
        }

        .dashboard-btn:hover {
            transform:
                translateY(-5px)
                scale(1.025);

            box-shadow:
                0 25px 70px
                rgba(114,232,63,.32);
        }

        .arrow {
            width: 32px;
            height: 32px;

            border-radius: 9px;

            background:
                rgba(0,0,0,.13);

            display: grid;

            place-items: center;

            font-size: 19px;

            transition: .3s;
        }

        .dashboard-btn:hover .arrow {
            transform: translateX(5px);
        }


        /* =========================================================
           SOUND WAVE
        ========================================================= */

        .wave-container {
            position: absolute;

            left: 50%;
            bottom: 75px;

            transform:
                translateX(-50%);

            width:
                min(800px, 90vw);

            height: 100px;

            opacity: .55;

            z-index: 3;
        }

        #waveCanvas {
            width: 100%;
            height: 100%;
        }


        /* =========================================================
           SIDE CARDS
        ========================================================= */

        .floating-card {
            position: absolute;

            width: 205px;

            padding: 19px;

            border:
                1px solid
                var(--border);

            border-radius: 18px;

            background:
                rgba(8,12,9,.65);

            backdrop-filter:
                blur(18px);

            text-align: left;

            box-shadow:
                0 25px 80px
                rgba(0,0,0,.35);

            z-index: 7;

            overflow: hidden;
        }

        .floating-card::before {
            content: "";

            position: absolute;

            inset: 0;

            background:
                linear-gradient(
                    120deg,
                    rgba(114,232,63,.07),
                    transparent 50%
                );

            pointer-events: none;
        }

        .card-left {
            left: 5%;

            top: 38%;

            animation:
                floating
                5s
                ease-in-out
                infinite;
        }

        .card-right {
            right: 5%;

            top: 48%;

            animation:
                floating
                6s
                ease-in-out
                infinite
                reverse;
        }

        .card-icon {
            width: 36px;
            height: 36px;

            border-radius: 10px;

            display: grid;
            place-items: center;

            background:
                rgba(114,232,63,.08);

            border:
                1px solid
                rgba(114,232,63,.15);

            color: var(--green);

            margin-bottom: 13px;

            font-size: 17px;
        }

        .card-title {
            font-size: 13px;

            font-weight: 850;

            margin-bottom: 6px;
        }

        .card-text {
            font-size: 10px;

            line-height: 1.5;

            color: var(--muted2);
        }

        .card-line {
            height: 2px;

            width: 50px;

            margin-top: 15px;

            background: var(--green);

            box-shadow:
                0 0 12px
                var(--green);
        }

        @keyframes floating {

            0%,
            100% {
                transform:
                    translateY(0)
                    rotate(0);
            }

            50% {
                transform:
                    translateY(-18px)
                    rotate(1deg);
            }
        }


        /* =========================================================
           HERO STATS
        ========================================================= */

        .stats {
            position: absolute;

            left: 50%;

            bottom: 16px;

            transform:
                translateX(-50%);

            display: flex;

            align-items: center;

            gap: 25px;

            color: var(--muted2);

            font-size: 9px;

            letter-spacing: 1.5px;

            z-index: 5;

            white-space: nowrap;
        }

        .stat {
            display: flex;

            align-items: center;

            gap: 7px;
        }

        .stat-dot {
            width: 4px;
            height: 4px;

            border-radius: 50%;

            background: var(--green);

            box-shadow:
                0 0 8px var(--green);
        }


        /* =========================================================
           FEATURES SECTION
        ========================================================= */

        .features {
            position: relative;

            padding:
                120px
                7vw;

            background:
                linear-gradient(
                    to bottom,
                    #030504,
                    #060907
                );

            border-top:
                1px solid
                rgba(255,255,255,.045);
        }

        .section-head {
            max-width: 700px;

            margin-bottom: 55px;
        }

        .section-label {
            color: var(--green);

            font-size: 10px;

            letter-spacing: 3px;

            margin-bottom: 16px;
        }

        .section-title {
            font-size:
                clamp(35px, 5vw, 65px);

            letter-spacing: -3px;

            line-height: .95;

            font-weight: 900;
        }

        .section-title span {
            color: var(--muted2);
        }

        .feature-grid {
            display: grid;

            grid-template-columns:
                repeat(4, 1fr);

            gap: 14px;
        }

        .feature {
            min-height: 260px;

            padding: 27px;

            border:
                1px solid
                var(--border);

            border-radius: 22px;

            background:
                linear-gradient(
                    145deg,
                    rgba(16,21,17,.85),
                    rgba(7,10,8,.7)
                );

            position: relative;

            overflow: hidden;

            transition:
                .4s
                cubic-bezier(.2,.8,.2,1);
        }

        .feature::after {
            content: "";

            position: absolute;

            width: 150px;
            height: 150px;

            border-radius: 50%;

            right: -80px;
            bottom: -80px;

            background:
                rgba(114,232,63,.09);

            filter: blur(30px);

            transition: .5s;
        }

        .feature:hover {
            transform:
                translateY(-8px);

            border-color:
                rgba(114,232,63,.25);

            box-shadow:
                0 25px 80px
                rgba(0,0,0,.25);
        }

        .feature:hover::after {
            transform:
                scale(1.7);
        }

        .feature-number {
            color: var(--green);

            font-size: 10px;

            letter-spacing: 2px;

            margin-bottom: 40px;
        }

        .feature-icon {
            font-size: 29px;

            margin-bottom: 20px;
        }

        .feature h3 {
            font-size: 18px;

            margin-bottom: 10px;
        }

        .feature p {
            color: var(--muted);

            font-size: 12px;

            line-height: 1.7;
        }


        /* =========================================================
           CTA SECTION
        ========================================================= */

        .final-cta {
            position: relative;

            padding:
                150px
                20px;

            text-align: center;

            overflow: hidden;
        }

        .final-circle {
            position: absolute;

            width: 500px;
            height: 500px;

            border-radius: 50%;

            border:
                1px solid
                rgba(114,232,63,.08);

            left: 50%;
            top: 50%;

            transform:
                translate(-50%,-50%);

            animation:
                circlePulse
                5s
                ease-in-out
                infinite;
        }

        .final-circle::before,
        .final-circle::after {
            content: "";

            position: absolute;

            inset: 50px;

            border:
                1px solid
                rgba(114,232,63,.06);

            border-radius: 50%;
        }

        .final-circle::after {
            inset: 100px;
        }

        @keyframes circlePulse {

            50% {
                transform:
                    translate(-50%,-50%)
                    scale(1.12);
            }
        }

        .final-content {
            position: relative;

            z-index: 3;
        }

        .final-content h2 {
            font-size:
                clamp(38px, 7vw, 82px);

            letter-spacing: -4px;

            line-height: .95;

            margin-bottom: 22px;
        }

        .final-content h2 span {
            color: var(--green);
        }

        .final-content p {
            color: var(--muted);

            max-width: 520px;

            margin: auto;

            line-height: 1.7;

            font-size: 14px;
        }


        /* =========================================================
           FOOTER
        ========================================================= */

        footer {
            padding:
                28px
                7vw;

            border-top:
                1px solid
                rgba(255,255,255,.05);

            display: flex;

            align-items: center;

            justify-content: space-between;

            color: var(--muted2);

            font-size: 10px;

            letter-spacing: 1px;
        }

        footer strong {
            color: var(--green);
        }


        /* =========================================================
           MOBILE
        ========================================================= */

        @media (max-width: 900px) {

            .floating-card {
                display: none;
            }

            .feature-grid {
                grid-template-columns:
                    repeat(2, 1fr);
            }
        }

        @media (max-width: 600px) {

            .navbar {
                padding: 20px;
            }

            .system {
                display: none;
            }

            .hero {
                padding:
                    130px
                    20px
                    120px;
            }

            .hero-title {
                font-size: 70px;

                letter-spacing:
                    -5px;
            }

            .hero-title .audio {
                font-size: 11px;

                letter-spacing: 6px;
            }

            .hero-description {
                font-size: 14px;
            }

            .feature-grid {
                grid-template-columns: 1fr;
            }

            .features {
                padding:
                    90px
                    20px;
            }

            .stats {
                gap: 10px;

                font-size: 7px;
            }

            .wave-container {
                bottom: 65px;
            }

            footer {
                flex-direction: column;

                gap: 10px;

                text-align: center;
            }
        }

    </style>
</head>


<body>

    <!-- =========================================================
         LOADER
    ========================================================= -->

    <div class="loader">

        <div class="loader-content">

            <div class="loader-logo">
                exporo<span>.</span>
            </div>

            <div class="loader-sub">
                PROFESSIONAL AUDIO SYSTEM
            </div>

            <div class="loader-progress"></div>

        </div>

    </div>


    <!-- CURSOR -->

    <div class="cursor-glow"></div>

    <!-- NOISE -->

    <div class="noise"></div>


    <!-- =========================================================
         NAVBAR
    ========================================================= -->

    <nav class="navbar">

        <a href="/" class="brand">

            <div class="brand-icon">
                X
            </div>

            <div class="brand-name">
                EXPORO <span>AUDIO</span>
            </div>

        </a>


        <div class="system">

            <span class="system-dot"></span>

            SYSTEM ONLINE

        </div>

    </nav>


    <!-- =========================================================
         HERO
    ========================================================= -->

    <section class="hero">

        <!-- Background -->

        <div class="background-grid"></div>

        <div class="orb orb-one"></div>

        <div class="orb orb-two"></div>


        <!-- Particles -->

        <div class="particles" id="particles"></div>


        <!-- Floating Business Card -->

        <div class="floating-card card-left">

            <div class="card-icon">
                ◉
            </div>

            <div class="card-title">
                LIVE EVENTS
            </div>

            <div class="card-text">
                Manage bookings, venues,
                schedules and event operations.
            </div>

            <div class="card-line"></div>

        </div>


        <div class="floating-card card-right">

            <div class="card-icon">
                ◈
            </div>

            <div class="card-title">
                SOUND RENTALS
            </div>

            <div class="card-text">
                Equipment, rentals,
                availability and billing in one system.
            </div>


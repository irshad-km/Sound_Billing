<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Sound Billing | Rentals</title>

    <link rel="stylesheet" href="/css/style.css">

    <style>
        :root {
            --primary: #635bff;
            --primary-dark: #5147e8;
            --primary-light: #f0efff;

            --background: #f5f7fb;
            --surface: #ffffff;

            --text-primary: #172033;
            --text-secondary: #596579;
            --text-muted: #8791a3;

            --border: #e3e8f0;

            --success: #15803d;
            --success-bg: #eaf8ef;

            --warning: #b77908;
            --warning-bg: #fff6df;

            --danger: #dc2626;
            --danger-bg: #fff0f0;

            --radius: 14px;
            --shadow: 0 4px 18px rgba(23, 32, 51, 0.045);
        }

        * {
            box-sizing: border-box;
        }

        html {
            min-height: 100%;
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            min-height: 100vh;
            background: var(--background);
            color: var(--text-primary);
            font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Arial, sans-serif;
            font-size: 14px;
            -webkit-font-smoothing: antialiased;
        }

        button,
        input,
        select {
            font: inherit;
        }

        button {
            -webkit-tap-highlight-color: transparent;
        }

        button:focus-visible,
        input:focus-visible,
        select:focus-visible {
            outline: 3px solid rgba(99, 91, 255, 0.2);
            outline-offset: 2px;
        }

        /* MAIN LAYOUT */

        .app {
            min-height: 100vh;
            width: 100%;
        }

        .main {
            margin-left: 220px;
            width: calc(100% - 220px);
            min-height: 100vh;
            padding: 30px 32px;
            background: var(--background);
        }

        .page-container {
            max-width: 1600px;
            margin: 0 auto;
        }

        /* HEADER */

        .header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            margin-bottom: 28px;
        }

        .header-content {
            min-width: 0;
        }

        .header h1 {
            margin: 0;
            color: var(--text-primary);
            font-size: 28px;
            font-weight: 750;
            letter-spacing: -0.8px;
            line-height: 1.3;
        }

        .header p {
            margin: 8px 0 0;
            color: var(--text-secondary);
            font-size: 14px;
            line-height: 1.6;
        }

        /* BUTTONS */

        .primary-btn,
        .secondary-btn,
        .return-btn,
        .delete-btn,
        .cancel-btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 650;
            cursor: pointer;
            transition:
                background 0.2s ease,
                border-color 0.2s ease,
                color 0.2s ease,
                transform 0.2s ease;
        }

        .primary-btn {
            min-height: 43px;
            padding: 0 17px;
            border: 1px solid var(--primary);
            background: var(--primary);
            color: #fff;
            box-shadow: 0 3px 8px rgba(99, 91, 255, 0.16);
            white-space: nowrap;
        }

        .primary-btn:hover {
            background: var(--primary-dark);
            border-color: var(--primary-dark);
            transform: translateY(-1px);
        }

        .primary-btn:disabled {
            opacity: 0.65;
            cursor: not-allowed;
            transform: none;
        }

        .secondary-btn {
            min-height: 40px;
            padding: 0 14px;
            border: 1px solid var(--border);
            background: #fff;
            color: var(--text-secondary);
        }

        .secondary-btn:hover {
            border-color: #c9c4ff;
            background: var(--primary-light);
            color: var(--primary);
        }

        /* SUMMARY CARDS */

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
            margin-bottom: 26px;
        }

        .summary-card {
            position: relative;
            min-width: 0;
            display: flex;
            align-items: center;
            gap: 16px;
            padding: 22px;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .summary-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(23, 32, 51, 0.07);
        }

        .summary-icon {
            width: 50px;
            height: 50px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 13px;
            font-size: 23px;
        }

        .summary-icon.purple {
            background: #eeecff;
        }

        .summary-icon.orange {
            background: #fff3df;
        }

        .summary-icon.green {
            background: #e7f8ed;
        }

        .summary-info {
            min-width: 0;
        }

        .summary-label {
            display: block;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 550;
            line-height: 1.5;
        }

        .summary-value {
            margin: 6px 0 0;
            color: var(--text-primary);
            font-size: 29px;
            font-weight: 750;
            line-height: 1.2;
            letter-spacing: -0.8px;
        }

        /* PANEL */

        .panel {
            overflow: hidden;
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
        }

        .panel-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 23px 24px;
            border-bottom: 1px solid var(--border);
        }

        .panel-header h2 {
            margin: 0;
            color: var(--text-primary);
            font-size: 18px;
            font-weight: 750;
            letter-spacing: -0.3px;
        }

        .panel-subtitle {
            margin: 7px 0 0;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.5;
        }

        .record-count {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 35px;
            min-height: 30px;
            padding: 0 10px;
            border: 1px solid #e1deff;
            border-radius: 8px;
            background: var(--primary-light);
            color: var(--primary);
            font-size: 13px;
            font-weight: 750;
        }

        /* TABLE */

        .table-wrapper {
            width: 100%;
            overflow-x: auto;
            scrollbar-width: thin;
            scrollbar-color: #cbd2df #f5f7fb;
        }

        table {
            width: 100%;
            min-width: 1060px;
            border-collapse: separate;
            border-spacing: 0;
            text-align: left;
        }

        thead {
            background: #f8f9fc;
        }

        th {
            padding: 16px 17px;
            color: #596579;
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: 0.55px;
            white-space: nowrap;
            border-bottom: 1px solid var(--border);
        }

        td {
            padding: 18px 17px;
            color: var(--text-secondary);
            font-size: 13px;
            font-weight: 450;
            line-height: 1.6;
            vertical-align: middle;
            border-bottom: 1px solid #edf0f5;
        }

        tbody tr {
            transition: background 0.15s ease;
        }

        tbody tr:hover {
            background: #fafaff;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        td strong {
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 700;
        }

        td small {
            display: inline-block;
            margin-top: 3px;
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.5;
        }

        .equipment-name {
            max-width: 200px;
            overflow-wrap: anywhere;
        }

        .amount-cell {
            white-space: nowrap;
            font-weight: 750;
            color: var(--text-primary);
        }

        .quantity-cell {
            color: var(--text-primary);
            font-weight: 700;
        }

        /* TYPE BADGES */

        .type-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 6px 10px;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 700;
            white-space: nowrap;
        }

        .type-event {
            background: #eeecff;
            color: #5147d8;
        }

        .type-personal {
            background: #eaf3ff;
            color: #1d5fc1;
        }

        /* STATUS BADGES */

        .status {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 7px 10px;
            border-radius: 7px;
            font-size: 11px;
            font-weight: 750;
            white-space: nowrap;
        }

        .status::before {
            content: "";
            width: 7px;
            height: 7px;
            flex-shrink: 0;
            border-radius: 50%;
            background: currentColor;
        }

        .status-rented {
            background: var(--warning-bg);
            color: #946200;
        }

        .status-returned {
            background: var(--success-bg);
            color: #16743a;
        }

        /* ACTIONS */

        .actions {
            display: flex;
            align-items: center;
            gap: 8px;
            white-space: nowrap;
        }

        .actions form {
            margin: 0;
        }

        .return-btn,
        .delete-btn {
            min-height: 34px;
            padding: 0 11px;
            border: 1px solid var(--border);
            background: #fff;
            font-size: 12px;
        }

        .return-btn {
            border-color: #bde8ca;
            color: #16803d;
        }

        .return-btn:hover {
            background: var(--success-bg);
            border-color: #86d7a1;
        }

        .delete-btn {
            border-color: #ffd0d0;
            color: var(--danger);
        }

        .delete-btn:hover {
            background: var(--danger-bg);
            border-color: #ffb4b4;
        }

        /* EMPTY STATE */

        .empty-state {
            padding: 64px 20px !important;
            text-align: center;
        }

        .empty-state-icon {
            width: 66px;
            height: 66px;
            margin: 0 auto 17px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 18px;
            background: var(--primary-light);
            font-size: 30px;
        }

        .empty-state h3 {
            margin: 0;
            color: var(--text-primary);
            font-size: 17px;
            font-weight: 750;
        }

        .empty-state p {
            margin: 9px 0 0;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.6;
        }

        .empty-state .primary-btn {
            margin-top: 19px;
        }

        /* MODALS */

        .modal,
        .confirm-modal {
            position: fixed;
            inset: 0;
            z-index: 2000;
            display: none;
            align-items: center;
            justify-content: center;
            padding: 20px;
            background: rgba(15, 23, 42, 0.58);
            backdrop-filter: blur(4px);
        }

        .modal.show,
        .confirm-modal.show {
            display: flex;
        }

        .modal-content {
            width: min(650px, 100%);
            max-height: 92vh;
            overflow-y: auto;
            background: #fff;
            border: 1px solid rgba(255, 255, 255, 0.7);
            border-radius: 17px;
            box-shadow: 0 25px 80px rgba(0, 0, 0, 0.22);
            animation: modalAppear 0.18s ease-out;
        }

        @keyframes modalAppear {
            from {
                opacity: 0;
                transform: translateY(8px) scale(0.99);
            }

            to {
                opacity: 1;
                transform: translateY(0) scale(1);
            }
        }

        .modal-header {
            position: sticky;
            top: 0;
            z-index: 2;
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 18px;
            padding: 23px 25px;
            background: #fff;
            border-bottom: 1px solid var(--border);
        }

        .modal-header h2 {
            margin: 0;
            color: var(--text-primary);
            font-size: 20px;
            font-weight: 750;
            letter-spacing: -0.4px;
        }

        .modal-header p {
            margin: 7px 0 0;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.5;
        }

        .close-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            flex-shrink: 0;
            border: 1px solid var(--border);
            border-radius: 9px;
            background: #f8f9fc;
            color: var(--text-secondary);
            font-size: 23px;
            cursor: pointer;
        }

        .close-btn:hover {
            background: var(--primary-light);
            color: var(--primary);
        }

        /* FORM */

        #rentalForm {
            padding: 25px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 20px;
        }

        .form-group {
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .form-group.full {
            grid-column: 1 / -1;
        }

        .form-group label {
            color: #344054;
            font-size: 13px;
            font-weight: 700;
        }

        .form-group input,
        .form-group select {
            width: 100%;
            min-width: 0;
            height: 45px;
            padding: 0 13px;
            border: 1px solid #d6dce7;
            border-radius: 9px;
            outline: none;
            background: #fff;
            color: var(--text-primary);
            font-size: 13px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

        .form-group input::placeholder {
            color: #9aa3b2;
        }

        .form-group input:focus,
        .form-group select:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(99, 91, 255, 0.1);
        }

        .form-group input[readonly] {
            background: #f7f8fc;
            color: var(--text-primary);
            font-weight: 650;
        }

        .form-group select:disabled,
        .form-group input:disabled {
            background: #f1f3f7;
            color: #7a8494;
            cursor: not-allowed;
        }

        .form-help {
            color: var(--text-secondary);
            font-size: 12px;
            line-height: 1.5;
        }

        /* FIELD ERRORS */

        .input-error {
            border-color: #ef4444 !important;
            background: #fff8f8 !important;
            box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.07) !important;
        }

        .error-message {
            display: none;
            margin-top: -2px;
            color: #dc2626;
            font-size: 12px;
            font-weight: 550;
            line-height: 1.5;
        }

        .error-message.show {
            display: block;
        }

        .form-error-box {
            display: none;
            margin-bottom: 22px;
            padding: 13px 15px;
            border: 1px solid #fecaca;
            border-radius: 9px;
            background: #fff5f5;
            color: #b91c1c;
            font-size: 13px;
            font-weight: 600;
            line-height: 1.6;
        }

        .form-error-box.show {
            display: block;
        }

        /* AMOUNT PREVIEW */

        .amount-preview {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
            padding: 19px;
            border: 1px solid #dedaff;
            border-radius: 12px;
            background: linear-gradient(135deg, #f5f3ff, #faf9ff);
        }

        .amount-preview span {
            color: #514d70;
            font-size: 13px;
            font-weight: 650;
        }

        .amount-preview strong {
            color: var(--primary);
            font-size: 23px;
            font-weight: 800;
            letter-spacing: -0.4px;
            overflow-wrap: anywhere;
        }

        /* MODAL FOOTER */

        .modal-footer {
            position: sticky;
            bottom: 0;
            display: flex;
            justify-content: flex-end;
            gap: 11px;
            margin-top: 25px;
            padding-top: 20px;
            background: #fff;
            border-top: 1px solid var(--border);
        }

        .cancel-btn {
            min-height: 43px;
            padding: 0 17px;
            border: 1px solid var(--border);
            background: #fff;
            color: var(--text-secondary);
        }

        .cancel-btn:hover {
            background: #f5f6f9;
        }

        /* CONFIRMATION MODALS */

        .confirm-modal {
            z-index: 3000;
        }

        .confirm-box {
            width: min(420px, 100%);
            padding: 27px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 17px;
            box-shadow: 0 25px 75px rgba(0, 0, 0, 0.22);
            animation: modalAppear 0.18s ease-out;
        }

        .confirm-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 53px;
            height: 53px;
            margin-bottom: 19px;
            border-radius: 14px;
            font-size: 25px;
        }

        .delete-confirm-icon {
            background: var(--danger-bg);
            color: var(--danger);
        }

        .return-confirm-icon {
            background: var(--success-bg);
            color: var(--success);
        }

        .confirm-box h3 {
            margin: 0;
            color: var(--text-primary);
            font-size: 20px;
            font-weight: 750;
            letter-spacing: -0.4px;
        }

        .confirm-box p {
            margin: 10px 0 0;
            color: var(--text-secondary);
            font-size: 13px;
            line-height: 1.7;
        }

        .confirm-item {
            margin-top: 17px;
            padding: 13px 14px;
            overflow-wrap: anywhere;
            border: 1px solid var(--border);
            border-radius: 10px;
            background: #f8f9fc;
            color: var(--text-primary);
            font-size: 13px;
            font-weight: 650;
            line-height: 1.6;
        }

        .confirm-actions {
            display: flex;
            justify-content: flex-end;
            flex-wrap: wrap;
            gap: 10px;
            margin-top: 24px;
        }

        .confirm-cancel,
        .confirm-delete,
        .confirm-return {
            min-height: 40px;
            padding: 0 15px;
            border: none;
            border-radius: 9px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.2s ease;
        }

        .confirm-cancel {
            background: #f0f2f6;
            color: #344054;
        }

        .confirm-cancel:hover {
            background: #e2e6ed;
        }

        .confirm-delete {
            background: var(--danger);
            color: #fff;
        }

        .confirm-delete:hover {
            background: #b91c1c;
        }

        .confirm-return {
            background: var(--success);
            color: #fff;
        }

        .confirm-return:hover {
            background: #166534;
        }

        /* UTILITIES */

        .hidden {
            display: none !important;
        }

        body.modal-open {
            overflow: hidden;
        }

        input[type="number"]::-webkit-inner-spin-button,
        input[type="number"]::-webkit-outer-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }

        input[type="number"] {
            -moz-appearance: textfield;
            appearance: textfield;
        }

        /* RESPONSIVE */

        @media (max-width: 1200px) {
            .main {
                padding: 26px 22px;
            }

            .summary-card {
                padding: 19px;
            }

            .summary-value {
                font-size: 26px;
            }
        }

        @media (max-width: 950px) {
            .main {
                margin-left: 0;
                width: 100%;
                padding: 24px 20px;
            }

            .summary-grid {
                gap: 13px;
            }

            .summary-card {
                gap: 12px;
                padding: 17px;
            }

            .summary-icon {
                width: 44px;
                height: 44px;
                font-size: 20px;
            }

            .summary-label {
                font-size: 12px;
            }

            .summary-value {
                font-size: 25px;
            }
        }

        @media (max-width: 650px) {
            .main {
                padding: 20px 13px;
            }

            .header {
                align-items: stretch;
                flex-direction: column;
                gap: 17px;
                margin-bottom: 23px;
            }

            .header h1 {
                font-size: 25px;
            }

            .header p {
                font-size: 13px;
            }

            .header .primary-btn {
                width: 100%;
            }

            .summary-grid {
                grid-template-columns: 1fr;
                gap: 12px;
                margin-bottom: 20px;
            }

            .summary-card {
                padding: 18px;
            }

            .summary-value {
                font-size: 26px;
            }

            .panel-header {
                align-items: flex-start;
                padding: 19px 17px;
            }

            .panel-header h2 {
                font-size: 17px;
            }

            .panel-subtitle {
                font-size: 12px;
            }

            th {
                padding: 14px;
            }

            td {
                padding: 16px 14px;
            }

            .modal {
                padding: 10px;
            }

            .modal-content {
                max-height: 95vh;
                border-radius: 13px;
            }

            .modal-header {
                padding: 19px 17px;
            }

            .modal-header h2 {
                font-size: 18px;
            }

            #rentalForm {
                padding: 19px 17px;
            }

            .form-grid {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .form-group.full {
                grid-column: auto;
            }

            .form-group input,
            .form-group select {
                height: 46px;
                font-size: 14px;
            }

            .amount-preview {
                padding: 16px;
            }

            .amount-preview strong {
                font-size: 20px;
            }

            .modal-footer {
                gap: 9px;
                padding-top: 16px;
            }

            .modal-footer button {
                flex: 1;
                padding: 0 10px;
            }

            .confirm-box {
                padding: 22px;
            }

            .confirm-actions button {
                flex: 1;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                animation-duration: 0.01ms !important;
                transition-duration: 0.01ms !important;
            }
        }
    </style>
</head>

<body>

<div class="app">

    <%- include("partials/sidebar") %>

    <main class="main">
        <div class="page-container">

            <!-- HEADER -->

            <header class="header">
                <div class="header-content">
                    <h1>Rentals</h1>
                    <p>Manage equipment rentals, usage and returns.</p>
                </div>

                <button
                    type="button"
                    class="primary-btn"
                    onclick="openRentalModal()"
                >
                    <span aria-hidden="true">＋</span>
                    Add Rental
                </button>
            </header>

            <!-- SUMMARY CARDS -->

            <section class="summary-grid" aria-label="Rental summary">

                <article class="summary-card">
                    <div class="summary-icon purple" aria-hidden="true">
                        📦
                    </div>

                    <div class="summary-info">
                        <span class="summary-label">Total Rentals</span>

                        <h2 class="summary-value">
                            <%= rentals.length %>
                        </h2>
                    </div>
                </article>

                <article class="summary-card">
                    <div class="summary-icon orange" aria-hidden="true">
                        🔊
                    </div>

                    <div class="summary-info">
                        <span class="summary-label">Currently Rented</span>

                        <h2 class="summary-value">
                            <%= rentals.filter(
                                rental => rental.status === "Rented"
                            ).length %>
                        </h2>
                    </div>
                </article>

                <article class="summary-card">
                    <div class="summary-icon green" aria-hidden="true">
                        ✓
                    </div>

                    <div class="summary-info">
                        <span class="summary-label">Returned</span>

                        <h2 class="summary-value">
                            <%= rentals.filter(
                                rental => rental.status === "Returned"
                            ).length %>
                        </h2>
                    </div>
                </article>

            </section>

            <!-- RENTAL TABLE -->

            <section class="panel">

                <div class="panel-header">
                    <div>
                        <h2>Rental List</h2>

                        <p class="panel-subtitle">
                            Track equipment, rental duration, stock usage and returns.
                        </p>
                    </div>

                    <span class="record-count">
                        <%= rentals.length %>
                    </span>
                </div>

                <div class="table-wrapper">
                    <table>
                        <thead>
                            <tr>
                                <th>Type</th>
                                <th>Name / Event</th>
                                <th>Equipment</th>
                                <th>Quantity</th>
                                <th>Duration</th>
                                <th>Rental Amount</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            <% if (rentals.length === 0) { %>

                                <tr>
                                    <td colspan="8" class="empty-state">

                                        <div class="empty-state-icon" aria-hidden="true">
                                            📦
                                        </div>

                                        <h3>No rentals yet</h3>

                                        <p>
                                            Your rental records will appear here.
                                            Create your first rental to get started.
                                        </p>

                                        <button
                                            type="button"
                                            class="primary-btn"
                                            onclick="openRentalModal()"
                                        >
                                            ＋ Add Your First Rental
                                        </button>

                                    </td>
                                </tr>

                            <% } else { %>

                                <% rentals.forEach(rental => { %>

                                    <tr>

                                        <!-- RENTAL TYPE -->

                                        <td>
                                            <% if (rental.rentalType === "Personal") { %>

                                                <span class="type-badge type-personal">
                                                    Personal
                                                </span>

                                            <% } else { %>

                                                <span class="type-badge type-event">
                                                    Event
                                                </span>

                                            <% } %>
                                        </td>

                                        <!-- NAME / EVENT -->

                                        <td>
                                            <% if (rental.rentalType === "Personal") { %>

                                                <strong>
                                                    <%= rental.personalName || "Personal Use" %>
                                                </strong>

                                                <br>

                                                <small>Personal rental</small>

                                            <% } else if (rental.booking) { %>

                                                <strong>
                                                    <%= rental.booking.eventType || "Event" %>
                                                </strong>

                                                <br>

                                                <small>
                                                    <%= rental.booking.location || "Location not specified" %>
                                                </small>

                                            <% } else { %>

                                                <strong>Event</strong>

                                                <br>

                                                <small>Booking unavailable</small>

                                            <% } %>
                                        </td>

                                        <!-- EQUIPMENT -->

                                        <td>
                                            <% if (rental.equipment) { %>

                                                <strong class="equipment-name">
                                                    <%= rental.equipment.name %>
                                                </strong>

                                                <br>

                                                <small>
                                                    ₹<%= Number(
                                                        rental.equipment.rentalPrice || 0
                                                    ).toLocaleString("en-IN") %> / day
                                                </small>

                                            <% } else { %>

                                                <strong>Unavailable</strong>

                                                <br>

                                                <small>Equipment record not found</small>

                                            <% } %>
                                        </td>

                                        <!-- QUANTITY -->

                                        <td>
                                            <strong class="quantity-cell">
                                                <%= rental.quantity %>
                                            </strong>
                                        </td>

                                        <!-- DAYS -->

                                        <td>
                                            <strong>
                                                <%= rental.days || 1 %>
                                            </strong>

                                            <small>
                                                day<%= Number(rental.days || 1) > 1 ? "s" : "" %>
                                            </small>
                                        </td>

                                        <!-- AMOUNT -->

                                        <td class="amount-cell">
                                            ₹<%= Number(
                                                rental.rentalAmount || 0
                                            ).toLocaleString("en-IN") %>
                                        </td>

                                        <!-- STATUS -->

                                        <td>
                                            <% if (rental.status === "Rented") { %>

                                                <span class="status status-rented">
                                                    Rented
                                                </span>

                                            <% } else { %>

                                                <span class="status status-returned">
                                                    Returned
                                                </span>

                                            <% } %>
                                        </td>

                                        <!-- ACTIONS -->

                                        <td>
                                            <div class="actions">

                                                <% if (rental.status === "Rented") { %>

                                                    <form
                                                        class="return-form"
                                                        action="/rentals/return/<%= rental._id %>"
                                                        method="POST"
                                                        data-equipment="<%= rental.equipment ? rental.equipment.name : 'this equipment' %>"
                                                    >
                                                        <button
                                                            type="button"
                                                            class="return-btn"
                                                            onclick="openReturnConfirm(this)"
                                                        >
                                                            Return
                                                        </button>
                                                    </form>

                                                <% } %>

                                                <form
                                                    class="delete-form"
                                                    action="/rentals/delete/<%= rental._id %>"
                                                    method="POST"
                                                    data-equipment="<%= rental.equipment ? rental.equipment.name : 'this rental' %>"
                                                >
                                                    <button
                                                        type="button"
                                                        class="delete-btn"
                                                        onclick="openDeleteConfirm(this)"
                                                    >
                                                        Delete
                                                    </button>
                                                </form>

                                            </div>
                                        </td>

                                    </tr>

                                <% }) %>

                            <% } %>

                        </tbody>
                    </table>
                </div>

            </section>

        </div>
    </main>

</div>

<!-- ADD RENTAL MODAL -->

<div
    id="rentalModal"
    class="modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="rentalModalTitle"
>
    <div class="modal-content">

        <div class="modal-header">
            <div>
                <h2 id="rentalModalTitle">Add Rental</h2>

                <p>
                    Enter the rental details and equipment quantity.
                </p>
            </div>

            <button
                type="button"
                class="close-btn"
                onclick="closeRentalModal()"
                aria-label="Close rental form"
            >
                ×
            </button>
        </div>

        <form id="rentalForm" action="/rentals/add" method="POST">

            <div
                id="formErrorBox"
                class="form-error-box"
                role="alert"
                aria-live="polite"
            ></div>

            <div class="form-grid">

                <!-- RENTAL TYPE -->

                <div class="form-group full">

                    <label for="rentalType">Rental Type *</label>

                    <select name="rentalType" id="rentalType" required>
                        <option value="">Select rental type</option>
                        <option value="Personal">Personal Use</option>
                        <option value="Event">Event</option>
                    </select>

                    <span id="rentalTypeError" class="error-message">
                        Please select a rental type.
                    </span>
                </div>

                <!-- PERSONAL NAME -->

                <div
                    class="form-group full hidden"
                    id="personalNameGroup"
                >
                    <label for="personalName">Personal Name *</label>

                    <input
                        type="text"
                        name="personalName"
                        id="personalName"
                        placeholder="Enter person's name"
                        maxlength="120"
                        disabled
                    >

                    <span id="personalNameError" class="error-message">
                        Please enter the personal name.
                    </span>
                </div>

                <!-- EVENT -->

                <div
                    class="form-group full hidden"
                    id="eventGroup"
                >
                    <label for="bookingSelect">Event *</label>

                    <select
                        name="booking"
                        id="bookingSelect"
                        disabled
                    >
                        <option value="">Select event</option>

                        <% bookings.forEach(booking => { %>

                            <option value="<%= booking._id %>">
                                <%= booking.eventType || "Event" %>
                                —
                                <%= booking.customer
                                    ? booking.customer.name || "Customer"
                                    : "Customer" %>
                                —
                                <%= booking.eventDate
                                    ? new Date(booking.eventDate).toLocaleDateString("en-IN")
                                    : "Date not set" %>
                            </option>

                        <% }) %>

                    </select>

                    <span id="bookingError" class="error-message">
                        Please select an event.
                    </span>
                </div>

                <!-- EQUIPMENT -->

                <div class="form-group full">

                    <label for="equipmentSelect">Equipment *</label>

                    <select name="equipment" id="equipmentSelect" required>

                        <option value="">Select equipment</option>

                        <% equipments.forEach(item => { %>

                            <option
                                value="<%= item._id %>"
                                data-available="<%= item.availableQuantity || 0 %>"
                                data-rental-price="<%= item.rentalPrice || 0 %>"
                            >
                                <%= item.name %>
                                — Available: <%= item.availableQuantity || 0 %>
                            </option>

                        <% }) %>

                    </select>

                    <span id="equipmentError" class="error-message">
                        Please select equipment.
                    </span>

                    <span class="form-help" id="availabilityText">
                        Select equipment to see available stock and daily price.
                    </span>
                </div>

                <!-- QUANTITY -->

                <div class="form-group">

                    <label for="quantityInput">Quantity *</label>

                    <input
                        type="number"
                        name="quantity"
                        id="quantityInput"
                        min="1"
                        step="1"
                        placeholder="Enter quantity"
                        inputmode="numeric"
                        required
                    >

                    <span id="quantityError" class="error-message">
                        Please enter a valid quantity.
                    </span>
                </div>

                <!-- DAYS -->

                <div class="form-group">

                    <label for="daysInput">Rental Days *</label>

                    <input
                        type="number"
                        name="days"
                        id="daysInput"
                        min="1"
                        step="1"
                        placeholder="Enter rental days"
                        inputmode="numeric"
                        required
                    >

                    <span id="daysError" class="error-message">
                        Rental days must be at least 1.
                    </span>

                    <span class="form-help">
                        Number of days the equipment will be used.
                    </span>
                </div>

                <!-- PRICE PER DAY -->

                <div class="form-group">

                    <label for="rentalPriceInput">
                        Rental Price / Day
                    </label>

                    <input
                        type="number"
                        id="rentalPriceInput"
                        min="0"
                        step="0.01"
                        placeholder="₹ 0.00"
                        readonly
                    >
                </div>

                <!-- TOTAL -->

                <div class="form-group">

                    <label for="rentalAmountInput">
                        Total Rental Amount
                    </label>

                    <input
                        type="number"
                        name="rentalAmount"
                        id="rentalAmountInput"
                        min="0"
                        step="0.01"
                        placeholder="₹ 0.00"
                        readonly
                    >
                </div>

                <!-- AMOUNT PREVIEW -->

                <div class="form-group full">

                    <div class="amount-preview">
                        <span>Estimated Rental Total</span>

                        <strong id="amountPreview">₹0.00</strong>
                    </div>

                </div>

            </div>

            <!-- FOOTER -->

            <div class="modal-footer">

                <button
                    type="button"
                    class="cancel-btn"
                    onclick="closeRentalModal()"
                >
                    Cancel
                </button>

                <button
                    type="submit"
                    id="saveRentalButton"
                    class="primary-btn"
                >
                    Save Rental
                </button>

            </div>

        </form>

    </div>
</div>

<!-- DELETE CONFIRMATION -->

<div
    id="deleteConfirmModal"
    class="confirm-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="deleteConfirmTitle"
>
    <div class="confirm-box">

        <div class="confirm-icon delete-confirm-icon" aria-hidden="true">
            🗑️
        </div>

        <h3 id="deleteConfirmTitle">Delete Rental?</h3>

        <p>
            Are you sure you want to delete this rental?
            This action cannot be undone.
        </p>

        <div id="deleteConfirmItem" class="confirm-item">
            Equipment
        </div>

        <div class="confirm-actions">

            <button
                type="button"
                class="confirm-cancel"
                onclick="closeDeleteConfirm()"
            >
                Cancel
            </button>

            <button
                type="button"
                class="confirm-delete"
                onclick="submitDelete()"
            >
                Delete Rental
            </button>

        </div>
    </div>
</div>

<!-- RETURN CONFIRMATION -->

<div
    id="returnConfirmModal"
    class="confirm-modal"
    role="dialog"
    aria-modal="true"
    aria-labelledby="returnConfirmTitle"
>
    <div class="confirm-box">

        <div class="confirm-icon return-confirm-icon" aria-hidden="true">
            ✓
        </div>

        <h3 id="returnConfirmTitle">Return Equipment?</h3>

        <p>
            Mark this rental as returned?
            The equipment should be added back to available stock.
        </p>

        <div id="returnConfirmItem" class="confirm-item">
            Equipment
        </div>

        <div class="confirm-actions">

            <button
                type="button"
                class="confirm-cancel"
                onclick="closeReturnConfirm()"
            >
                Cancel
            </button>

            <button
                type="button"
                class="confirm-return"
                onclick="submitReturn()"
            >
                Mark as Returned
            </button>

        </div>
    </div>
</div>

<script>
    "use strict";

    /* =========================================================
       ELEMENTS
    ========================================================= */

    const rentalModal = document.getElementById("rentalModal");
    const rentalForm = document.getElementById("rentalForm");

    const rentalType = document.getElementById("rentalType");
    const rentalTypeError = document.getElementById("rentalTypeError");

    const personalNameGroup = document.getElementById("personalNameGroup");
    const personalName = document.getElementById("personalName");
    const personalNameError = document.getElementById("personalNameError");

    const eventGroup = document.getElementById("eventGroup");
    const bookingSelect = document.getElementById("bookingSelect");
    const bookingError = document.getElementById("bookingError");

    const equipmentSelect = document.getElementById("equipmentSelect");
    const equipmentError = document.getElementById("equipmentError");

    const quantityInput = document.getElementById("quantityInput");
    const quantityError = document.getElementById("quantityError");

    const daysInput = document.getElementById("daysInput");
    const daysError = document.getElementById("daysError");

    const rentalPriceInput = document.getElementById("rentalPriceInput");
    const rentalAmountInput = document.getElementById("rentalAmountInput");
    const amountPreview = document.getElementById("amountPreview");

    const availabilityText = document.getElementById("availabilityText");
    const formErrorBox = document.getElementById("formErrorBox");
    const saveRentalButton = document.getElementById("saveRentalButton");

    const deleteConfirmModal = document.getElementById("deleteConfirmModal");
    const deleteConfirmItem = document.getElementById("deleteConfirmItem");

    const returnConfirmModal = document.getElementById("returnConfirmModal");
    const returnConfirmItem = document.getElementById("returnConfirmItem");

    let selectedDeleteForm = null;
    let selectedReturnForm = null;
    let lastFocusedElement = null;
    let isSubmitting = false;

    const DEFAULT_AVAILABILITY_TEXT =
        "Select equipment to see available stock and daily price.";

    /* =========================================================
       HELPERS
    ========================================================= */

    function formatCurrency(amount) {
        return "₹" + Number(amount || 0).toLocaleString("en-IN", {
            minimumFractionDigits: 2,
            maximumFractionDigits: 2
        });
    }

    function openModal(modal) {
        lastFocusedElement = document.activeElement;

        modal.classList.add("show");
        document.body.classList.add("modal-open");

        const firstInput = modal.querySelector(
            "input:not([disabled]), select:not([disabled]), button"
        );

        if (firstInput) {
            setTimeout(() => firstInput.focus(), 50);
        }
    }

    function updateBodyModalState() {
        const anyModalOpen = [
            rentalModal,
            deleteConfirmModal,
            returnConfirmModal
        ].some(modal => modal.classList.contains("show"));

        document.body.classList.toggle("modal-open", anyModalOpen);
    }

    function closeModal(modal) {
        modal.classList.remove("show");
        updateBodyModalState();

        if (lastFocusedElement && typeof lastFocusedElement.focus === "function") {
            lastFocusedElement.focus();
        }
    }

    /* =========================================================
       FORM ERRORS
    ========================================================= */

    function clearFormErrors() {
        formErrorBox.textContent = "";
        formErrorBox.classList.remove("show");

        const fields = [
            rentalType,
            personalName,
            bookingSelect,
            equipmentSelect,
            quantityInput,
            daysInput
        ];

        fields.forEach(field => {
            if (field) {
                field.classList.remove("input-error");
                field.removeAttribute("aria-invalid");
            }
        });

        const errors = [
            rentalTypeError,
            personalNameError,
            bookingError,
            equipmentError,
            quantityError,
            daysError
        ];

        errors.forEach(error => {
            if (error) {
                error.classList.remove("show");
            }
        });
    }

    function showFormError(message) {
        formErrorBox.textContent = message;
        formErrorBox.classList.add("show");
    }

    function showFieldError(input, errorElement, message) {
        input.classList.add("input-error");
        input.setAttribute("aria-invalid", "true");

        errorElement.textContent = message;
        errorElement.classList.add("show");
    }

    function clearFieldError(input, errorElement) {
        input.classList.remove("input-error");
        input.removeAttribute("aria-invalid");

        errorElement.classList.remove("show");
    }

    /* =========================================================
       VALIDATE RENTAL TYPE
    ========================================================= */

    function validateRentalType() {
        if (!rentalType.value) {
            showFieldError(
                rentalType,
                rentalTypeError,
                "Please select a rental type."
            );

            return false;
        }

        clearFieldError(rentalType, rentalTypeError);
        return true;
    }

    /* =========================================================
       VALIDATE PERSONAL NAME
    ========================================================= */

    function validatePersonalName() {
        if (
            rentalType.value === "Personal" &&
            !personalName.value.trim()
        ) {
            showFieldError(
                personalName,
                personalNameError,
                "Please enter the personal name."
            );

            return false;
        }

        clearFieldError(personalName, personalNameError);
        return true;
    }

    /* =========================================================
       VALIDATE EVENT
    ========================================================= */

    function validateEvent() {
        if (
            rentalType.value === "Event" &&
            !bookingSelect.value
        ) {
            showFieldError(
                bookingSelect,
                bookingError,
                "Please select an event."
            );

            return false;
        }

        clearFieldError(bookingSelect, bookingError);
        return true;
    }

    /* =========================================================
       VALIDATE EQUIPMENT
    ========================================================= */

    function validateEquipment() {
        if (!equipmentSelect.value) {
            showFieldError(
                equipmentSelect,
                equipmentError,
                "Please select equipment."
            );

            return false;
        }

        clearFieldError(equipmentSelect, equipmentError);
        return true;
    }

    /* =========================================================
       VALIDATE QUANTITY
    ========================================================= */

    function validateQuantity() {
        const value = quantityInput.value.trim();
        const quantity = Number(value);

        const selectedOption =
            equipmentSelect.options[equipmentSelect.selectedIndex];

        if (value === "") {
            showFieldError(
                quantityInput,
                quantityError,
                "Please enter quantity."
            );

            return false;
        }

        if (!Number.isSafeInteger(quantity) || quantity <= 0) {
            showFieldError(
                quantityInput,
                quantityError,
                "Quantity must be a whole number greater than 0."
            );

            return false;
        }

        if (!equipmentSelect.value || !selectedOption) {
            showFieldError(
                quantityInput,
                quantityError,
                "Select equipment before entering quantity."
            );

            return false;
        }

        const available = Number(selectedOption.dataset.available || 0);

        if (!Number.isFinite(available) || available <= 0) {
            showFieldError(
                quantityInput,
                quantityError,
                "This equipment is currently unavailable."
            );

            return false;
        }

        if (quantity > available) {
            showFieldError(
                quantityInput,
                quantityError,
                "Only " + available + " unit(s) available."
            );

            return false;
        }

        clearFieldError(quantityInput, quantityError);
        return true;
    }

    /* =========================================================
       VALIDATE DAYS
    ========================================================= */

    function validateDays() {
        const value = daysInput.value.trim();
        const days = Number(value);

        if (value === "") {
            showFieldError(
                daysInput,
                daysError,
                "Please enter rental days."
            );

            return false;
        }

        if (!Number.isSafeInteger(days) || days <= 0) {
            showFieldError(
                daysInput,
                daysError,
                "Rental days must be a whole number greater than 0."
            );

            return false;
        }

        clearFieldError(daysInput, daysError);
        return true;
    }

    /* =========================================================
       OPEN RENTAL MODAL
    ========================================================= */

    function openRentalModal() {
        rentalForm.reset();
        isSubmitting = false;

        saveRentalButton.disabled = false;
        saveRentalButton.textContent = "Save Rental";

        rentalType.value = "";

        personalNameGroup.classList.add("hidden");
        eventGroup.classList.add("hidden");

        personalName.disabled = true;
        personalName.required = false;

        bookingSelect.disabled = true;
        bookingSelect.required = false;
        bookingSelect.value = "";

        equipmentSelect.value = "";

        quantityInput.value = "";
        quantityInput.removeAttribute("max");

        daysInput.value = "";

        rentalPriceInput.value = "";
        rentalAmountInput.value = "";

        amountPreview.textContent = formatCurrency(0);
        availabilityText.textContent = DEFAULT_AVAILABILITY_TEXT;

        clearFormErrors();

        rentalModal.querySelector("#rentalModalTitle").textContent = "Add Rental";
        rentalForm.action = "/rentals/add";

        openModal(rentalModal);
    }

    /* =========================================================
       CLOSE RENTAL MODAL
    ========================================================= */

    function closeRentalModal() {
        closeModal(rentalModal);
        clearFormErrors();
    }

    /* =========================================================
       RENTAL TYPE CHANGE
    ========================================================= */

    rentalType.addEventListener("change", function () {
        clearFieldError(rentalType, rentalTypeError);

        if (this.value === "Personal") {
            personalNameGroup.classList.remove("hidden");
            eventGroup.classList.add("hidden");

            personalName.disabled = false;
            personalName.required = true;

            bookingSelect.disabled = true;
            bookingSelect.required = false;
            bookingSelect.value = "";

            clearFieldError(bookingSelect, bookingError);
        } else if (this.value === "Event") {
            personalNameGroup.classList.add("hidden");
            eventGroup.classList.remove("hidden");

            personalName.disabled = true;
            personalName.required = false;
            personalName.value = "";

            bookingSelect.disabled = false;
            bookingSelect.required = true;

            clearFieldError(personalName, personalNameError);
        } else {
            personalNameGroup.classList.add("hidden");
            eventGroup.classList.add("hidden");

            personalName.disabled = true;
            personalName.required = false;
            personalName.value = "";

            bookingSelect.disabled = true;
            bookingSelect.required = false;
            bookingSelect.value = "";

            clearFieldError(personalName, personalNameError);
            clearFieldError(bookingSelect, bookingError);
        }
    });

    /* =========================================================
       EQUIPMENT CHANGE
    ========================================================= */

    equipmentSelect.addEventListener("change", function () {
        clearFieldError(equipmentSelect, equipmentError);

        const selectedOption =
            this.options[this.selectedIndex];

        if (!selectedOption || !selectedOption.value) {
            rentalPriceInput.value = "";
            quantityInput.removeAttribute("max");

            availabilityText.textContent = DEFAULT_AVAILABILITY_TEXT;

            clearFieldError(quantityInput, quantityError);

            calculateRentalAmount();
            return;
        }

        const available = Number(selectedOption.dataset.available || 0);
        const rentalPrice = Number(selectedOption.dataset.rentalPrice || 0);

        rentalPriceInput.value = rentalPrice;
        quantityInput.max = available;

        if (available <= 0) {
            availabilityText.textContent =
                "This equipment is currently unavailable.";
        } else {
            availabilityText.textContent =
                "Available: " + available +
                " unit(s) | Daily price: " +
                formatCurrency(rentalPrice);
        }

        /*
         * Do not silently reduce the user's quantity.
         * Show a validation error if it exceeds available stock.
         */

        if (quantityInput.value !== "") {
            validateQuantity();
        } else {
            clearFieldError(quantityInput, quantityError);
        }

        calculateRentalAmount();
    });

    /* =========================================================
       CALCULATE RENTAL AMOUNT
    ========================================================= */

    function calculateRentalAmount() {
        const rentalPrice = Number(rentalPriceInput.value || 0);
        const quantity = Number(quantityInput.value || 0);
        const days = Number(daysInput.value || 0);

        const total = rentalPrice * quantity * days;

        rentalAmountInput.value = Number.isFinite(total)
            ? total.toFixed(2)
            : "0.00";

        amountPreview.textContent = formatCurrency(
            Number.isFinite(total) ? total : 0
        );
    }

    /* =========================================================
       QUANTITY INPUT
    ========================================================= */

    quantityInput.addEventListener("input", function () {
        clearFieldError(quantityInput, quantityError);

        calculateRentalAmount();

        if (this.value !== "") {
            validateQuantity();
        }
    });

    quantityInput.addEventListener("blur", function () {
        if (this.value !== "") {
            validateQuantity();
        }
    });

    /* =========================================================
       DAYS INPUT
    ========================================================= */

    daysInput.addEventListener("input", function () {
        clearFieldError(daysInput, daysError);

        calculateRentalAmount();

        if (this.value !== "") {
            validateDays();
        }
    });

    daysInput.addEventListener("blur", function () {
        if (this.value !== "") {
            validateDays();
        }
    });

    /* =========================================================
       OTHER INPUT EVENTS
    ========================================================= */

    personalName.addEventListener("input", function () {
        clearFieldError(personalName, personalNameError);
    });

    bookingSelect.addEventListener("change", function () {
        clearFieldError(bookingSelect, bookingError);
    });

    /* =========================================================
       FORM SUBMIT
    ========================================================= */

    rentalForm.addEventListener("submit", function (event) {
        event.preventDefault();

        if (isSubmitting) {
            return;
        }

        clearFormErrors();

        const typeValid = validateRentalType();
        const personalValid = validatePersonalName();
        const eventValid = validateEvent();
        const equipmentValid = validateEquipment();
        const quantityValid = validateQuantity();
        const daysValid = validateDays();

        if (
            !typeValid ||
            !personalValid ||
            !eventValid ||
            !equipmentValid ||
            !quantityValid ||
            !daysValid
        ) {
            showFormError(
                "Please correct the highlighted fields before saving the rental."
            );

            if (!typeValid) {
                rentalType.focus();
            } else if (!personalValid) {
                personalName.focus();
            } else if (!eventValid) {
                bookingSelect.focus();
            } else if (!equipmentValid) {
                equipmentSelect.focus();
            } else if (!quantityValid) {
                quantityInput.focus();
            } else {
                daysInput.focus();
            }

            return;
        }

        calculateRentalAmount();

        isSubmitting = true;
        saveRentalButton.disabled = true;
        saveRentalButton.textContent = "Saving...";

        /*
         * Submit the form without triggering this listener again.
         */

        HTMLFormElement.prototype.submit.call(this);
    });

    /* =========================================================
       DELETE CONFIRMATION
    ========================================================= */

    function openDeleteConfirm(button) {
        selectedDeleteForm = button.closest(".delete-form");

        if (!selectedDeleteForm) {
            return;
        }

        const equipmentName =
            selectedDeleteForm.dataset.equipment || "this rental";

        deleteConfirmItem.textContent =
            "Equipment: " + equipmentName;

        openModal(deleteConfirmModal);
    }

    function closeDeleteConfirm() {
        closeModal(deleteConfirmModal);
        selectedDeleteForm = null;
    }

    function submitDelete() {
        if (!selectedDeleteForm) {
            return;
        }

        HTMLFormElement.prototype.submit.call(selectedDeleteForm);
    }

    /* =========================================================
       RETURN CONFIRMATION
    ========================================================= */

    function openReturnConfirm(button) {
        selectedReturnForm = button.closest(".return-form");

        if (!selectedReturnForm) {
            return;
        }

        const equipmentName =
            selectedReturnForm.dataset.equipment || "this equipment";

        returnConfirmItem.textContent =
            "Equipment: " + equipmentName;

        openModal(returnConfirmModal);
    }

    function closeReturnConfirm() {
        closeModal(returnConfirmModal);
        selectedReturnForm = null;
    }

    function submitReturn() {
        if (!selectedReturnForm) {
            return;
        }

        HTMLFormElement.prototype.submit.call(selectedReturnForm);
    }

    /* =========================================================
       CLICK OUTSIDE MODALS
    ========================================================= */

    rentalModal.addEventListener("click", function (event) {
        if (event.target === rentalModal) {
            closeRentalModal();
        }
    });

    deleteConfirmModal.addEventListener("click", function (event) {
        if (event.target === deleteConfirmModal) {
            closeDeleteConfirm();
        }
    });

    returnConfirmModal.addEventListener("click", function (event) {
        if (event.target === returnConfirmModal) {
            closeReturnConfirm();
        }
    });

    /* =========================================================
       ESC KEY
    ========================================================= */

    document.addEventListener("keydown", function (event) {
        if (event.key !== "Escape") {
            return;
        }

        if (returnConfirmModal.classList.contains("show")) {
            closeReturnConfirm();
        } else if (deleteConfirmModal.classList.contains("show")) {
            closeDeleteConfirm();
        } else if (rentalModal.classList.contains("show")) {
            closeRentalModal();
        }
    });
</script>

</body>
</html>